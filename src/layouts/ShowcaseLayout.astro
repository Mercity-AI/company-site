---
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Animation Showcase', description } = Astro.props;
---

<BaseLayout title={title} description={description} showBlur={false} showFooter={false} mainPaddedTop={false}>
  <slot />
</BaseLayout>
