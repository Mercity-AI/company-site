---
import { ClientRouter } from 'astro:transitions';
import BlurBackground from '@/components/BlurBackground.astro';
import '@/styles/global.css';
import 'katex/dist/katex.min.css';
import { DEFAULT_OG_IMAGE, SITE_DESCRIPTION, SITE_NAME, SITE_URL, absoluteImage, fullTitle } from '@/utils/seo';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  showBlur?: boolean;
  showFooter?: boolean;
  mainPaddedTop?: boolean;
  hideNavOnScroll?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  path = Astro.url.pathname,
  image = DEFAULT_OG_IMAGE,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  showBlur = true,
  showFooter = true,
  mainPaddedTop = true,
  hideNavOnScroll = false,
} = Astro.props;

const fullPageTitle = fullTitle(title);
const canonicalRaw = new URL(path, SITE_URL).toString();
const canonicalUrl = canonicalRaw.endsWith('/') ? canonicalRaw : canonicalRaw + '/';
const ogImage = absoluteImage(image);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />

    <title>{fullPageTitle}</title>
    <meta name="title" content={fullPageTitle} />
    <meta name="description" content={description} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullPageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE_NAME} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullPageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === 'article' && author && <meta property="article:author" content={author} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="robots" content="index, follow" />
    <meta name="language" content="English" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/atom-one-dark.min.css"
    />

    <!-- Microsoft Clarity -->
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "h82rwlwyjb");
    </script>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-MR3DEJ9G83"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-MR3DEJ9G83');
    </script>

    <ClientRouter />
  </head>
  <body>
    <div class="min-h-screen flex flex-col relative text-text-main font-sans selection:bg-slate-200 selection:text-slate-900 bg-background">
      {showBlur && <BlurBackground />}

      <header
        id="site-header"
        data-site-header
        data-scrolled="false"
        data-hidden="false"
        data-hide-nav-on-scroll={hideNavOnScroll ? 'true' : 'false'}
        class="site-header fixed top-0 w-full z-50 border-b border-transparent py-6"
      >
        <div class="max-w-[92rem] mx-auto page-gutter lg:px-[3.25rem] flex justify-between items-center">
          <a href="/" class="flex items-center group" transition:name="site-logo" data-astro-prefetch>
            <img
              src="/no-background-logo.png"
              alt="Mercity"
              class="h-[2.625rem] w-auto transition-transform duration-500 group-hover:scale-[1.02]"
            />
          </a>

          <nav class="hidden md:flex items-center gap-12">
            <a
              href="/research"
              class="text-sm font-medium text-slate-500 hover:text-slate-900 transition-colors duration-300 relative group"
              data-astro-prefetch
            >
              Research
              <span class="absolute -bottom-1 left-0 w-0 h-[1px] bg-slate-900 transition-all duration-300 group-hover:w-full" />
            </a>
            <a
              href="/blog"
              class="text-sm font-medium text-slate-500 hover:text-slate-900 transition-colors duration-300 relative group"
              data-astro-prefetch
            >
              Blog
              <span class="absolute -bottom-1 left-0 w-0 h-[1px] bg-slate-900 transition-all duration-300 group-hover:w-full" />
            </a>
            <div class="relative group/oss">
              <a
                href="/open-source/simula"
                class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-slate-900 transition-colors duration-300 relative group"
                data-astro-prefetch
              >
                Open Source
                <svg class="w-3 h-3 mt-px transition-transform duration-300 group-hover/oss:rotate-180" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2.5 4.5L6 8l3.5-3.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="absolute -bottom-1 left-0 w-0 h-[1px] bg-slate-900 transition-all duration-300 group-hover:w-full" />
              </a>
              <div class="absolute left-1/2 -translate-x-1/2 top-full pt-4 opacity-0 invisible translate-y-1 group-hover/oss:opacity-100 group-hover/oss:visible group-hover/oss:translate-y-0 transition-all duration-200">
                <div class="w-64 bg-white border border-slate-200 rounded-xl shadow-lg shadow-slate-900/5 p-2">
                  <a href="/open-source/simula" class="block px-4 py-3 rounded-lg hover:bg-slate-50 transition-colors" data-astro-prefetch>
                    <span class="block text-sm font-medium text-slate-900">Simula</span>
                    <span class="block text-xs text-slate-500 font-light mt-0.5">Deliberate synthetic data generation</span>
                  </a>
                </div>
              </div>
            </div>
            <a
              href="/about"
              class="text-sm font-medium text-slate-500 hover:text-slate-900 transition-colors duration-300 relative group"
              data-astro-prefetch
            >
              About
              <span class="absolute -bottom-1 left-0 w-0 h-[1px] bg-slate-900 transition-all duration-300 group-hover:w-full" />
            </a>
            <a
              href="/contact"
              class="px-5 py-2 text-xs font-semibold uppercase tracking-wider border border-slate-200 rounded-full hover:bg-slate-900 hover:text-white transition-all duration-300"
              data-astro-prefetch
            >
              Contact Us
            </a>
          </nav>

          <button type="button" class="md:hidden text-slate-900" data-menu-toggle aria-controls="mobile-menu" aria-expanded="false">
            <span data-menu-label>Menu</span>
          </button>
        </div>
      </header>

      <div
        id="mobile-menu"
        class="mobile-menu fixed inset-0 z-40 bg-white/95 backdrop-blur-2xl pt-24 px-6"
        data-mobile-menu
        data-open="false"
      >
        <div class="flex flex-col gap-8 text-2xl font-light">
          <a href="/research" class="border-b border-slate-100 pb-4" data-mobile-link data-astro-prefetch>Research</a>
          <a href="/blog" class="border-b border-slate-100 pb-4" data-mobile-link data-astro-prefetch>Blog</a>
          <a href="/open-source/simula" class="border-b border-slate-100 pb-4" data-mobile-link data-astro-prefetch>Open Source</a>
          <a href="/about" class="border-b border-slate-100 pb-4" data-mobile-link data-astro-prefetch>About</a>
          <a href="/contact" class="border-b border-slate-100 pb-4 text-slate-900 font-medium" data-mobile-link data-astro-prefetch>Contact Us</a>
        </div>
      </div>

      <main class={`flex-grow ${mainPaddedTop ? 'pt-24' : ''}`}>
        <slot />
      </main>

      {
        showFooter && (
          <footer class="border-t border-slate-200 mt-20 bg-white/50 backdrop-blur-sm">
            <div class="max-w-[92rem] mx-auto page-gutter lg:px-[3.25rem] py-16">
              <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
                <div class="col-span-1 md:col-span-2">
                  <h3 class="font-serif italic text-xl mb-6">Mercity</h3>
                  <p class="text-slate-500 max-w-sm font-light leading-relaxed">
                    Building the cognitive architecture for the next century. We are a research laboratory dedicated to
                    safe, general intelligence.
                  </p>
                </div>
                <div>
                  <h4 class="text-xs font-bold uppercase tracking-widest text-slate-900 mb-6">Sitemap</h4>
                  <ul class="space-y-4 text-sm text-slate-500 font-light">
                    <li><a href="/" class="hover:text-slate-900 transition-colors" data-astro-prefetch>Home</a></li>
                    <li><a href="/about" class="hover:text-slate-900 transition-colors" data-astro-prefetch>About Us</a></li>
                    <li>
                      <a href="/research" class="hover:text-slate-900 transition-colors" data-astro-prefetch>
                        Research
                      </a>
                    </li>
                    <li>
                      <a href="/blog" class="hover:text-slate-900 transition-colors" data-astro-prefetch>
                        Blog
                      </a>
                    </li>
                    <li>
                      <a href="/open-source/simula" class="hover:text-slate-900 transition-colors" data-astro-prefetch>
                        Open Source
                      </a>
                    </li>
                    <li><a href="/contact" class="hover:text-slate-900 transition-colors" data-astro-prefetch>Contact Us</a></li>
                    <li>
                      <a
                        href="https://www.linkedin.com/company/mercity-ai/jobs/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-slate-900 transition-colors"
                      >
                        Careers
                      </a>
                    </li>
                  </ul>
                </div>
                <div>
                  <h4 class="text-xs font-bold uppercase tracking-widest text-slate-900 mb-6">Connect</h4>
                  <ul class="space-y-4 text-sm text-slate-500 font-light">
                    <li>
                      <a href="https://x.com/Pranav2278" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 transition-colors">
                        Twitter / X
                      </a>
                    </li>
                    <li>
                      <a
                        href="https://www.linkedin.com/company/mercity-ai/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-slate-900 transition-colors"
                      >
                        LinkedIn
                      </a>
                    </li>
                    <li>
                      <a href="https://github.com/Mercity-AI/" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 transition-colors">
                        GitHub
                      </a>
                    </li>
                    <li>
                      <a href="mailto:pranav@mercity.io" class="inline-flex items-center gap-2 group">
                        <span class="group-hover:underline">pranav@mercity.io</span>
                        <span class="group-hover:translate-x-1 transition-transform">→</span>
                      </a>
                    </li>
                  </ul>
                </div>
              </div>
              <div class="mt-16 pt-8 border-t border-slate-100 flex flex-col md:flex-row justify-between text-xs text-slate-400 font-light">
                <p>&copy; {year} Mercity Research Labs. All rights reserved.</p>
                <div class="flex gap-6 mt-4 md:mt-0">
                  <a href="#">Privacy Policy</a>
                  <a href="#">Terms of Service</a>
                </div>
              </div>
            </div>
          </footer>
        )
      }
    </div>

    <script is:inline data-astro-rerun>
      (() => {
        if (window.__mercityShellCleanup) {
          window.__mercityShellCleanup();
        }

        const header = document.querySelector('[data-site-header]');
        const menu = document.querySelector('[data-mobile-menu]');
        const toggle = document.querySelector('[data-menu-toggle]');
        const label = document.querySelector('[data-menu-label]');
        const mobileLinks = document.querySelectorAll('[data-mobile-link]');
        const closeMenu = () => setMenuState(false);

        let lastScrollY = window.scrollY;

        const setScrolled = () => {
          if (!header) return;
          const currentY = window.scrollY;
          header.dataset.scrolled = currentY > 20 ? 'true' : 'false';

          if (header.dataset.hideNavOnScroll === 'true') {
            if (currentY > lastScrollY && currentY > 80) {
              header.dataset.hidden = 'true';
            } else if (currentY < lastScrollY) {
              header.dataset.hidden = 'false';
            }
          }

          lastScrollY = currentY;
        };

        const setMenuState = (open) => {
          if (!menu || !toggle || !label) return;
          menu.dataset.open = open ? 'true' : 'false';
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          label.textContent = open ? 'Close' : 'Menu';
          document.body.classList.toggle('mobile-menu-lock', open);
        };

        const onToggle = () => {
          if (!menu) return;
          const shouldOpen = menu.dataset.open !== 'true';
          setMenuState(shouldOpen);
        };

        setScrolled();
        setMenuState(false);
        window.addEventListener('scroll', setScrolled);
        if (toggle) {
          toggle.addEventListener('click', onToggle);
        }
        mobileLinks.forEach((link) => {
          link.addEventListener('click', closeMenu);
        });

        window.__mercityShellCleanup = () => {
          window.removeEventListener('scroll', setScrolled);
          if (toggle) {
            toggle.removeEventListener('click', onToggle);
          }
          mobileLinks.forEach((link) => {
            link.removeEventListener('click', closeMenu);
          });
        };
      })();
    </script>

    <script is:inline data-astro-rerun>
      (() => {
        if (window.__mercityRevealCleanup) {
          window.__mercityRevealCleanup();
        }

        const nodes = document.querySelectorAll('[data-reveal]');
        if (!nodes.length) return;

        if (!('IntersectionObserver' in window)) {
          nodes.forEach((node) => node.setAttribute('data-visible', 'true'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.setAttribute('data-visible', 'true');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.01 }
        );

        nodes.forEach((node) => observer.observe(node));

        window.__mercityRevealCleanup = () => observer.disconnect();
      })();
    </script>
  </body>
</html>
