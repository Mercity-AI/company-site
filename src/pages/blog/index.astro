---
import { getCollection } from 'astro:content';
import V2Layout from '@/layouts/V2Layout.astro';
import ListHead from '@/components/v2/ListHead.astro';
import EntryRow from '@/components/v2/EntryRow.astro';
import { entryToRow, getPostUrl, sortPostsByPublishedDate } from '@/utils/blog';

const posts = sortPostsByPublishedDate(await getCollection('posts'));

/* Newest year first, newest post first within it. */
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.publishedAt.getFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}
const groups = [...byYear.entries()].sort((a, b) => b[0] - a[0]);

const years = groups.length ? [...new Set([groups.at(-1)![0], groups[0][0]])].join('–') : '';
const count = posts.length ? `${posts.length} posts · ${years}` : undefined;
---

<V2Layout
  title="Blog"
  description="Guides and explainers from Mercity's client work: how a thing works, how to build it, and what broke when we did."
  path="/blog"
>
  <ListHead
    eyebrow="Blog"
    title="How it works, how to build it, and what broke."
    lede="Guides and explainers that came out of client work. Less polished than the research logs and more practical: the version we wish had existed when we started."
    count={count}
  />

  <section class="band">
    <div class="shell">
      {
        groups.map(([year, items], gi) => (
          <div class="yr">
            <div class="yr-head rv" data-rv>
              <span class="yr-label">{year}</span>
              <span class="yr-count">
                {items.length} {items.length === 1 ? 'post' : 'posts'}
              </span>
            </div>
            <div class="yr-rows">
              {items.map((p, i) => (
                <EntryRow {...entryToRow(p, getPostUrl(p))} delay={(gi === 0 ? 60 : 0) + Math.min(i, 5) * 60} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</V2Layout>

<style>
  .yr + .yr {
    margin-top: 61.2px;
  }
  .yr-head {
    display: flex;
    align-items: baseline;
    gap: 12.6px;
    margin-bottom: 14.4px;
  }
  .yr-label {
    font-family: var(--hero-serif);
    font-size: 27px;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .yr-count {
    font-family: var(--mono);
    font-size: 9.9px;
    letter-spacing: 0.04em;
    color: var(--n-400);
  }
</style>
