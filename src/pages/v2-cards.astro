---
import V2Layout from '@/layouts/V2Layout.astro';

/**
 * Card-design exploration for the "who we work with" section.
 * Lives on its own URL so /v2 is untouched. If this wins, it drops
 * straight into v2.astro in place of .persona-grid.
 */

const personas = [
  {
    label: 'For product teams',
    title: 'Differentiation you cannot buy off a shelf.',
    copy: 'Your model is the same endpoint your three closest competitors are calling, which means your moat is your interface. We build the layer that is not for sale.',
    backdrop: 'divergence',
    seed: 6104,
    facts: ['6–14 weeks', 'You own the weights'],
  },
  {
    label: 'For enterprises',
    title: 'AI inside the systems the business runs on.',
    copy: 'Past the pilot stage, where the demos have stopped being interesting. Data foundations, evaluation gates and serving architecture, built alongside your engineers.',
    backdrop: 'structure',
    seed: 1937,
    facts: ['Embedded teams', 'Capability stays behind'],
  },
];
---

<V2Layout
  title="Mercity — Card exploration"
  description="An exploration of the who-we-work-with card treatment."
>
  <div class="note-bar">
    <div class="shell note-bar-in">
      <span>Card exploration — this section only. The full page is at <a href="/v2">/v2</a>.</span>
      <span>Same graphics, new shell</span>
    </div>
  </div>

  <section class="band wws">
    <div class="shell">
      <span class="wws-eyebrow rv" data-rv>Who we work with</span>
      <h2 class="wws-title rv" data-rv style="--rv-delay:80ms">
        Two kinds of team.<br />One outcome: a capability you own.
      </h2>
      <p class="wws-sub rv" data-rv style="--rv-delay:160ms">
        They arrive with very different problems and leave with the same thing — models, pipelines and
        evaluations that belong to them, rather than a subscription that renews.
      </p>

      <div class="wws-grid">
        {
          personas.map((p, i) => (
            <article class="pcard rv" data-rv data-from={i === 0 ? 'left' : 'right'} style={`--rv-delay:${120 + i * 80}ms`}>
              <span class="pcard-label">
                <i aria-hidden="true">[</i>{p.label}<i aria-hidden="true">]</i>
              </span>
              <h3>{p.title}</h3>
              <p>{p.copy}</p>
              <figure class="pcard-art">
                <canvas data-backdrop={p.backdrop} data-seed={p.seed} aria-hidden="true"></canvas>
              </figure>
              <ul class="pcard-facts">
                {p.facts.map((f) => <li>{f}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</V2Layout>

<style is:global>
  .note-bar {
    background: var(--n-900);
    color: hsl(240 18% 96% / 0.72);
  }
  .note-bar-in {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    flex-wrap: wrap;
    padding-block: 11px;
    font-family: var(--mono);
    font-size: 9.9px;
    letter-spacing: 0.06em;
  }
  .note-bar a {
    color: var(--teal-500);
  }

  /* ── Section header: centred, with a rule under the eyebrow ───── */
  .wws {
    text-align: center;
    background: var(--n-100);
  }
  .wws-eyebrow {
    display: inline-block;
    padding-bottom: 5px;
    border-bottom: 1px solid var(--line-2);
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .wws-title {
    margin: 25px auto 0;
    max-width: 20ch;
    font-family: var(--hero-serif);
    font-size: clamp(28px, 3.7vw, 43px);
    font-weight: 400;
    line-height: 1.16;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: balance;
  }
  .wws-sub {
    margin: 20px auto 0;
    max-width: 60ch;
    font-size: 14.85px;
    line-height: 1.76;
    color: var(--ink-3);
  }

  /* ── Cards: hairline, lighter than the ground, no shadow ──────── */
  .wws-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 50px;
    text-align: center;
  }
  @media (max-width: 940px) {
    .wws-grid {
      grid-template-columns: 1fr;
    }
  }

  .pcard {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 44px 40px 46px;
    background: var(--surface);
    border: 1px solid var(--line-2);
    transition: border-color 500ms var(--ease);
  }
  .pcard:hover {
    border-color: var(--ink-3);
  }

  /* The bracket device: flanking glyphs, stretched, in the identity hue.
     Indigo rather than amber on purpose — amber means caution in this
     system, and a label is not a warning. */
  .pcard-label {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-size: 13.5px;
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--ink-2);
  }
  .pcard-label i {
    display: inline-block;
    font-style: normal;
    font-size: 1.5em;
    line-height: 1;
    color: var(--indigo-500);
    transform: scaleY(1.15);
  }

  .pcard h3 {
    margin-top: 30px;
    max-width: 17ch;
    font-family: var(--hero-serif);
    font-size: clamp(21px, 2.2vw, 26px);
    font-weight: 400;
    line-height: 1.24;
    letter-spacing: -0.016em;
    color: var(--ink);
    text-wrap: balance;
  }
  .pcard > p {
    margin-top: 15px;
    max-width: 44ch;
    font-size: 13.95px;
    line-height: 1.74;
    color: var(--ink-3);
  }

  /* The graphic floats in the card's whitespace — no frame, no bleed. */
  .pcard-art {
    width: 84%;
    margin: 34px 0 0;
    aspect-ratio: 16 / 10;
  }
  .pcard-art canvas {
    width: 100%;
    height: 100%;
  }

  .pcard-facts {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    width: 84%;
    justify-content: center;
    font-family: var(--mono);
    font-size: 9.9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .pcard-facts li + li::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    margin-right: 16px;
    border-radius: 50%;
    background: var(--teal-500);
    vertical-align: 2px;
  }
</style>
