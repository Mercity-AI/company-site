---
import V2Layout from '@/layouts/V2Layout.astro';

const capabilities = [
  {
    name: 'Synthetic Data Generation',
    backdrop: 'sdTarget',
    seed: 4021,
    summary:
      'We build pipelines that produce exactly the distribution your model is missing — curriculum-controlled, deduplicated, and verified against the real task rather than against a prompt template. Millions of samples, shipped with the generation code, the filter criteria and a coverage report, so you can audit what went into the run instead of trusting it.',
  },
  {
    name: 'Custom Architecture & Training',
    backdrop: 'archLoss',
    seed: 9137,
    summary:
      'When the off-the-shelf model is the wrong shape, we design one that is not: modified attention, task-native tokenizers, reworked objectives, and the kernels to make them run fast. Continued pretraining through post-training, on your compute, with every checkpoint and hyperparameter decision documented and handed over.',
  },
  {
    name: 'Evaluation & Benchmarking',
    backdrop: 'evalBars',
    seed: 2288,
    summary:
      'Public benchmarks rarely measure the thing you are actually paid for. We build the evaluation your problem needs — task-specific suites, adversarial probes and regression harnesses wired into CI — then run it honestly, including the results that argue against the model we just trained for you.',
  },
];

const personas = [
  {
    label: 'For product teams',
    title: 'Differentiation you cannot buy off a shelf.',
    copy: 'Your model is the same endpoint your three closest competitors are calling, which means your moat is your interface. We build the layer that is not for sale.',
    backdrop: 'divergence',
    seed: 6104,
    facts: ['6–14 weeks', 'You own the weights'],
  },
  {
    label: 'For enterprises',
    title: 'AI inside the systems the business runs on.',
    copy: 'Past the pilot stage, where the demos have stopped being interesting. Data foundations, evaluation gates and serving architecture, built alongside your engineers.',
    backdrop: 'structure',
    seed: 1937,
    facts: ['Embedded teams', 'Capability stays behind'],
  },
];

const openWork = [
  {
    name: 'Datasets',
    backdrop: 'strata',
    seed: 771,
    meta: '14 releases · HuggingFace',
    href: '/open-source/simula',
    summary:
      'Curated and synthetic corpora released with the generation code, the filtering criteria and the failure modes we already know about — so you can judge whether a set fits your problem before you spend a training run finding out.',
  },
  {
    name: 'Models',
    backdrop: 'isoline',
    seed: 5410,
    meta: '9 checkpoints · Apache-2.0',
    href: '/open-source/simula',
    summary:
      'Checkpoints, adapters and complete training recipes from experiments we think are worth reproducing — published with the evaluation numbers that convinced us to keep them, and the ablations that did not make the cut.',
  },
  {
    name: 'Research',
    backdrop: 'contour',
    seed: 3364,
    meta: '30+ write-ups · Updated weekly',
    href: '/research',
    summary:
      'Long-form write-ups of what worked, what did not, and the specific reason why — implementation detail included, because that is reliably the part every other post leaves out and the part you need in order to reproduce it.',
  },
];

const tooling = [
  {
    name: 'Simula',
    kind: 'Python',
    href: '/open-source/simula',
    summary:
      'Deliberate synthetic data generation. Describe the distribution you want as a spec, and Simula plans, generates and verifies a corpus against it.',
  },
  {
    name: 'Assay',
    kind: 'Python',
    href: '/open-source/simula',
    summary:
      'An evaluation harness for task-specific benchmarks. Define graders once, run them across models and checkpoints, and diff results across a training run.',
  },
  {
    name: 'Sieve',
    kind: 'Rust · Python',
    href: '/open-source/simula',
    summary:
      'Corpus filtering and near-duplicate detection at billion-document scale, with every decision traceable back to the rule that made it.',
  },
  {
    name: 'Anvil',
    kind: 'CUDA · Triton',
    href: '/open-source/simula',
    summary:
      'Fused kernels and training utilities for architectures that do not fit the standard stack, benchmarked against the reference implementation on every commit.',
  },
];
---

<V2Layout
  title="Mercity Research — Landing V2"
  description="Research-led capabilities for product and enterprise teams. Synthetic data, custom training, and evaluation that tells the truth."
>
  <!-- ═══ HERO ═══════════════════════════════════════════════════ -->
  <section class="hero">
    <canvas class="hero-bg" data-backdrop="blurlight" data-seed="8812" data-dpr="1.2" aria-hidden="true"></canvas>
    <div class="hero-scrim"></div>
    <div class="shell hero-in">
      <h1 class="rv" data-rv style="--rv-delay:120ms">
        Building research led capabilities for product and enterprise teams.
      </h1>
      <p class="rv" data-rv style="--rv-delay:240ms">
        We generate the data nobody has, train the model nobody sells, and then prove it actually works.
        Custom training, real optimization and built-from-scratch architecture — anything that gives you an
        edge the market cannot buy off a shelf.
      </p>
      <div class="hero-actions rv" data-rv style="--rv-delay:360ms">
        <a class="btn-solid" href="#work">See what we do<span aria-hidden="true">→</span></a>
        <a class="btn-quiet" href="/research">
          <span class="btn-fill"></span>
          <span class="btn-label">Read our research</span>
        </a>
      </div>
    </div>
    <figure class="hero-plate" aria-hidden="true">
      <canvas data-backdrop="heroCurves" data-seed="5521" data-dpr="1.3"></canvas>
    </figure>
  </section>

  <!-- ═══ WHAT WE WORK ON ════════════════════════════════════════ -->
  <section class="band" id="work">
    <div class="shell">
      <span class="eyebrow rv" data-rv>What we work on</span>
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">Three things, and we do all three at depth.</h2>
      <p class="lede rv" data-rv style="--rv-delay:160ms">
        Not a service menu. These are the three problems we have run at scale often enough to have opinions
        about, and they compose into a single pipeline: generate the data nobody has, train the model nobody
        sells, then prove it actually works.
      </p>

      <div class="cap-grid">
        {
          capabilities.map((c, i) => (
            <article class="cap rv" data-rv style={`--rv-delay:${100 + i * 90}ms`}>
              <div class="cap-art">
                <canvas data-backdrop={c.backdrop} data-seed={c.seed} aria-hidden="true"></canvas>
              </div>
              <div class="cap-body">
                <h3>{c.name}</h3>
                <p>{c.summary}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ WHO WE WORK WITH ═══════════════════════════════════════ -->
  <section class="band wws" id="who">
    <div class="shell">
      <span class="wws-eyebrow rv" data-rv>Who we work with</span>
      <h2 class="wws-title rv" data-rv style="--rv-delay:80ms">
        Two kinds of team.<br />One outcome: a capability you own.
      </h2>
      <p class="wws-sub rv" data-rv style="--rv-delay:160ms">
        They arrive with very different problems and leave with the same thing — models, pipelines and
        evaluations that belong to them, rather than a subscription that renews.
      </p>

      <div class="wws-grid">
        {
          personas.map((p, i) => (
            <article
              class="pcard rv"
              data-rv
              data-from={i === 0 ? 'left' : 'right'}
              style={`--rv-delay:${120 + i * 80}ms`}
            >
              <span class="pcard-label">
                <i aria-hidden="true">[</i>{p.label}<i aria-hidden="true">]</i>
              </span>
              <h3>{p.title}</h3>
              <p>{p.copy}</p>
              <figure class="pcard-art">
                <canvas data-backdrop={p.backdrop} data-seed={p.seed} aria-hidden="true"></canvas>
              </figure>
              <ul class="pcard-facts">
                {p.facts.map((f) => <li>{f}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>


  <!-- ═══ WE SHIP OPENLY ═════════════════════════════════════════ -->
  <section class="band" id="open">
    <div class="shell">
      <div class="open-head">
        <div class="open-head-copy">
          <span class="eyebrow rv" data-rv>Open source</span>
          <h2 class="h2 rv" data-rv style="--rv-delay:80ms">We ship openly, and in public.</h2>
          <p class="lede rv" data-rv style="--rv-delay:160ms">
            Most of what we learn on client work ends up public in some form. Datasets we had to build because
            nothing suitable existed, weights from runs worth reproducing, and write-ups detailed enough that
            you could follow them end to end. Take it, fork it, and tell us where we got it wrong.
          </p>
        </div>
        <a class="wipe rv" data-rv style="--rv-delay:240ms" href="/open-source/simula">
          <span class="wipe-fill"></span>
          <span class="wipe-label">Explore our open work</span>
          <span class="wipe-label" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="open-grid">
        {
          openWork.map((o, i) => (
            <a class="open-card rv" data-rv style={`--rv-delay:${100 + i * 90}ms`} href={o.href}>
              <div class="open-art">
                <canvas data-backdrop={o.backdrop} data-seed={o.seed} aria-hidden="true"></canvas>
              </div>
              <div class="open-body">
                <h3>{o.name}</h3>
                <p>{o.summary}</p>
                <span class="open-meta">{o.meta}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ TOOLING ════════════════════════════════════════════════ -->
  <section class="band band-tint" id="tooling">
    <div class="shell">
      <span class="eyebrow rv" data-rv>Tooling</span>
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">
        Alongside the data and the weights, we open the tools.
      </h2>
      <p class="lede rv" data-rv style="--rv-delay:160ms">
        Nearly all of this started as something we needed internally and got tired of rewriting for the next
        engagement. It stays maintained because we run on it ourselves — the same libraries are in the loop on
        client projects the week they ship.
      </p>

      <div class="tool-grid">
        {
          tooling.map((t, i) => (
            <a class="tool rv" data-rv style={`--rv-delay:${80 + i * 80}ms`} href={t.href}>
              <div class="tool-top">
                <span class="tool-name">{t.name}</span>
                <span class="tool-kind">{t.kind}</span>
              </div>
              <div>
                <span class="tool-dot"></span>
                <p>{t.summary}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ CLOSING ════════════════════════════════════════════════ -->
  <section class="closer">
    <canvas class="closer-bg" data-backdrop="strata" data-seed="4488" data-dpr="1.2" aria-hidden="true"></canvas>
    <div class="shell closer-in">
      <h2 class="rv" data-rv>Bring us the problem that does not fit the API.</h2>
      <p class="rv" data-rv style="--rv-delay:120ms">
        If an off-the-shelf model already solves it, you do not need us. If it nearly solves it and the last
        fifteen percent is the whole business, that is the conversation we want.
      </p>
      <a class="btn-light rv" data-rv style="--rv-delay:240ms" href="/contact">
        Start a conversation<span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</V2Layout>

<style is:global>
  /* ══════════════════════════════════════════════════════════════
     V2 PAGE
     ══════════════════════════════════════════════════════════════ */

  /* ── Hero ───────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--n-50);
    color: var(--ink);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Lifts the left third toward paper so the headline always has a
     quiet ground, whatever the generator lands on. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      hsl(240 30% 99% / 0.86) 0%,
      hsl(240 30% 99% / 0.58) 44%,
      hsl(240 30% 99% / 0.18) 100%
    );
  }
  .hero-in {
    position: relative;
    z-index: 2;
    padding-block: clamp(93.6px, 11.7vw, 151.2px) clamp(79.2px, 9.9vw, 126px);
  }
  .hero h1 {
    margin-top: 0;
    /* 36ch is a touch over half the headline, so it breaks into two rows,
       and balance makes those two rows even. The size cap is what makes
       two rows possible at all: the longer half has to fit the shell. */
    max-width: 36ch;
    font-family: var(--hero-serif);
    font-size: clamp(32px, 4.9vw, 58px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.026em;
    text-wrap: balance;
    color: var(--ink);
  }
  .hero p {
    margin-top: 25.2px;
    max-width: 54ch;
    font-size: clamp(14.4px, 1.44vw, 16.65px);
    font-weight: 400;
    line-height: 1.74;
    color: var(--ink-3);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12.6px;
    margin-top: 36px;
  }
  .btn-solid,
  .btn-quiet,
  .btn-light {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 14.5px 25.2px;
    border-radius: 0;
    font-size: 11.2px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition:
      transform 400ms var(--ease),
      background 400ms var(--ease),
      border-color 400ms var(--ease),
      color 400ms var(--ease);
  }
  .btn-solid {
    background: var(--ink);
    color: var(--n-50);
    border: 1px solid var(--ink);
  }
  .btn-solid:hover {
    transform: translateY(-2px);
    background: var(--n-800);
  }
  .btn-solid span,
  .btn-light span {
    transition: transform 400ms var(--ease);
  }
  .btn-solid:hover span,
  .btn-light:hover span {
    transform: translateX(4px);
  }
  .btn-quiet {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line-2);
    color: var(--ink-2);
    background: hsl(240 30% 99% / 0.6);
  }
  .btn-fill {
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform: translateX(-100%);
    transition: transform 350ms var(--ease);
  }
  .btn-label {
    position: relative;
    z-index: 1;
  }
  .btn-quiet:hover {
    border-color: var(--ink);
    color: var(--n-50);
  }
  .btn-quiet:hover .btn-fill {
    transform: translateX(0);
  }
  /* Full-bleed across the hero: the lines enter at one edge and leave at
     the other. Transparent, so there is no image to have an edge; the top
     fade only keeps them off the paragraph. */
  .hero-plate {
    position: absolute;
    inset: 0;
    z-index: 1;
    margin: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, transparent 38%, #000 62%);
    mask-image: linear-gradient(to bottom, transparent 38%, #000 62%);
  }
  @media (max-width: 900px) {
    .hero-plate {
      display: none;
    }
  }
  .hero-plate canvas {
    width: 100%;
    height: 100%;
  }

  /* ── Bands ──────────────────────────────────────────────────── */
  .band-tint {
    background: var(--n-100);
  }

  /* ── Capabilities ───────────────────────────────────────────── */
  .cap-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 19.8px;
    margin-top: 52.2px;
  }
  @media (max-width: 940px) {
    .cap-grid {
      grid-template-columns: 1fr;
    }
  }
  .cap {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    transition:
      transform 500ms var(--ease),
      border-color 500ms var(--ease),
      box-shadow 500ms var(--ease);
  }
  .cap:hover {
    transform: translateY(-4.5px);
    border-color: var(--line-2);
    box-shadow: 0 14px 34px -26px hsl(240 14% 10% / 0.26);
  }
  .cap-art {
    height: 182.4px;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .cap-art canvas {
    width: 100%;
    height: 100%;
  }
  .cap-body {
    padding: 28.35px 26.46px 32.13px;
  }
  .cap h3 {
    margin-top: 0;
    font-family: var(--hero-serif);
    font-size: 19.8px;
    font-weight: 400;
    letter-spacing: -0.014em;
    line-height: 1.24;
  }
  .cap p {
    margin-top: 13.5px;
    font-size: 13.05px;
    font-weight: 400;
    line-height: 1.76;
    color: var(--ink-3);
  }

  /* ── Who we work with ───────────────────────────────────────── */
  .wws {
    text-align: center;
    background: var(--n-100);
  }
  .wws-eyebrow {
    display: inline-block;
    padding-bottom: 5px;
    border-bottom: 1px solid var(--line-2);
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .wws-title {
    margin: 25px auto 0;
    max-width: 20ch;
    font-family: var(--hero-serif);
    font-size: clamp(28px, 3.7vw, 43px);
    font-weight: 400;
    line-height: 1.16;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: balance;
  }
  .wws-sub {
    margin: 20px auto 0;
    max-width: 60ch;
    font-size: 14.85px;
    line-height: 1.76;
    color: var(--ink-3);
  }

  .wws-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 50px;
    text-align: center;
  }
  @media (max-width: 940px) {
    .wws-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Hairline card, lighter than the ground, deliberately no shadow. */
  .pcard {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 44px 40px 46px;
    background: var(--surface);
    border: 1px solid var(--line-2);
    transition: border-color 500ms var(--ease);
  }
  .pcard:hover {
    border-color: var(--ink-3);
  }

  /* Bracket device. Indigo, not amber -- amber means caution in this
     palette and a label is not a warning. */
  .pcard-label {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-size: 13.5px;
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--ink-2);
  }
  .pcard-label i {
    display: inline-block;
    font-style: normal;
    font-size: 1.5em;
    line-height: 1;
    color: var(--indigo-500);
    transform: scaleY(1.15);
  }

  .pcard h3 {
    margin-top: 30px;
    max-width: 17ch;
    font-family: var(--hero-serif);
    font-size: clamp(21px, 2.2vw, 26px);
    font-weight: 400;
    line-height: 1.24;
    letter-spacing: -0.016em;
    color: var(--ink);
    text-wrap: balance;
  }
  .pcard > p {
    margin-top: 15px;
    max-width: 44ch;
    font-size: 13.95px;
    line-height: 1.74;
    color: var(--ink-3);
  }

  /* The graphic floats in the card's whitespace -- no frame, no bleed. */
  .pcard-art {
    width: 92%;
    margin: 34px 0 0;
    aspect-ratio: 16 / 11.7;
  }
  .pcard-art canvas {
    width: 100%;
    height: 100%;
  }

  .pcard-facts {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 92%;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 9.9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .pcard-facts li + li::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    margin-right: 16px;
    border-radius: 50%;
    background: var(--teal-500);
    vertical-align: 2px;
  }


  /* ── Open source ────────────────────────────────────────────── */
  .open-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 36px;
    flex-wrap: wrap;
  }
  .open-head-copy {
    flex: 1 1 30rem;
    min-width: 0;
  }
  .wipe {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    flex: none;
    padding: 13.5px 23.4px;
    border: 1px solid var(--ink);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 300ms var(--ease);
  }
  .wipe-fill {
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform: translateX(-100%);
    transition: transform 350ms var(--ease);
  }
  .wipe-label {
    position: relative;
    z-index: 1;
  }
  .wipe:hover {
    color: var(--n-50);
  }
  .wipe:hover .wipe-fill {
    transform: translateX(0);
  }

  .open-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 19.8px;
    margin-top: 52.2px;
  }
  @media (max-width: 940px) {
    .open-grid {
      grid-template-columns: 1fr;
    }
  }
  .open-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    transition:
      transform 500ms var(--ease),
      border-color 500ms var(--ease),
      box-shadow 500ms var(--ease);
  }
  .open-card:hover {
    transform: translateY(-4.5px);
    border-color: var(--line-2);
    box-shadow: 0 14px 34px -26px hsl(240 14% 10% / 0.26);
  }
  .open-art {
    aspect-ratio: 4 / 3.51;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .open-art canvas {
    width: 100%;
    height: 100%;
  }
  .open-body {
    padding: 28.8px 27px 32.4px;
  }
  .open-body h3 {
    font-family: var(--hero-serif);
    font-size: 18.5px;
    font-weight: 400;
    letter-spacing: -0.012em;
  }
  .open-body p {
    margin-top: 11.7px;
    font-size: 13.05px;
    line-height: 1.74;
    color: var(--ink-3);
  }
  .open-meta {
    display: block;
    margin-top: 18px;
    font-family: var(--mono);
    font-size: 9.45px;
    color: var(--n-400);
  }

  /* ── Tooling ────────────────────────────────────────────────── */
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16.2px;
