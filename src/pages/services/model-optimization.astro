  .symptoms {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* Two rows of cards, four tracks each; the line track takes the
       spare height so the proofs sit at the bottom. */
    grid-template-rows: auto auto 1fr auto auto auto 1fr auto;
    gap: 14px;
  }
  .symptom {
    padding: 24px 24px 26px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .symptom-icon {
    display: block;
    width: 26px;
    height: 26px;
    color: var(--leaf-700);
  }
  .symptom h3 {
    margin-top: 20px;
    font-family: var(--hero-serif);
    font-size: 21.6px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.014em;
  }
  /* Each card spans four rows of the grid (icon, title, line, proof)
     and shares them with the card beside it, so the dashed rules
     above the proofs line up across a row whatever wraps. */
  .symptom {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: 0;
    align-content: start;
  }
  .symptom-proof {
    display: block;
    align-self: end;
    padding-top: 14px;
    border-top: 1px dashed var(--line-2);
    font-size: 13.05px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--teal-800);
  }
  .proof-t {
    text-decoration: underline 1px transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 300ms var(--ease);
  }
  .symptom-proof:hover .proof-t {
    text-decoration-color: currentColor;
  }
  /* The ↗ sits high and small, like a superscript, and lifts toward
     its corner on hover. */
  .proof-go {
    display: inline-block;
    margin-left: 3px;
    font-size: 0.8em;
    vertical-align: 0.35em;
    line-height: 0;
    transition: transform 300ms var(--ease);
  }
  .symptom-proof:hover .proof-go {
    transform: translate(2px, -2px);
  }
  .symptom-proof small {
    display: block;
    margin-bottom: 3px;
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .symptom p {
    padding-bottom: 18px;
    margin-top: 8px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--ink-3);
    text-wrap: pretty;
  }
  @media (max-width: 900px) {
    .why {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 480px) {
    .symptoms {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
    }
  }

  /* ══ METHODS ═════════════════════════════════════════════════
     Six tiles, each a small diagram of the mechanism over one line
     and what it buys. */
  .methods {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 44px;
  }
  .method {
    display: flex;
    flex-direction: column;
    padding-bottom: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    transition:
      border-color 500ms var(--ease),
      transform 500ms var(--ease),
      box-shadow 500ms var(--ease);
  }
  .method:hover {
    border-color: var(--leaf-200);
    transform: translateY(-2px);
    box-shadow: 0 18px 36px -26px hsl(150 50% 20% / 0.3);
  }
  .method > :not(.method-art) {
    margin-inline: 22px;
  }
  .method-art {
    display: block;
    padding: 18px 22px 12px;
    background: var(--n-50);
    border-bottom: 1px solid var(--line);
  }
  .method-art svg {
    display: block;
    width: 100%;
    max-width: 300px;
    height: auto;
    overflow: visible;
    font-family: var(--mono);
  }
  .method h3 {
    margin-top: 20px;
    font-family: var(--hero-serif);
    font-size: 21.6px;
    font-weight: 400;
    letter-spacing: -0.014em;
  }
  .method p {
    margin-top: 6px;
    padding-bottom: 18px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--ink-3);
    text-wrap: pretty;
  }
  .method-buys {
    margin-top: auto;
    padding-top: 13px;
    border-top: 1px dashed var(--line-2);
    font-size: 13.05px;
    font-weight: 500;
    color: var(--teal-800);
  }
  @media (max-width: 960px) {
    .methods {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .methods {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ══ THE PUBLISHED RUNS ══════════════════════════════════════
     One section, two logs. Each log is a white panel: a numbered
     header with the link to the write-up, the figures, and a foot
     with the released weights. The figures inside drop their own
     frames, so the panel is the only box. */
  .log {
    margin-top: 46px;
    background: var(--surface);
    border: 1px solid var(--line-2);
  }
  .log + .log {
    margin-top: 22px;
  }
  .log-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 6px clamp(18px, 2.4vw, 30px);
    align-items: center;
    padding: 22px 28px;
    border-bottom: 1px solid var(--line);
  }
  .log-n {
    font-family: var(--hero-serif);
    font-size: clamp(40px, 4.4vw, 58px);
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--leaf);
  }
  .log-kind {
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--leaf-700);
  }
  .log-head h3 {
    margin-top: 4px;
    font-family: var(--hero-serif);
    font-size: clamp(21px, 2.3vw, 28.8px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.018em;
    text-wrap: balance;
  }
  /* About 10% larger than the site's mono buttons and set at 600, so
     the way into each log draws the eye. */
  .log-go {
    display: inline-flex;
    gap: 8px;
    padding: 11px 15.5px;
    font-family: var(--mono);
    font-size: 10.8px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--indigo-600);
    border: 1px solid var(--line-2);
    transition: border-color 400ms var(--ease);
  }
  .log-go:hover {
    border-color: var(--indigo-500);
  }
  .log-go span {
    transition: transform 400ms var(--ease);
  }
  .log-go:hover span {
    transform: translateX(3px);
  }
  .log-body {
    padding: 28px;
  }
  .log .ev {
    margin-top: 0;
  }
  /* Second log: its three figures left, the layer stack right. */
  .log .ev-lead {
    grid-template-columns: minmax(0, 3.6fr) minmax(0, 8.4fr);
    gap: clamp(24px, 3vw, 40px);
    align-items: stretch;
  }
  .log .ev-lead .stack {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .log .ev-lead .kv > div {
    grid-template-columns: minmax(0, 1fr);
    gap: 6px;
  }
  .log .ev-top {
    margin-top: 28px;
    gap: clamp(24px, 3vw, 40px);
  }
  .log .race,
  .log .rt {
    padding: 0;
    border: 0;
  }
  .log .stack {
    margin: 0;
  }
  .log .cliff {
    border: 0;
    background: var(--n-50);
  }
  .log .mm-chance em {
    background: var(--n-50);
  }
  .log-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    background: var(--n-50);
    border-top: 1px solid var(--line);
  }
  .log-foot > span {
    margin-right: 10px;
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .log-foot {
    column-gap: 22px;
  }
  .log-foot a {
    font-family: var(--mono);
    font-size: 10.8px;
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 4px;
    transition:
      text-decoration-color 400ms var(--ease),
      color 400ms var(--ease);
  }
  .log-foot a:hover {
    color: var(--teal-800);
    text-decoration-color: var(--teal-500);
  }
  .log-foot .log-all {
    margin-left: auto;
    color: var(--indigo-600);
    text-decoration: none;
  }
  @media (max-width: 700px) {
    .log-head {
      grid-template-columns: auto minmax(0, 1fr);
      padding: 18px;
    }
    .log-go {
      grid-column: 1 / -1;
      justify-self: start;
    }
    .log-body {
      padding: 18px;
    }
    .log-foot {
      padding: 14px 18px;
    }
    .log-foot .log-all {
      margin-left: 0;
    }
  }

  /* ══ EVIDENCE ════════════════════════════════════════════════ */
  .ev {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(28px, 4vw, 56px);
    margin-top: 46px;
    align-items: start;
  }
  .ev-top {
    margin-top: 14px;
    gap: 14px;
    align-items: stretch;
  }
  @media (max-width: 960px) {
    .ev {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* The race: two lanes from noise to image. Grey ticks are steps not
     yet taken, teal ones are done. */
  .race {
    margin: 0;
    padding: 24px 24px 18px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .race svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--mono);
  }
  .race-name {
    font-family: var(--hero-serif);
    font-size: 15px;
    fill: var(--ink);
  }
  .race-sub,
  .race-end,
  .race-status {
    font-size: 9.5px;
    fill: var(--ink-3);
  }
  .race-status.is-done {
    fill: var(--teal-700);
    font-weight: 500;
  }
  .race-line {
    fill: none;
    stroke: var(--line-2);
  }
  .race-tick {
    fill: var(--n-300);
  }
  .race-tick.is-on {
    fill: var(--teal-500);
  }
  .race-hop {
    fill: none;
    stroke: var(--line-2);
    stroke-dasharray: 3 4;
  }
  .race-hop.is-on {
    stroke: var(--teal-500);
    stroke-dasharray: none;
    stroke-width: 1.6;
  }
  .race-node {
    fill: var(--surface);
    stroke: var(--n-400);
    stroke-width: 1.4;
  }
  .race-node.is-on {
    fill: var(--teal-500);
    stroke: var(--teal-500);
  }
  .race-start {
    fill: var(--surface);
    stroke: var(--ink-3);
    stroke-width: 1.4;
  }
  .race-dot {
    fill: var(--ink);
    stroke: var(--surface);
    stroke-width: 2.5;
  }
  .race-dot.is-done {
    fill: var(--teal-700);
  }
  .race-frame {
    fill: none;
    stroke: var(--line-2);
  }
  .race figcaption {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  /* The four facts beside the race, stacked. */
  .kv {
    margin: 0;
    border-top: 1px solid var(--line-2);
  }
  .kv > div {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    padding-block: 19px;
    border-bottom: 1px solid var(--line-2);
  }
  .kv dt {
    font-family: var(--hero-serif);
    font-size: clamp(25px, 2.7vw, 33px);
    line-height: 1;
    letter-spacing: -0.018em;
    color: var(--teal-700);
    white-space: nowrap;
  }
  .kv dd {
    margin: 0;
    font-size: 13.05px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* The layer stack: 36 cells. On view, six collapse into the one
     beside them and the row closes up to 30 full cells. */
  .stack {
    margin: 46px 0 0;
    padding: 22px 24px 18px;
    background: var(--n-50);
    border: 1px solid var(--line);
  }
  .stack-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
    font-size: 12.6px;
    color: var(--ink-2);
  }
  .stack-count {
    position: relative;
    margin-right: auto;
    padding-left: 1.5em;
    font-family: var(--hero-serif);
    font-size: 21.6px;
    letter-spacing: -0.014em;
    color: var(--ink);
  }
  .stack-count b {
    position: absolute;
    left: 0;
    font-weight: 400;
    color: var(--teal-700);
    transition: opacity 500ms var(--ease) 900ms;
  }
  .stack-count b + b {
    opacity: 0;
  }
  .stack[data-on='true'] .stack-count b {
    opacity: 0;
  }
  .stack[data-on='true'] .stack-count b + b {
    opacity: 1;
  }
  .stack-key {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .stack-key i {
    width: 10px;
    height: 14px;
  }
  .sk-prot,
  .sl.sl-prot {
    background: repeating-linear-gradient(135deg, var(--n-400) 0 1.5px, var(--n-200) 1.5px 5px);
  }
  .sk-gone {
    border: 1px dashed var(--amber-500);
  }
  .sk-into {
    background: var(--teal-500);
  }
  .stack-row {
    display: flex;
    height: 76px;
    margin-top: 18px;
  }
  .sl {
    flex: 1 1 0;
    min-width: 0;
    margin-right: 3px;
    background: var(--n-300);
    transition:
      flex-grow 1100ms var(--ease) 600ms,
      flex-basis 1100ms var(--ease) 600ms,
      margin 1100ms var(--ease) 600ms,
      background 500ms var(--ease) 300ms;
  }
  .sl:last-child {
    margin-right: 0;
  }
  .sl.sl-gone {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--amber-500);
  }
  /* Collapsed layers end as amber slivers beside the layer that
     absorbed them, so the finished row still shows where they were. */
  .stack[data-on='true'] .sl-gone {
    flex-grow: 0;
    flex-basis: 2px;
    margin-right: 2px;
  }
  .stack[data-on='true'] .sl-into {
    background: var(--teal-500);
  }
  .stack-foot {
    display: flex;
    justify-content: space-between;
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--n-500);
  }
  .stack-foot span:nth-child(2) {
    margin: 0 auto 0 14px;
  }
  .stack-foot span:nth-child(3) {
    margin-right: 14px;
  }
  @media (max-width: 560px) {
    .sl {
      margin-right: 1px;
    }
    .stack-row {
      height: 52px;
    }
  }

  /* Retention: one row per benchmark, three dots. All three start at
     100% and slide left to what each pruned model kept. */
  .rt {
    margin: 0;
    padding: 24px 24px 20px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .rt-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: 12.6px;
    color: var(--ink-2);
  }
  .rt-legend span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .rt-legend i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .k-a,
  .rt-a {
    background: var(--teal-500);
  }
  .k-b,
  .rt-b {
    background: hsl(178 44% 70%);
  }
  .k-c,
  .rt-c {
    background: var(--surface);
    border: 1.6px solid var(--n-400);
  }
  .rt-axis,
  .rt-row {
    display: grid;
    grid-template-columns: 118px minmax(0, 1fr) 132px;
  }
  .rt-axis {
    margin-top: 20px;
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--n-500);
  }
  .rt-axis > span {
    align-self: end;
    padding-right: 10px;
    line-height: 1.4;
  }
  .rt-ticks {
    display: flex;
    justify-content: space-between;
    align-self: end;
  }
  .rt-ticks i {
    font-style: normal;
    width: 0;
    display: flex;
    justify-content: center;
    white-space: nowrap;
  }
  .rt-rows {
    margin-top: 8px;
  }
  .rt-row {
    align-items: center;
    min-height: 36px;
    border-top: 1px solid var(--line);
  }
  .rt-name {
    padding-right: 10px;
    font-size: 12.6px;
    color: var(--ink-2);
  }
  .rt-track {
    position: relative;
    height: 36px;
  }
  .rt-grid {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px calc(100% / 3));
    opacity: 0.8;
  }
  .rt-bar {
    position: absolute;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    left: calc((var(--c) - 25) * 1% / 0.75);
    right: 0;
    background: var(--teal-500);
    opacity: 0.28;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 1100ms var(--ease) calc(300ms + var(--i) * 90ms);
  }
  .rt-dot {
    position: absolute;
    top: 50%;
    left: 100%;
    width: 11px;
    height: 11px;
    margin: -5.5px 0 0 -5.5px;
    border-radius: 50%;
    transition: left 1100ms var(--ease) calc(300ms + var(--i) * 90ms);
  }
  .rt-a {
    box-shadow: 0 0 0 3px var(--surface);
  }
  /* The axis starts at 25% (chance on MMLU), so a value v sits at
     (v - 25) / 75 of the track. */
  [data-on='true'] .rt-a {
    left: calc((var(--a) - 25) * 1% / 0.75);
  }
  [data-on='true'] .rt-b {
    left: calc((var(--b) - 25) * 1% / 0.75);
  }
  [data-on='true'] .rt-c {
    left: calc((var(--c) - 25) * 1% / 0.75);
  }
  [data-on='true'] .rt-bar {
    transform: scaleX(1);
  }
  .rt-val {
    padding-left: 12px;
    font-family: var(--mono);
    font-size: 10.35px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .rt-val b {
    font-weight: 500;
    color: var(--teal-700);
  }
  .rt-weak {
    border-top-color: var(--ink-2);
  }
  .rt-weak .rt-name {
    font-weight: 500;
    color: var(--ink);
  }
  .rt-weak .rt-a {
    background: var(--amber-500);
  }
  .rt-weak .rt-bar {
    background: var(--amber-500);
  }
  .rt-weak .rt-val b {
    color: var(--amber-800);
  }
  .rt figcaption {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 560px) {
    .rt-axis,
    .rt-row {
      grid-template-columns: 96px minmax(0, 1fr) 44px;
    }
    .rt-axis > span {
      font-size: 0;
    }
    .rt-val {
      font-size: 0;
    }
    .rt-val b {
      font-size: 10.35px;
    }
  }

  /* The cliff: one model, two measurements that disagree. */
  .cliff {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .cliff-h span {
    margin-left: 8px;
    font-family: var(--mono);
    font-size: 9.9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .cliff-h {
    margin-bottom: 4px;
    font-family: var(--hero-serif);
    font-size: 19.8px;
    line-height: 1.25;
    letter-spacing: -0.012em;
  }
  .cliff-a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px 14px;
    align-items: baseline;
    padding: 14px 0;
    border-top: 1px solid var(--line-2);
  }
  .cliff-who {
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .cliff-a b {
    grid-row: 1 / 3;
    grid-column: 2;
    align-self: center;
    font-family: var(--hero-serif);
    font-size: 28.8px;
    font-weight: 400;
    letter-spacing: -0.018em;
    color: var(--teal-700);
  }
  .cliff-bad b {
    color: var(--amber-800);
  }
  .cliff-tag {
    font-size: 13.05px;
    color: var(--ink-2);
  }
  /* MMLU by layer count. Bars share a 0 to 80 scale; the dashed line
     is random chance. */
  .mm {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    align-items: end;
