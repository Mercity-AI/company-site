<script is:inline>
  /* ── Hero scroll: the ground frosts, then the copy blurs away.
     Under the layout's virtual scroll, `v2scroll` fires inside its own
     frame after the wrapper moves, so we update synchronously there;
     native scrolling goes through one rAF. ── */
  (() => {
    const hero = document.querySelector('[data-sh]');
    if (!hero) return;
    const stage = hero.querySelector('.sh-stage');
    const copy = hero.querySelector('[data-sh-copy]');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const clamp = (v) => (v < 0 ? 0 : v > 1 ? 1 : v);
    const ease = (t) => 1 - Math.pow(1 - t, 3);
    const update = () => {
      const r = hero.getBoundingClientRect();
      const span = r.height - stage.offsetHeight;
      const p = span > 0 ? clamp(-r.top / span) : 1;
      hero.style.setProperty('--a', ease(clamp(p / 0.5)).toFixed(4));
      const o = clamp((p - 0.45) / 0.5);
      hero.style.setProperty('--o', (o * o).toFixed(4));
      hero.toggleAttribute('data-leaving', o > 0.001);
      copy.dataset.live = o < 0.5 ? 'true' : 'false';
    };
    let raf = 0;
    const req = () => {
      if (!raf)
        raf = requestAnimationFrame(() => {
          raf = 0;
          update();
        });
    };
    window.addEventListener('scroll', () => (document.documentElement.dataset.vscroll ? null : req()), { passive: true });
    window.addEventListener('v2scroll', update);
    window.addEventListener('resize', req);
    update();
  })();

  /* ── Hero squeeze: the two published runs, one at a time. The stack
     shows at full size, the plates that go are outlined, then they
     slide out and the rest drops inside the wireframe of the original
     size. Only classes, text, attributes and inline transforms change,
     so the page's styles always apply. Runs only while the hero is on screen;
     without the script the markup shows the first run, finished. ── */
  (() => {
    const fig = document.querySelector('[data-sq]');
    if (!fig || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const runs = JSON.parse(fig.dataset.sq);
    const stack = fig.querySelector('[data-sq-stack]');
    const plates = [...stack.querySelectorAll('.pl')];
    const q = (k) => fig.querySelector(`[data-sq-${k}]`);
    const notes = [...fig.querySelectorAll('[data-sq-note]')];
    // The frontmatter's ISO, repeated.
    const CX = 130;
    const A = 112;
    const B = 36;
    const BASE = 396;
    const H = 330;
    const SLIDE = [48, 15];
    let n = 0;
    let timers = [];
    let running = false;
    const later = (fn, ms) => timers.push(setTimeout(fn, ms));
    const clear = () => {
      timers.forEach(clearTimeout);
      timers = [];
    };
    // Put every plate where `state` wants it: 'full' is the original
    // stack; 'cut' slides the cut plates out along the plate's own axis
    // and drops the rest onto what is left.
    const place = (r, state) => {
      const gone = new Set(r.cut);
      const p = H / (r.n - 1);
      const done = state === 'cut';
      let rank = 0;
      let k = 0;
      plates.forEach((g, i) => {
        if (i >= r.n) return;
        const c = gone.has(i);
        const x = CX + (c && done ? SLIDE[0] : 0);
        const y = c ? BASE - i * p + (done ? SLIDE[1] : 0) : BASE - (done ? rank : i) * p;
        if (!c) rank++;
        g.style.transitionDelay = c ? `${(k++ % 11) * 35}ms` : done ? '520ms' : '0ms';
        g.style.transform = `translate(${x}px,${y.toFixed(2)}px)`;
        g.style.opacity = c && done ? 0 : 1;
      });
      stack.dataset.state = state;
    };
    const set = (r) => {
      const gone = new Set(r.cut);
      const t = (H / (r.n - 1)) * 0.6;
      stack.dataset.swap = 'true';
      plates.forEach((g, i) => {
        g.classList.toggle('is-off', i >= r.n);
        g.classList.toggle('is-cut', gone.has(i));
        const [l, rt] = g.children;
        l.setAttribute('points', `${-A},0 0,${B} 0,${B + t} ${-A},${t}`);
        rt.setAttribute('points', `0,${B} ${A},0 ${A},${t} 0,${B + t}`);
      });
      place(r, 'full');
      void stack.getBoundingClientRect();
      delete stack.dataset.swap;
      q('tech').textContent = r.tech;
      q('model').textContent = r.model;
      q('from').textContent = r.from;
      q('to').textContent = r.to;
      q('unit').textContent = r.unit;
      notes.forEach((el, i) => (el.textContent = r.notes[i]));
    };
    const squeeze = () => {
      place(runs[n], 'full');
      later(() => (stack.dataset.state = 'mark'), 1000);
      later(() => place(runs[n], 'cut'), 2300);
      later(next, 8600);
    };
    const next = () => {
      if (!running) return;
      fig.dataset.fade = 'true';
      later(() => {
        n = (n + 1) % runs.length;
        set(runs[n]);
        later(() => {
          fig.dataset.fade = 'false';
          squeeze();
        }, 120);
      }, 650);
    };
    new IntersectionObserver((e) => {
      const on = e[0].isIntersecting;
      if (on === running) return;
      running = on;
      clear();
      if (on) later(squeeze, 1900);
    }).observe(fig);
  })();

  /* ── Play once: any [data-play] gets data-on when it is well in view.
     Reduced motion shows the finished state at once. ── */
  (() => {
    const els = [...document.querySelectorAll('[data-play]')];
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      els.forEach((el) => (el.dataset.on = 'true'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.dataset.on = 'true';
          io.unobserve(e.target);
        }),
      { threshold: 0.35 }
    );
    els.forEach((el) => io.observe(el));
  })();

  /* ── The race: both dots leave noise together and take the same
     time per step. The distilled model is done after six; the base
     model is still on its way. Each lane's picture clears as it
     goes. Loops while on screen; without the script, or with reduced
     motion, the markup already shows both lanes finished. ── */
  (() => {
    const fig = document.querySelector('[data-race]');
    if (!fig || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const X0 = 150;
    const X1 = 500;
    const STEP = 130;
    const HOLD = 2200;
    const lanes = [...fig.querySelectorAll('[data-lane]')].map((g, i) => {
      const n = i ? 6 : 50;
      return {
        n,
        dx: (X1 - X0) / n,
        y: Number(g.querySelector('[data-race-dot]').getAttribute('cy')),
        dot: g.querySelector('[data-race-dot]'),
        noise: g.querySelector('[data-race-noise]'),
        status: g.querySelector('[data-race-status]'),
        marks: [...g.querySelectorAll(i ? '.race-node' : '.race-tick')],
        hops: [...g.querySelectorAll('.race-hop')],
        hop: i === 1,
        shown: -1,
      };
    });
    const draw = (t) => {
      lanes.forEach((ln) => {
        const s = Math.min(ln.n, t / STEP);
        const k = Math.floor(s);
        const f = s - k;
        ln.dot.setAttribute('cx', (X0 + s * ln.dx).toFixed(1));
        if (ln.hop) ln.dot.setAttribute('cy', (ln.y - (s < ln.n ? Math.sin(f * Math.PI) * 17 : 0)).toFixed(1));
        ln.noise.setAttribute('opacity', (1 - Math.pow(s / ln.n, 1.6)).toFixed(3));
        if (k === ln.shown) return;
        ln.shown = k;
        ln.marks.forEach((m, i) => m.classList.toggle('is-on', i < k));
        ln.hops.forEach((m, i) => m.classList.toggle('is-on', i < k));
        ln.dot.classList.toggle('is-done', k >= ln.n);
        ln.status.classList.toggle('is-done', k >= ln.n);
        ln.status.textContent = k >= ln.n ? `done in ${ln.n}` : `step ${k} of ${ln.n}`;
      });
    };
    let t0 = 0;
    let raf = 0;
    let running = false;
    const frame = (now) => {
      raf = 0;
      if (!running) return;
      if (!t0 || now - t0 > 50 * STEP + HOLD) t0 = now;
      draw(now - t0);
      raf = requestAnimationFrame(frame);
    };
    new IntersectionObserver(
      (e) => {
        running = e[0].isIntersecting;
        if (running && !raf) {
          t0 = 0;
          raf = requestAnimationFrame(frame);
        }
      },
      { threshold: 0.3 }
    ).observe(fig);
  })();

</script>

