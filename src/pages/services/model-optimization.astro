---
/**
 * Model optimization, as a service.
 *
 * For buyers at the bottom of the funnel: they have a model that is too
 * slow, too large or too expensive to run, they know the answer is
 * distillation, pruning or quantization, and they are deciding who does
 * it. The page shows the two optimizations we have published, what they
 * cost in quality, what we offer, and how an engagement runs.
 *
 * The page shares the service pages' hero scroll and closer and
 * nothing else on purpose: Harsh found the first version too close to
 * the guardrails page. No proof strip, no "Our service" labels, no
 * icon-node flow, no paper cards, no two-column FAQ. Keep new sections
 * in forms the other two pages do not already use.
 *
 * Graphics play on their own when they come into view; hover only adds
 * emphasis. The FAQ is the one thing behind a click: Harsh asked for a
 * dropdown.
 *
 * The hero keeps the other service pages' pinned scroll and blur, on
 * `moStrata`: the same strata construction on a jade-to-lime ramp. Page
 * neutrals are cooled to sage in the style block, the dark section is
 * pine, and amber marks the one failure (the knowledge cliff) only.
 *
 * Figures: every number is from our two research logs. Distillation
 * (50 → 4–6 steps, 8× and 12.5×, ~100 MB, ~4 hours and $8–10 on one
 * A100, 70 → 6 GPU hours per 10,000 images, 15–25 s → 2–4 s) is from
 * the LCM-LoRA log; pruning (36 → 28 layers, 22.2%, every benchmark and
 * retention figure, the perplexity ratios) is from the LaCo log.
 * "6 to 14 weeks" is Pranav's engagement figure from the home page and
 * "26 models" is the home page's hand count of huggingface.co/Mercity.
 * The cost-slope chart, the technique diagrams and the trade-off chart
 * are illustrations.
 *
 * The page sells; it does not teach. Harsh found an earlier version
 * "very educational": it explained the problem and the techniques to
 * buyers who already know both. So the order is the buyer's: which
 * number has to move → how we get there → proof we have done it → you
 * approve the trade → is this your situation → methods (as "when we
 * use it", last) → questions. The ask ("Get a baseline") is in the
 * hero, under the engagement stages (Harsh asked for that one back)
 * and the closer. No tinted pills or chips anywhere: Harsh finds them
 * AI-looking, so facts sit as plain lines under a rule.
 * Copy is short on purpose; he called a longer pass "sloppy".
 */
import V2Layout from '@/layouts/V2Layout.astro';

const LCM_URL = '/research/lcm-lora-distillation-training-fast-diffusion-models';
const LACO_URL = '/research/laco-layer-pruning-for-qwen3-8b-our-research-log';
const HF_URL = 'https://huggingface.co/Mercity';
// Public model repos under huggingface.co/Mercity, typed in by hand as
// on the home page. Update both places together.
const HF_MODELS = 26;

/* Line icons on a 24 grid, drawn with currentColor. */
const ICON: Record<string, string> = {
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.5 2"/>',
  cost: '<path d="M3 20h18"/><path d="M5 16l5-5 3 3 6-8"/><path d="M15 6h4v4"/>',
  dollar: '<path d="M12 3v18"/><path d="M16.5 7.5c-.8-1.3-2.4-2-4.5-2-2.6 0-4.2 1.3-4.2 3.1 0 4.4 9 2.3 9 6.8 0 1.9-1.8 3.2-4.6 3.2-2.3 0-4.1-.9-4.9-2.4"/>',
  chip: '<rect x="7" y="7" width="10" height="10"/><path d="M10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4"/>',
  image: '<rect x="3" y="5" width="18" height="14"/><circle cx="9" cy="10" r="1.6"/><path d="M3 17l5-4 4 3 3-2 6 4"/>',
  layers: '<path d="M12 3l9 5-9 5-9-5z"/><path d="M3 12l9 5 9-5M3 16l9 5 9-5"/>',
  device: '<rect x="7" y="2.5" width="10" height="19"/><path d="M10.5 18.5h3"/>',
  batch: '<path d="M8 3h9l3 3v13H8z"/><path d="M5 6v15h11"/><path d="M11 9h6M11 12.5h6M11 16h3"/>',
  cloud: '<path d="M7 18a4 4 0 0 1-.6-7.96A5.5 5.5 0 0 1 17 9a4.5 4.5 0 0 1 .5 9z"/><path d="M12 12v5M9.8 14.8L12 17l2.2-2.2"/>',
  voice: '<rect x="9" y="3" width="6" height="11"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3M8.5 21h7"/>',
};

/* ── Hero: the squeeze. An isometric stack of plates, one per unit of
   work (a denoising step, a transformer layer), inside a dashed
   wireframe of its original size. `cut` lists the plates that go;
   index 0 is the bottom plate. Both runs are from our research logs. ── */
const SQ_MAX = 50;
const range = (n: number) => Array.from({ length: n }, (_, i) => i);
const SD_KEEP = [0, 10, 20, 29, 39, 49];
const runs = [
  {
    tech: 'Distillation · LCM-LoRA',
    model: 'Stable Diffusion 1.5',
    n: 50,
    cut: range(50).filter((i) => !SD_KEEP.includes(i)),
    from: '50',
    to: '6',
    unit: 'denoising steps per image',
    notes: ['15–25 seconds an image, down to 2–4', '100 MB adapter, base model untouched'],
  },
  {
    tech: 'Layer pruning · LaCo',
    model: 'Qwen3-8B',
    n: 36,
    cut: [20, 21, 22, 23, 24, 25, 26, 27],
    from: '36',
    to: '28',
    unit: 'transformer layers',
    notes: ['71–87% of reasoning scores kept', 'Measured before any post-training'],
  },
];

/* Plate geometry, in the figure's 260 × 450 viewBox. A plate is a
   rhombus top (half-width a, half-depth b) over two side faces of
   thickness t. The stack always spans H, so the pitch depends on the
   plate count. The hero script repeats these numbers. */
const ISO = { cx: 130, a: 112, b: 36, base: 396, H: 330, slide: [48, 15] };
const isoPitch = (n: number) => ISO.H / (n - 1);
const isoFaces = (t: number) => ({
  top: `0,${-ISO.b} ${ISO.a},0 0,${ISO.b} ${-ISO.a},0`,
  left: `${-ISO.a},0 0,${ISO.b} 0,${ISO.b + t} ${-ISO.a},${t}`,
  right: `0,${ISO.b} ${ISO.a},0 ${ISO.a},${t} 0,${ISO.b + t}`,
});
// The first run's finished state, so the figure is right without the script.
const plates0 = (() => {
  const r = runs[0];
  const p = isoPitch(r.n);
  const f = isoFaces(p * 0.6);
  let rank = 0;
  return range(SQ_MAX).map((i) => {
    const off = i >= r.n;
    const cut = !off && r.cut.includes(i);
    const x = ISO.cx + (cut ? ISO.slide[0] : 0);
    const y = cut ? ISO.base - i * p + ISO.slide[1] : ISO.base - rank * p;
    if (!off && !cut) rank++;
    return { off, cut, f, style: `transform:translate(${x}px,${y.toFixed(2)}px);opacity:${cut ? 0 : 1}` };
  });
})();
const WT = ISO.base - ISO.H;
const WB = ISO.base + 5;
const wire =
  `M${ISO.cx} ${WT - ISO.b}L${ISO.cx + ISO.a} ${WT}L${ISO.cx} ${WT + ISO.b}L${ISO.cx - ISO.a} ${WT}Z` +
  `M${ISO.cx - ISO.a} ${WT}V${WB}L${ISO.cx} ${WB + ISO.b}L${ISO.cx + ISO.a} ${WB}V${WT}` +
  `M${ISO.cx} ${WT + ISO.b}V${WB + ISO.b}`;

/* ── The four numbers a buyer comes with. Each carries the result
   we can point to; throughput has no published run, so it says how
   it is measured instead. ── */
const targets = [
  { icon: 'clock', title: 'Latency', line: 'Responses inside your budget.', tag: 'Shown', proof: 'Stable Diffusion: 15–25 s → 2–4 s an image', href: LCM_URL },
  { icon: 'dollar', title: 'Cost per request', line: 'A lower GPU bill at the same traffic.', tag: 'Shown', proof: '10,000 images: 70 → 6 GPU hours', href: LCM_URL },
  { icon: 'chip', title: 'Model size', line: 'A model that fits the hardware you have.', tag: 'Shown', proof: 'Qwen3-8B: 36 → 28 layers', href: LACO_URL },
  { icon: 'cost', title: 'Throughput', line: 'More requests from every GPU.', tag: 'Measured', proof: 'Load-tested on your hardware' },
];

/* ── What we do: six techniques, each with a small diagram. The
   diagrams are injected with set:html, so every colour is a literal
   attribute (scoped class styles do not reach them). ── */
const G = '#b9c4b9';
const L = '#2c8c5f';
const F = '#e4f6de';
const T = '#5d6f65';
const txt = (x: number, y: number, s: string, fill = T, anchor = 'start', size = 9) =>
  `<text x="${x}" y="${y}" font-size="${size}" fill="${fill}" text-anchor="${anchor}">${s}</text>`;
const cells = (x0: number, y0: number, n: number, fill: string) =>
  Array.from({ length: n * n }, (_, k) => `<rect x="${x0 + (k % n) * 12}" y="${y0 + Math.floor(k / n) * 12}" width="10" height="10" fill="${fill}"/>`).join('');
const arrow = (x: number, y: number, w: number) => `<path d="M${x} ${y}h${w}M${x + w - 6} ${y - 5}l6 5-6 5" fill="none" stroke="${T}" stroke-width="1.2"/>`;
const ART: Record<string, string> = {
  distil:
    `<rect x="8" y="8" width="58" height="58" fill="none" stroke="${G}"/>${cells(14, 14, 4, '#dfe6dc')}` +
    arrow(80, 37, 50) +
    txt(105, 28, 'outputs', T, 'middle') +
    `<rect x="146" y="20" width="34" height="34" fill="${F}" stroke="${L}"/>${cells(152, 26, 2, L)}` +
    txt(8, 80, 'teacher') +
    txt(146, 80, 'student', L),
  prune:
    Array.from({ length: 9 }, (_, k) =>
      [3, 4, 6].includes(k)
        ? `<rect x="8.5" y="${4.5 + k * 7}" width="69" height="4" fill="none" stroke="${G}" stroke-dasharray="3 3"/>`
        : `<rect x="8" y="${4 + k * 7}" width="70" height="5" fill="#cfd8cc"/>`,
    ).join('') +
    arrow(92, 34, 38) +
    Array.from({ length: 6 }, (_, k) => `<rect x="144" y="${14 + k * 7}" width="70" height="5" fill="${L}"/>`).join('') +
    txt(8, 80, '9 layers') +
    txt(144, 80, '6 layers', L),
  quant:
    `<path d="M8 52C40 0 72 0 106 34S170 70 212 18" fill="none" stroke="${G}" stroke-width="1.4"/>` +
    `<path d="M8 50h17V30h17V16h34v10h17v14h17v14h34V42h17V28h17V18h17" fill="none" stroke="${L}" stroke-width="1.6"/>` +
    txt(8, 80, '32-bit weights') +
    txt(212, 80, '4-bit', L, 'end'),
  lora:
    `<rect x="8" y="8" width="58" height="58" fill="#eef2ec" stroke="${G}"/>` +
    txt(37, 42, 'W', T, 'middle', 14) +
    txt(86, 42, '+', T, 'middle', 14) +
    `<rect x="106" y="8" width="12" height="58" fill="${L}"/><rect x="128" y="8" width="58" height="12" fill="${L}"/>` +
    txt(134, 42, 'B · A', L, 'start', 12) +
    txt(8, 80, 'frozen') +
    txt(106, 80, 'trained', L),
  recover:
    `<path d="M70 18H212" fill="none" stroke="${G}" stroke-dasharray="3 4"/>` +
    `<path d="M8 18H70L82 56" fill="none" stroke="${T}" stroke-width="1.4"/>` +
    `<path d="M82 56C112 50 150 30 212 23" fill="none" stroke="${L}" stroke-width="2"/>` +
    `<circle cx="82" cy="56" r="3" fill="#fff" stroke="${T}"/>` +
    txt(8, 80, 'compress') +
    txt(212, 80, 'fine-tune back', L, 'end'),
  serve:
    Array.from({ length: 6 }, (_, k) => `<rect x="${8 + (k % 3) * 12}" y="${22 + Math.floor(k / 3) * 12}" width="8" height="8" fill="#cfd8cc"/>`).join('') +
    arrow(52, 32, 28) +
    `<rect x="92" y="18" width="46" height="28" fill="${F}" stroke="${L}"/>` +
    txt(115, 36, 'batch', L, 'middle') +
    arrow(148, 32, 22) +
    `<rect x="180" y="12" width="32" height="40" fill="none" stroke="${T}"/><path d="M186 22h20M186 32h20M186 42h20" stroke="${G}"/>` +
    txt(8, 80, 'requests') +
    txt(212, 80, 'one GPU', T, 'end'),
};
const methods = [
  { art: 'distil', title: 'Distillation', line: 'For the same output in fewer steps or parameters.', buys: 'Fewer steps, fewer parameters' },
  { art: 'prune', title: 'Pruning', line: 'For layers the model does not need.', buys: 'Less memory, less compute' },
  { art: 'quant', title: 'Quantization', line: 'For memory and GPU limits.', buys: 'Smaller GPUs, lower cost' },
  { art: 'lora', title: 'Adapters', line: 'For base models that cannot change.', buys: 'Megabytes, not gigabytes' },
  { art: 'recover', title: 'Recovery training', line: 'For quality lost in compression.', buys: 'Quality back at the smaller size' },
  { art: 'serve', title: 'Inference engineering', line: 'For a good model on slow serving.', buys: 'More requests per GPU' },
];

/* ── Evidence one: LCM-LoRA. The race is drawn here; the script only
   moves the two dots and lights what they pass. ── */
const RACE = { x0: 150, x1: 500, y: [72, 186], tile: 92 };
const T_STEPS = 50;
const S_STEPS = 6;
const tDx = (RACE.x1 - RACE.x0) / T_STEPS;
const sDx = (RACE.x1 - RACE.x0) / S_STEPS;
const lcmFacts = [
  { fig: '50 → 4–6', line: 'denoising steps per image' },
  { fig: '~100 MB', line: 'adapter size, base model untouched' },
  { fig: '~4 hours', line: 'to train on one A100, about $8 to $10' },
  { fig: '70 → 6', line: 'GPU hours per 10,000 images, at 4 steps' },
];

/* ── Evidence two: LaCo on Qwen3-8B, shown at the log's 28-layer cut
   (the hero's number). Layers 0–3 and 29–35 were never candidates.
   The log names the merged layers only for 30 layers (22–27 into 21),
   so the eight collapsed here (20–27 into 19) are illustrative.
   Retention is each pruned model's score as a share of the
   original's, from the log: a is 28 layers (highlighted), b is 30,
   c is 26. ── */
const layerKind = (i: number) => (i < 4 || i > 28 ? 'prot' : i === 19 ? 'into' : i > 19 && i < 28 ? 'gone' : 'keep');
const retention = [
  { name: 'WinoGrande', a: 83.0, b: 93.8, c: 78.2 },
  { name: 'PIQA', a: 87.0, b: 89.7, c: 82.6 },
  { name: 'ARC-Challenge', a: 76.2, b: 85.9, c: 69.5 },
  { name: 'ARC-Easy', a: 73.1, b: 80.6, c: 68.5 },
  { name: 'HellaSwag', a: 70.7, b: 78.9, c: 61.8 },
  { name: 'BoolQ', a: 74.9, b: 78.2, c: 74.3 },
  { name: 'MMLU', a: 33.7, b: 40.7, c: 32.7, weak: true },
];
const mmlu = [
  { l: '36', v: 76.89 },
  { l: '30', v: 31.3 },
  { l: '28', v: 25.89 },
  { l: '26', v: 25.12 },
];
const lacoFacts = [
  { fig: '22.2%', line: 'of the layers removed' },
  { fig: '2.01×', line: 'perplexity ratio at 28 layers' },
  { fig: 'None', line: 'post-training before scoring' },
];
const lcmWeights = ['lcm-lora-sd15-step-400', 'lcm-lora-sd15-step-800', 'lcm-lora-sd15-step-1200', 'lcm-lora-sd15-step-1600'];
const lacoWeights = ['Qwen3-8B-LaCo-30L'];

/* ── The trade-off chart. c is cost per request and q is quality, both
   0 to 1; `front` points are on the frontier, in order from today's
   model down to the cheapest. Illustrative. ── */
const FX = (c: number) => 20 + c * 1070;
const FY = (q: number) => 382 - q * 352;
const BUDGET = 0.5;
const FLOOR = 0.8;
const front = [
  { c: 0.92, q: 0.93, label: 'Your model today', kind: 'today' },
  { c: 0.74, q: 0.92, label: '8-bit' },
  { c: 0.55, q: 0.89, label: 'Distilled' },
  { c: 0.4, q: 0.86, label: 'Distilled, 8-bit', kind: 'pick' },
  { c: 0.28, q: 0.72, label: 'Pruned 17%' },
  { c: 0.17, q: 0.5, label: 'Pruned 28%', kind: 'low' },
  { c: 0.1, q: 0.3, label: '' },
];
const behind = [
  [0.86, 0.74], [0.8, 0.84], [0.7, 0.6], [0.66, 0.8], [0.6, 0.7], [0.48, 0.74],
  [0.45, 0.6], [0.36, 0.56], [0.34, 0.3], [0.22, 0.2],
];
const frontD = front.map((p, i) => `${i ? 'L' : 'M'}${FX(p.c)} ${FY(p.q)}`).join(' ');
/* ── Engagement: five stages as one object. The small figure in each
   shows the candidate pool narrowing: one model in, many candidates,
   a shortlist, one model out. ── */
const flow = [
  { art: 'profile', title: 'Profile', line: 'Where the time and the money go.', out: 'Baseline report' },
  { art: 'target', title: 'Target', line: 'Your budget and your quality floor.', out: 'Agreed numbers' },
  { art: 'many', title: 'Compress', line: 'Many candidates, several methods.', out: 'Candidate models' },
  { art: 'few', title: 'Recover', line: 'The best few, trained back up.', out: 'Scored shortlist' },
  { art: 'one', title: 'Ship', line: 'One model, verified on your hardware.', out: 'Weights and report' },
];
const DOTS = range(12).map((k) => ({ x: 10 + (k % 6) * 20, y: 20 + Math.floor(k / 6) * 24 }));
const SHORTLIST = [1, 4, 8, 10];

/* ── Where it is used ──────────────────────────────────────────── */
const cases = [
  { icon: 'image', title: 'Interactive image tools', before: '50 steps, 15 to 25 seconds an image', after: '4 to 6 steps, a few seconds' },
  { icon: 'layers', title: 'Self-hosted language models', before: 'A large model on your largest GPU', after: 'Fewer layers and bits, on a smaller one' },
  { icon: 'device', title: 'On-device models', before: 'Too large for the phone or the edge box', after: 'A student sized to the device' },
  { icon: 'batch', title: 'High-volume pipelines', before: 'Millions of documents through a large model', after: 'A distilled model at a fraction of the GPU hours' },
  { icon: 'cloud', title: 'Moving off a hosted API', before: 'A per-token bill that grows with usage', after: 'A small open model, tuned to your task, in your cloud' },
  { icon: 'voice', title: 'Turn-by-turn latency', before: 'A pause before every reply', after: 'First token inside your budget' },
];

const faqs = [
  { q: 'How much quality will we lose?', a: 'You set the floor. We report the loss per task before anything ships.' },
  { q: 'Which technique do we need?', a: 'Usually two or three. We profile first, then choose.' },
  { q: 'Do you need our data?', a: 'A sample of your traffic, or a dataset like it. If you have neither, we generate one.' },
  { q: 'Can you optimize a model behind an API?', a: 'We need the weights. On a hosted API, we train an open model on your task so you can move off it.' },
  { q: 'Will it run on our stack?', a: 'Yes. We deliver in the format your serving stack loads.' },
  { q: 'What if the target cannot be reached?', a: 'You hear it early. The baseline shows how close the model can get.' },
];
---

<V2Layout
  title="Model optimization"
  description="Distillation, pruning and quantization for models that are too slow, too large or too expensive to run. Delivered with before-and-after benchmarks on your own tasks."
  path="/services/model-optimization"
>
  <!-- ═══ HERO: the pinned scroll, on green strata ═══════════════ -->
  <section class="sh" data-sh>
    <div class="sh-stage" data-vsticky="0">
      <div class="sh-plate" aria-hidden="true">
        <canvas class="sh-sharp" data-backdrop="moStrata" data-seed="5519" data-dpr="1"></canvas>
        <canvas class="sh-soft" data-backdrop="moStrata" data-seed="5519" data-dpr="0.35"></canvas>
        <span class="sh-light l1"></span>
        <span class="sh-light l2"></span>
        <span class="sh-light l3"></span>
        <span class="sh-shade"></span>
      </div>

      <div class="sh-copy" data-sh-copy data-live="true">
        <div class="shell sh-copy-in">
          <div class="sh-text">
            <h1 class="sh-in"><span class="sh-h1-lead">Optimizing models</span> <span class="sh-h1-rest">for <span class="nowrap">production-grade</span> high performance.</span></h1>
            <p class="sh-in d1">
              We optimize models to deliver the performance your applications need, with less compute, lower latency, and reduced inference costs. <br />From quantization and fine-tuning to inference optimization and model compression, every improvement is engineered around your workloads and validated against your quality benchmarks.
            </p>
            <div class="sh-actions sh-in d2">
              <a class="wipe" href="/contact">
                <span class="wipe-fill"></span>
                <span class="wipe-label">Get a baseline</span>
                <span class="wipe-label" aria-hidden="true">→</span>
              </a>
              <a class="quiet" href="#research">See what we have shipped<span aria-hidden="true">↓</span></a>
            </div>
          </div>

          <figure class="sq sh-in d3" data-sq={JSON.stringify(runs)} aria-label="Two optimizations from our research: Stable Diffusion 1.5 from 50 denoising steps to 6, and Qwen3-8B from 36 layers to 28.">
            <div class="sq-stack" data-sq-stack data-state="cut" aria-hidden="true">
              <svg viewBox="0 0 260 450">
                <path class="sq-wire" d={wire} />
                {
                  plates0.map((pl) => (
                    <g class:list={['pl', pl.off && 'is-off', pl.cut && 'is-cut']} style={pl.style}>
                      <polygon class="pl-l" points={pl.f.left} />
                      <polygon class="pl-r" points={pl.f.right} />
                      <polygon class="pl-top" points={pl.f.top} />
                    </g>
                  ))
                }
              </svg>
            </div>
            <figcaption class="sq-read">
              <span class="sq-tech" data-sq-tech>{runs[0].tech}</span>
              <span class="sq-model" data-sq-model>{runs[0].model}</span>
              <span class="sq-fig">
                <span data-sq-from>{runs[0].from}</span>
                <i aria-hidden="true">→</i>
                <b data-sq-to>{runs[0].to}</b>
              </span>
              <span class="sq-unit" data-sq-unit>{runs[0].unit}</span>
              <ul class="sq-notes">
                {runs[0].notes.map((t) => <li data-sq-note>{t}</li>)}
              </ul>
              <span class="sq-src">From our published research</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ THE NUMBER: WHAT YOU COME WITH, WHAT WE COMMIT TO ════ -->
  <section class="band" id="targets">
    <div class="shell">
      <div class="split-head">
        <h2 class="h2 rv" data-rv style="--rv-delay:80ms">The metrics that we optimize for.</h2>
        <p class="lede rv" data-rv style="--rv-delay:160ms">
          When it comes to model optimization, we build until the numbers meet your goals.
        </p>
      </div>

      <div class="why">
        <figure class="slope rv" data-rv data-play>
          <svg viewBox="0 0 520 340" role="img" aria-label="Inference spend against requests per day: today's curve bends upward as traffic grows; after optimization it flattens out.">
            <path class="slope-axis" d="M20 20V292H512" />
            <path class="slope-gap" d="M20 288C185.6 224.8 367.8 158.4 500 36V221C326.1 234.6 143.9 263 20 288Z" />
            <path class="slope-now" d="M20 288C185.6 224.8 367.8 158.4 500 36" pathLength="1" />
