<script is:inline>
  /* ── Hero scroll: the ground frosts, then the copy blurs away.
     Under the layout's virtual scroll, `v2scroll` fires inside its own
     frame after the wrapper moves, so we update synchronously there;
     native scrolling goes through one rAF. ── */
  (() => {
    const hero = document.querySelector('[data-sh]');
    if (!hero) return;
    const stage = hero.querySelector('.sh-stage');
    const copy = hero.querySelector('[data-sh-copy]');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const clamp = (v) => (v < 0 ? 0 : v > 1 ? 1 : v);
    const ease = (t) => 1 - Math.pow(1 - t, 3);
    const update = () => {
      const r = hero.getBoundingClientRect();
      const span = r.height - stage.offsetHeight;
      const p = span > 0 ? clamp(-r.top / span) : 1;
      hero.style.setProperty('--a', ease(clamp(p / 0.5)).toFixed(4));
      const o = clamp((p - 0.45) / 0.5);
      hero.style.setProperty('--o', (o * o).toFixed(4));
      hero.toggleAttribute('data-leaving', o > 0.001);
      copy.dataset.live = o < 0.5 ? 'true' : 'false';
    };
    let raf = 0;
    const req = () => {
      if (!raf)
        raf = requestAnimationFrame(() => {
          raf = 0;
          update();
        });
    };
    window.addEventListener('scroll', () => (document.documentElement.dataset.vscroll ? null : req()), { passive: true });
    window.addEventListener('v2scroll', update);
    window.addEventListener('resize', req);
    update();
  })();

  /* ── Hero check: one request at a time. Each layer lights in turn
     (about a second apart), the catching layer turns amber, the
     verdict settles, and after a long hold the card fades to the next
     request. The verdict slides into the small log underneath. Only
     text and data attributes change, so the page's styles always
     apply. Runs only while the hero is on screen. ── */
  (() => {
    const fig = document.querySelector('[data-chk]');
    if (!fig || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const items = JSON.parse(fig.dataset.chk);
    const body = fig.querySelector('[data-chk-body]');
    const src = fig.querySelector('[data-chk-src]');
    const text = fig.querySelector('[data-chk-text]');
    const verdict = fig.querySelector('[data-chk-verdict]');
    const v = fig.querySelector('[data-chk-v]');
    const why = fig.querySelector('[data-chk-why]');
    const steps = [...fig.querySelectorAll('[data-step]')];
    const log = [...fig.querySelectorAll('.chk-log li')];
    const STEP = 950;
    const HOLD = 3600;
    const FADE = 700;
    let n = 1;
    let timers = [];
    let running = false;
    const later = (fn, ms) => timers.push(setTimeout(fn, ms));
    const clear = () => {
      timers.forEach(clearTimeout);
      timers = [];
    };

    const pushLog = (it) => {
      for (let k = log.length - 1; k > 0; k--) {
        log[k].dataset.kind = log[k - 1].dataset.kind;
        log[k].innerHTML = log[k - 1].innerHTML;
      }
      log[0].dataset.kind = it.stop ? 'stop' : 'pass';
      log[0].querySelector('b').textContent = it.verdict;
      log[0].querySelector('span').textContent = it.why;
      log[0].classList.remove('is-in');
      void log[0].offsetWidth;
      log[0].classList.add('is-in');
    };

    const play = () => {
      if (!running) return;
      const it = items[n];
      body.dataset.fade = 'true';
      later(() => {
        src.textContent = it.src;
        text.textContent = it.text;
        steps.forEach((s) => (s.dataset.state = s.dataset.step === it.skip ? 'na' : 'idle'));
        verdict.dataset.show = 'false';
        body.dataset.fade = 'false';
        let t = FADE;
        let stopped = false;
        steps.forEach((s) => {
          if (stopped || s.dataset.step === it.skip) return;
          const hit = s.dataset.step === it.stop;
          later(() => (s.dataset.state = hit ? 'stop' : 'pass'), (t += STEP));
          if (hit) stopped = true;
        });
        later(() => {
          v.textContent = it.stop ? `${it.verdict} at ${it.stop}` : it.verdict;
          why.textContent = it.why;
          verdict.dataset.kind = it.stop ? 'stop' : 'pass';
          verdict.dataset.show = 'true';
        }, (t += STEP * 0.8));
        later(() => {
          pushLog(it);
          n = (n + 1) % items.length;
          play();
        }, t + HOLD);
      }, FADE);
    };

    new IntersectionObserver((e) => {
      const on = e[0].isIntersecting;
      if (on === running) return;
      running = on;
      clear();
      if (on) later(play, 2600);
    }).observe(fig);
  })();

  /* ── Play once: any [data-play] gets data-on when it is well in view.
     Reduced motion shows the finished state at once. ── */
  (() => {
    const els = [...document.querySelectorAll('[data-play]')];
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      els.forEach((el) => (el.dataset.on = 'true'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.dataset.on = 'true';
          io.unobserve(e.target);
        }),
      { threshold: 0.35 }
    );
    els.forEach((el) => io.observe(el));
  })();

  /* ── The control layer: requests travel from the sources, through the
     rails, to users and systems. Unsafe ones stop at the rail that
     catches them, flash, and name the reason. Runs only on screen. ── */
  (() => {
    const fig = document.querySelector('[data-cl]');
    if (!fig) return;
    const svg = fig.querySelector('svg');
    const wires = svg.querySelector('.cl-wires');
    const layer = svg.querySelector('.cl-packets');
    const counter = fig.querySelector('[data-cl-count]');
    const NS = 'http://www.w3.org/2000/svg';
    const SRC = [81, 171, 261];
    const RAIL = { input: 1, output: 4, action: 5 };
    const ROUTES = {
      reply: (sy) => [[150, sy], [232, sy], [318, 165], [618, 165], [698, 100], [930, 81]],
      crm: (sy) => [[150, sy], [232, sy], [318, 165], [618, 165], [698, 205], [818, 205], [930, 171]],
      signoff: (sy) => [[150, sy], [232, sy], [318, 165], [618, 165], [698, 218], [818, 232], [930, 261]],
    };
    const toD = (pts) =>
      pts.reduce((d, p, i) => {
        if (!i) return `M${p[0]} ${p[1]}`;
        const a = pts[i - 1];
        const mx = (a[0] + p[0]) / 2;
        return `${d} C${mx} ${a[1]}, ${mx} ${p[1]}, ${p[0]} ${p[1]}`;
      }, '');

    /* One wire per source and route, drawn faintly, reused as the path
       the packets follow. */
    const paths = {};
    try {
    SRC.forEach((sy, s) =>
      Object.keys(ROUTES).forEach((k) => {
        const pts = ROUTES[k](sy);
        const p = document.createElementNS(NS, 'path');
        p.setAttribute('d', toD(pts));
        wires.appendChild(p);
        const len = p.getTotalLength();
        /* Length along the path at each waypoint's x, for stopping. */
        const at = pts.map(([x]) => {
          let lo = 0;
          let hi = len;
          for (let n = 0; n < 22; n++) {
            const mid = (lo + hi) / 2;
            if (p.getPointAtLength(mid).x < x) lo = mid;
            else hi = mid;
          }
          return lo;
        });
        paths[s + k] = { p, len, at };
      })
    );
    } catch {
      return;
    }

    const KINDS = [
      { w: 6, s: 0, r: 'reply' },
      { w: 3, s: 2, r: 'crm' },
      { w: 2, s: 0, r: 'signoff' },
      { w: 2, s: 1, r: 'reply' },
      { w: 2, s: 0, r: 'reply', stop: 'input', why: 'prompt injection' },
      { w: 1, s: 0, r: 'reply', stop: 'input', why: 'jailbreak framing' },
      { w: 2, s: 1, r: 'reply', stop: 'input', why: 'hidden instruction' },
      { w: 2, s: 0, r: 'reply', stop: 'output', why: 'off-policy answer' },
      { w: 1, s: 1, r: 'reply', stop: 'output', why: 'ungrounded claim' },
      { w: 1, s: 0, r: 'reply', stop: 'output', why: 'personal data' },
      { w: 2, s: 2, r: 'crm', stop: 'action', why: 'outside role' },
      { w: 1, s: 0, r: 'signoff', stop: 'action', why: 'over limit' },
    ];
    const total = KINDS.reduce((a, k) => a + k.w, 0);
    const pick = () => {
      let x = Math.random() * total;
      for (const k of KINDS) if ((x -= k.w) < 0) return k;
      return KINDS[0];
    };

    const SPEED = 230;
    let live = [];
    let stopped = 0;
    let lastSpawn = 0;
    let last = 0;
    let raf = 0;
    let running = false;

    const spawn = () => {
      const k = pick();
      const path = paths[k.s + k.r];
      const c = document.createElementNS(NS, 'circle');
      c.setAttribute('r', '4.2');
      c.setAttribute('class', 'pk');
      layer.appendChild(c);
      live.push({ k, path, c, d: 0, end: k.stop ? path.at[RAIL[k.stop]] : path.len, hold: 0 });
    };
    const flag = (x, y, text) => {
      const t = document.createElementNS(NS, 'text');
      t.setAttribute('x', x);
      t.setAttribute('y', y - 14);
      t.setAttribute('class', 'pk-why');
      t.textContent = text;
      layer.appendChild(t);
      setTimeout(() => t.remove(), 1600);
    };

    const frame = (now) => {
      raf = 0;
      if (!running) return;
      const dt = Math.min(0.05, (now - last) / 1000 || 0);
      last = now;
      if (now - lastSpawn > 620) {
        lastSpawn = now;
        spawn();
      }
      live = live.filter((pk) => {
        if (pk.hold) {
          pk.hold -= dt;
          if (pk.hold <= 0) {
            pk.c.remove();
            return false;
          }
          return true;
        }
        pk.d = Math.min(pk.end, pk.d + SPEED * dt);
        const pt = pk.path.p.getPointAtLength(pk.d);
        pk.c.setAttribute('cx', pt.x.toFixed(1));
        pk.c.setAttribute('cy', pt.y.toFixed(1));
        if (pk.d >= pk.end) {
          if (pk.k.stop) {
            pk.c.setAttribute('class', 'pk pk-stop');
            pk.hold = 0.9;
            flag(pt.x, pt.y, pk.k.why);
            counter.textContent = String(++stopped);
            return true;
          }
          pk.c.setAttribute('class', 'pk pk-done');
          pk.hold = 0.4;
          return true;
        }
        return true;
      });
      raf = requestAnimationFrame(frame);
    };

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    new IntersectionObserver(
      (e) => {
        running = e[0].isIntersecting;
        if (running && !raf) {
          last = performance.now();
          raf = requestAnimationFrame(frame);
        }
      },
      { threshold: 0.15 }
    ).observe(fig);
  })();

  /* ── Compliance map: a curve from each framework to each artifact
     that answers it. The highlight walks through the frameworks on
     its own; hovering one holds it there. ── */
  (() => {
    const root = document.querySelector('[data-map]');
    if (!root) return;
    const svg = root.querySelector('.map-lines');
    const fs = [...root.querySelectorAll('[data-f]')];
    const as = [...root.querySelectorAll('[data-a]')];
    const NS = 'http://www.w3.org/2000/svg';
    let links = [];
    /* Offsets relative to the map, summed up the chain, so the reveal
       transforms and the virtual scroll never skew them. */
    const off = (el) => {
      let x = 0;
      let y = 0;
      let n = el;
      while (n && n !== root) {
        x += n.offsetLeft;
        y += n.offsetTop;
        n = n.offsetParent;
      }
      return { x, y };
    };
    const build = () => {
      svg.replaceChildren();
      links = [];
      if (getComputedStyle(svg).display === 'none') return;
      svg.setAttribute('viewBox', `0 0 ${root.offsetWidth} ${root.offsetHeight}`);
      fs.forEach((f, i) => {
        const fo = off(f);
        const x1 = fo.x + f.offsetWidth;
        const y1 = fo.y + 22;
        f.dataset.to.split(',').forEach((j) => {
          const a = as[Number(j)];
          const ao = off(a);
          const x2 = ao.x;
          const y2 = ao.y + a.offsetHeight / 2;
          const mx = (x1 + x2) / 2;
          const p = document.createElementNS(NS, 'path');
          p.setAttribute('d', `M${x1} ${y1} C${mx} ${y1}, ${mx} ${y2}, ${x2} ${y2}`);
          p.setAttribute('pathLength', '1');
          svg.appendChild(p);
          links.push({ i, j: Number(j), p });
        });
      });
      paint();
    };
    let active = 0;
    let held = false;
    const paint = () => {
      fs.forEach((f, i) => f.classList.toggle('is-on', i === active));
      const on = new Set(fs[active].dataset.to.split(',').map(Number));
      as.forEach((a, j) => a.classList.toggle('is-on', on.has(j)));
      links.forEach((l) => l.p.classList.toggle('is-on', l.i === active));
    };
    fs.forEach((f, i) => {
      f.addEventListener('pointerenter', () => {
        held = true;
        active = i;
        paint();
      });
      f.addEventListener('pointerleave', () => (held = false));
    });
    let t;
    const rebuild = () => {
      clearTimeout(t);
      t = setTimeout(build, 80);
    };
    if ('ResizeObserver' in window) new ResizeObserver(rebuild).observe(root);
    else window.addEventListener('resize', rebuild);
    build();

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let timer = 0;
    new IntersectionObserver(
      (e) => {
        clearInterval(timer);
        if (!e[0].isIntersecting) return;
        root.dataset.on = 'true';
        timer = setInterval(() => {
          if (held) return;
          active = (active + 1) % fs.length;
          paint();
        }, 2400);
      },
      { threshold: 0.3 }
    ).observe(root);
  })();

  /* ── Counters: count up once, with decimals where the figure has them. ── */
  (() => {
    const groups = [...document.querySelectorAll('[data-counts]')];
    if (!groups.length || !('IntersectionObserver' in window)) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const run = (n) => {
      const to = Number(n.dataset.count);
      const dec = Number(n.dataset.dec) || 0;
      const t0 = performance.now();
      const tick = (t) => {
        const k = Math.min(1, (t - t0) / 1400);
        n.textContent = (to * (1 - Math.pow(1 - k, 4))).toFixed(dec) + n.dataset.suffix;
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.querySelectorAll('[data-count]').forEach(run);
          io.unobserve(e.target);
        });
      },
      { threshold: 0.4 }
    );
    groups.forEach((g) => {
      g.querySelectorAll('[data-count]').forEach((n) => (n.textContent = (0).toFixed(Number(n.dataset.dec) || 0) + n.dataset.suffix));
      io.observe(g);
    });
  })();
</script>

<style>
  /* ── Page tokens ── */
