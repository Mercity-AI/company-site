  .strip-band {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.15fr);
    border-left: 1px solid var(--line);
  }
  .strip-cell {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 30px 24px 28px;
    border-right: 1px solid var(--line);
  }
  .strip-fig {
    display: block;
    font-family: var(--hero-serif);
    font-size: clamp(34px, 3.6vw, 46px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--teal-700);
    font-variant-numeric: tabular-nums;
  }
  .strip-label {
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--ink);
  }
  .strip-label span {
    display: block;
    margin-top: 5px;
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 400;
    color: var(--n-400);
  }
  .strip-link {
    flex-direction: row;
    align-items: center;
    gap: 16px;
    background: var(--n-50);
    transition: background 400ms var(--ease);
  }
  .strip-link:hover {
    background: var(--teal-100);
  }
  .strip-icon {
    flex: none;
    width: 38px;
    height: 38px;
    padding: 8px;
    color: var(--teal-700);
    border: 1px solid hsl(178 38% 80%);
    background: var(--surface);
  }
  .strip-link > span:last-child {
    font-family: var(--hero-serif);
    font-size: 17.1px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .strip-link b {
    display: block;
    margin-top: 6px;
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--indigo-600);
  }
  @media (max-width: 900px) {
    .strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .strip-link {
      grid-column: 1 / -1;
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 560px) {
    .strip {
      grid-template-columns: minmax(0, 1fr);
    }
    .strip-cell + .strip-cell {
      border-top: 1px solid var(--line);
    }
  }

  /* ══ WASH: the design lab's "Blur field" as a pale warm ground behind
     a section, the light counterpart of the control layer's grEmber.
     Drawn once at low resolution; content stacks above it. */
  .wash {
    position: relative;
    overflow: hidden;
  }
  .wash-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .wash > :not(.wash-bg) {
    position: relative;
    z-index: 1;
  }
  .wash .lede {
    color: var(--ink-2);
  }

  /* ══ THE CHAIN ═══════════════════════════════════════════════
     Four links light in turn along a rail; then the guardrail drops
     between the first and second, and everything after it goes quiet. */
  /* A shorter band than the rest: tighter padding, the heading set
     high to leave the guardrail tag room, and a slightly smaller chain. */
  #stakes {
    padding-top: clamp(22px, 2vw, 27px);
    padding-bottom: clamp(38px, 3.4vw, 45px);
  }
  .chain {
    position: relative;
    margin-top: 64px;
    --step: 160ms;
  }
  .chain-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 clamp(28px, 4vw, 56px);
  }
  .chain-line {
    position: absolute;
    left: 21px;
    right: 0;
    top: 21px;
    height: 1px;
    background: var(--line-2);
  }
  .chain-line span {
    position: absolute;
    inset: 0;
    background: var(--coral);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1600ms var(--ease) 100ms;
  }
  .chain[data-on='true'] .chain-line span {
    transform: scaleX(1);
  }
  .chain-step {
    position: relative;
  }
  .chain-step > :is(h3, p),
  .chain-icon svg {
    transition: opacity 700ms var(--ease) calc(2200ms + var(--i) * 80ms);
  }
  .chain-icon {
    position: relative;
    display: block;
    width: 42px;
    height: 42px;
    padding: 10px;
    color: var(--n-400);
    background: var(--surface);
    border: 1px solid var(--line-2);
    transition:
      color 500ms var(--ease) calc(var(--i) * 380ms + 200ms),
      border-color 500ms var(--ease) calc(var(--i) * 380ms + 200ms);
  }
  .chain[data-on='true'] .chain-icon {
    color: var(--coral-700);
    border-color: var(--coral);
    background: var(--coral-100);
  }
  .chain-step h3 {
    margin-top: 17px;
    font-family: var(--hero-serif);
    font-size: 20.8px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.014em;
  }
  .chain-step p {
    margin-top: 6.5px;
    max-width: 30ch;
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--ink-3);
    text-wrap: pretty;
  }
  /* After the cut, the downstream links recede. The icon box fades by
     colour, not opacity, so it stays solid and the rail never shows
     through it. */
  .chain[data-on='true'] .chain-step:not(:first-child) > :is(h3, p),
  .chain[data-on='true'] .chain-step:not(:first-child) .chain-icon svg {
    opacity: 0.5;
  }
  .chain[data-on='true'] .chain-step:not(:first-child) .chain-icon {
    border-color: color-mix(in srgb, var(--coral) 50%, transparent);
    background: color-mix(in srgb, var(--coral-100) 50%, var(--surface));
  }
  .chain-cut {
    position: absolute;
    top: -11px;
    bottom: -11px;
    /* Between the first and second column. */
    left: calc((100% - 3 * clamp(28px, 4vw, 56px)) / 4 + clamp(28px, 4vw, 56px) / 2);
    width: 0;
    z-index: 1;
    pointer-events: none;
  }
  .chain-cut-bar {
    position: absolute;
    left: -2px;
    top: 0;
    width: 4px;
    height: 100%;
    background: var(--teal-500);
    box-shadow: 0 0 0 5px hsl(178 62% 42% / 0.14);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 700ms var(--ease) 1900ms;
  }
  .chain-cut-label {
    position: absolute;
    top: -6px;
    left: 0;
    transform: translate(-50%, -100%);
    padding: 4px 9px;
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #fff;
    background: var(--teal-700);
    opacity: 0;
    transition: opacity 500ms var(--ease) 2400ms;
  }
  .chain[data-on='true'] .chain-cut-bar {
    transform: scaleY(1);
  }
  .chain[data-on='true'] .chain-cut-label {
    opacity: 1;
  }
  @media (max-width: 860px) {
    .chain-steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
      padding-left: 64px;
    }
    .chain-line {
      left: 21px;
      right: auto;
      top: 0;
      bottom: 0;
      width: 1px;
      height: auto;
    }
    .chain-line span {
      transform: scaleY(0);
      transform-origin: top;
    }
    .chain[data-on='true'] .chain-line span {
      transform: scaleY(1);
    }
    .chain-icon {
      position: absolute;
      left: -64px;
      top: 0;
    }
    .chain-step h3 {
      margin-top: 8px;
    }
    .chain-cut {
      display: none;
    }
    .chain[data-on='true'] .chain-step:not(:first-child) > :is(h3, p),
    .chain[data-on='true'] .chain-step:not(:first-child) .chain-icon svg {
      opacity: 1;
    }
    .chain[data-on='true'] .chain-step:not(:first-child) .chain-icon {
      border-color: var(--coral);
      background: var(--coral-100);
    }
  }

  /* ══ WHO ═════════════════════════════════════════════════════ */
  .touches {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 44px;
    border: 1px solid var(--line-2);
    background: var(--surface);
  }
  .touch {
    position: relative;
    padding: 26px 24px 28px;
    border-right: 1px solid var(--line);
  }
  .touch:last-child {
    border-right: 0;
  }
  .touch-icon {
    display: block;
    width: 34px;
    height: 34px;
    color: var(--coral);
  }
  .touch h3 {
    margin-top: 20px;
    font-family: var(--hero-serif);
    font-size: 21.6px;
    font-weight: 400;
    letter-spacing: -0.014em;
  }
  .touch p {
    margin-top: 6px;
    font-size: 13.05px;
    line-height: 1.6;
    color: var(--ink-3);
  }
  /* A small gate on each cell's top edge: the guardrail sits on
     whatever the AI touches. */
  .touch-gate {
    position: absolute;
    top: -1px;
    left: 24px;
    width: 34px;
    height: 3px;
    background: var(--teal-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 700ms var(--ease) 500ms;
  }
  .touch.rv[data-visible='true'] .touch-gate {
    transform: scaleX(1);
  }
  .sub-h {
    margin-top: 56px;
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .buyers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 18px;
  }
  .buyer {
    display: flex;
    gap: 18px;
    padding: 22px 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    transition:
      border-color 500ms var(--ease),
      transform 500ms var(--ease);
  }
  .buyer:hover {
    border-color: var(--coral-200);
    transform: translateY(-1.5px);
  }
  .buyer-icon {
    flex: none;
    width: 42px;
    height: 42px;
    padding: 9px;
    color: var(--coral-700);
    background: var(--coral-100);
  }
  .buyer h4 {
    font-family: var(--hero-serif);
    font-size: 19.8px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.012em;
  }
  .buyer p {
    margin-top: 6px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--ink-3);
    text-wrap: pretty;
  }
  .buyer-chip {
    display: inline-block;
    margin-top: 12px;
    padding: 3px 9px;
    font-family: var(--mono);
    font-size: 9.9px;
    letter-spacing: 0.06em;
    color: var(--coral-700);
    border: 1px solid var(--coral-200);
  }
  @media (max-width: 900px) {
    .touches {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .touch:nth-child(2) {
      border-right: 0;
    }
    .touch:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }
    .buyers {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 480px) {
    .touches {
      grid-template-columns: minmax(0, 1fr);
    }
    .touch {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .touch:last-child {
      border-bottom: 0;
    }
  }

  /* ══ EVIDENCE ════════════════════════════════════════════════ */
  .ev {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(28px, 4vw, 56px);
    margin-top: 46px;
    align-items: start;
  }
  /* Dumbbell: the hollow ring is the system-prompt rate, the teal dot
     slides left to the trained rate when the chart comes into view. */
  .db {
    margin: 0;
    padding: 24px 24px 20px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .db-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: 12.6px;
    color: var(--ink-2);
  }
  .db-legend span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .db-legend i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .k-u {
    border: 1.6px solid var(--issue);
  }
  .k-t {
    background: var(--teal-500);
  }
  .db-axis {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr) 84px;
    margin-top: 20px;
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--n-400);
  }
  .db-axis > span {
    align-self: end;
    padding-right: 10px;
    line-height: 1.4;
  }
  .db-ticks {
    display: flex;
    justify-content: space-between;
    align-self: end;
  }
  .db-ticks i {
    font-style: normal;
    width: 0;
    display: flex;
    justify-content: center;
    white-space: nowrap;
  }
  .db-rows {
    margin-top: 8px;
  }
  .db-row {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr) 84px;
    align-items: center;
    min-height: 34px;
    border-top: 1px solid var(--line);
  }
  .db-name {
    display: flex;
    gap: 9px;
    padding-right: 10px;
    font-size: 12.6px;
    color: var(--ink-2);
  }
  .db-track {
    position: relative;
    height: 34px;
  }
  .db-grid {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px 25%);
    opacity: 0.8;
  }
  .db-bar {
    position: absolute;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    left: calc(var(--t) * 1%);
    right: calc(100% - var(--u) * 1%);
    background: var(--teal-500);
    opacity: 0.4;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 1100ms var(--ease) calc(300ms + var(--i) * 90ms);
  }
  .db-dot {
    position: absolute;
    top: 50%;
    width: 11px;
    height: 11px;
    margin: -5.5px 0 0 -5.5px;
    border-radius: 50%;
  }
  .db-u {
    left: calc(var(--u) * 1%);
    background: var(--surface);
    border: 1.6px solid var(--issue);
  }
  .db-t {
    left: calc(var(--u) * 1%);
    background: var(--teal-500);
    box-shadow: 0 0 0 3px var(--surface);
    transition: left 1100ms var(--ease) calc(300ms + var(--i) * 90ms);
  }
  [data-on='true'] .db-t {
    left: calc(var(--t) * 1%);
  }
  [data-on='true'] .db-bar {
    transform: scaleX(1);
  }
  .db-val {
    padding-left: 12px;
    font-family: var(--mono);
    font-size: 10.35px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .db-val b {
    font-weight: 500;
    color: var(--teal-700);
  }
  .db-total {
    border-top: 1px solid var(--ink-2);
  }
  .db-total .db-name {
    font-weight: 500;
    color: var(--ink);
  }
  .db-total .db-t {
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
  }
  .db figcaption {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 10.35px;
    line-height: 1.65;
    color: var(--ink-3);
  }
  .db figcaption span {
    display: block;
    text-wrap: pretty;
  }
  @media (max-width: 560px) {
    .db-axis,
    .db-row {
      grid-template-columns: 112px minmax(0, 1fr) 72px;
    }
    .db-axis > span {
      font-size: 0;
    }
  }

  /* The same question, two answers. */
  .convo {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .convo-q {
    padding: 18px 20px;
    font-family: var(--hero-serif);
    font-size: 17.1px;
    line-height: 1.45;
    letter-spacing: -0.008em;
    background: var(--n-100);
    border: 1px solid var(--line);
  }
  .convo-q span,
  .convo-who {
    display: block;
    margin-bottom: 8px;
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .convo-a {
    padding: 16px 20px 16px 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left-width: 3px;
  }
  .convo-bad {
    border-left-color: var(--issue);
  }
  .convo-good {
    border-left-color: var(--teal-500);
  }
  .convo-a p {
    font-size: 13.05px;
    line-height: 1.65;
    color: var(--ink-2);
  }
  .convo-a mark {
    padding: 0 2px;
    color: var(--ink);
  }
  .convo-bad mark {
    background: var(--issue-100);
    box-shadow: inset 0 -1.5px 0 var(--issue);
  }
  .convo-bad .convo-tag {
    color: var(--issue);
  }
  .convo-good mark {
    background: var(--teal-100);
    box-shadow: inset 0 -1.5px 0 var(--teal-500);
  }
  .convo-tag {
    display: block;
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 10.35px;
    color: var(--ink-2);
  }
  .convo-good .convo-who,
  .convo-good .convo-tag {
    color: var(--teal-700);
  }
  @media (max-width: 960px) {
    .ev {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.4fr);
    margin: 28px 0 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .facts > div {
    padding: 18px 20px 18px 0;
  }
  .facts > div + div {
    padding-left: 20px;
    border-left: 1px solid var(--line);
  }
  .facts dt {
    font-family: var(--hero-serif);
    font-size: 24.3px;
    letter-spacing: -0.016em;
    color: var(--teal-700);
  }
  .facts dd {
    margin: 6px 0 0;
    font-family: var(--mono);
    font-size: 10.35px;
    line-height: 1.55;
    color: var(--ink-3);
  }
  /* The fourth cell links out to the research log: white, on a pale
     teal blur field, with a barely-there edge. */
  .facts > .facts-go {
    position: relative;
    margin: 10px 0;
    padding: 0;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid hsl(178 30% 30% / 0.06);
    transition: border-color 400ms var(--ease);
  }
  .facts > .facts-go:hover {
    border-color: hsl(178 40% 35% / 0.18);
  }
  .facts-go-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .facts-go a {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    padding: 14px 22px;
    text-wrap: balance;
    font-family: var(--hero-serif);
    font-size: 17.1px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .facts-go b {
    margin-top: 8px;
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--indigo-600);
  }
  .facts-go b span {
    display: inline-block;
    transition: transform 400ms var(--ease);
  }
  .facts-go a:hover b span {
    transform: translate(2px, -2px);
  }
  @media (max-width: 760px) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .facts > div:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .facts > .facts-go {
      grid-column: 1 / -1;
      margin: 0 0 14px;
    }
    .facts > div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  /* 13% less space above the heading than the other bands. */
  #build {
    padding-top: clamp(50.3px, 5.99vw, 79.07px);
  }
  .pub {
    margin-top: 72px;
    padding-top: 44px;
    border-top: 1px solid var(--line);
  }
  .pub-h {
    max-width: 36ch;
    font-family: var(--hero-serif);
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.25;
    letter-spacing: -0.014em;
    color: var(--ink);
  }
  .pub-h span {
    display: block;
  }
  .papers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 36px;
  }
  @media (max-width: 900px) {
    .papers {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ══ CONTROL LAYER (dark) ════════════════════════════════════ */
  .dark {
    color: #fff;
    border-top-color: var(--deep-950);
  }
  /* The ground is `grEmber`, the design lab's blur field in dark warm
     tones, drawn once. The gradient shows until it is drawn. */
  .dark {
    position: relative;
    overflow: hidden;
    background: radial-gradient(70% 90% at 70% 40%, hsl(14 40% 20%), hsl(12 35% 9%));
  }
  .hearth-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .dark > :not(.hearth-bg) {
    position: relative;
    z-index: 1;
  }
  .dark .lede {
    color: hsl(0 0% 100% / 0.7);
  }
  .cl {
    margin: 44px 0 0;
    padding: 22px 24px 26px;
    background: hsl(12 30% 6% / 0.45);
    border: 1px solid hsl(24 60% 80% / 0.14);
  }
  .cl-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
    margin-bottom: 18px;
    font-family: var(--mono);
    font-size: 9.9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: hsl(0 0% 100% / 0.6);
  }
  .cl-legend span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .cl-legend i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .k-pass {
    background: var(--pass);
  }
  .k-stop {
    background: var(--stop);
  }
  .cl-count {
    margin-left: auto;
  }
  .cl-count b {
    font-weight: 500;
    color: var(--stop);
    font-variant-numeric: tabular-nums;
  }
  .cl svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--mono);
  }
  .cl svg :global(.cl-wires path) {
    fill: none;
    stroke: hsl(0 0% 100% / 0.1);
    stroke-width: 1;
  }
  .cl-feed path {
    fill: none;
    stroke: hsl(32 88% 76% / 0.35);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }
  .cl-box rect {
    fill: hsl(0 0% 100% / 0.05);
    stroke: hsl(0 0% 100% / 0.26);
  }
  .cl-box text {
    font-size: 12px;
    fill: hsl(0 0% 100% / 0.88);
  }
  .cl-rail rect {
    fill: hsl(178 60% 45% / 0.16);
    stroke: hsl(178 60% 55% / 0.7);
  }
  .cl-rail text {
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-anchor: middle;
    fill: var(--on-dark);
  }
  .cl-model > rect:first-child {
    fill: hsl(10 60% 40% / 0.2);
    stroke: hsl(22 85% 78% / 0.45);
  }
  .cl-model-t {
    font-family: var(--hero-serif);
    font-size: 22px;
    fill: #fff;
  }
  .cl-model-s {
    font-size: 10.5px;
    fill: hsl(0 0% 100% / 0.55);
  }
  .cl-bus {
    fill: none;
    stroke: hsl(0 0% 100% / 0.22);
    stroke-dasharray: 2 5;
  }
  .cl-chip {
    fill: hsl(12 70% 55% / 0.2);
    stroke: hsl(22 85% 78% / 0.55);
  }
  .cl-chip-t {
    font-size: 11.5px;
    fill: #fff;
  }
  .cl-chip-s {
    font-size: 10px;
    fill: hsl(0 0% 100% / 0.55);
  }
  .cl-strip rect {
    fill: hsl(32 80% 60% / 0.08);
    stroke: hsl(32 88% 76% / 0.35);
    stroke-dasharray: 3 4;
  }
  .cl-strip text {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-anchor: middle;
    fill: var(--on-dark);
  }
  .cl svg :global(.pk) {
    fill: var(--pass);
    transition:
      fill 200ms,
      opacity 400ms;
  }
  .cl svg :global(.pk-stop) {
    fill: var(--stop);
    filter: drop-shadow(0 0 6px hsl(40 96% 62% / 0.9));
  }
  .cl svg :global(.pk-done) {
    opacity: 0;
  }
  .cl svg :global(.pk-why) {
    font-size: 10.5px;
    text-anchor: middle;
    fill: var(--stop);
    paint-order: stroke;
    stroke: var(--deep-950);
    stroke-width: 4px;
    animation: why 1600ms var(--ease) both;
  }
  @keyframes why {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    20%,
    70% {
      opacity: 1;
      transform: none;
    }
    to {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .cl-cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin-top: 28px;
    border-top: 1px solid hsl(0 0% 100% / 0.14);
  }
  .cl-col {
    padding: 22px 22px 0 0;
  }
  .cl-col + .cl-col {
    padding-left: 22px;
    border-left: 1px solid hsl(0 0% 100% / 0.1);
  }
  .cl-col h3 {
    font-family: var(--mono);
    font-size: 10.35px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark);
  }
  .cl-col li {
    position: relative;
    margin-top: 10px;
    padding-left: 16px;
    font-size: 13.5px;
    line-height: 1.55;
    color: hsl(0 0% 100% / 0.82);
  }
  .cl-col li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border: 1px solid var(--on-dark);
    transform: rotate(45deg);
  }
  @media (max-width: 760px) {
    .cl {
      display: none;
    }
    .cl-cols {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 36px;
    }
    .cl-col,
    .cl-col + .cl-col {
      padding: 18px 0;
      border-left: 0;
      border-bottom: 1px solid hsl(0 0% 100% / 0.1);
    }
  }
  @media (min-width: 761px) and (max-width: 1000px) {
    .cl-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cl-col:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .cl-col {
      padding-bottom: 22px;
    }
  }

  /* ══ COMPLIANCE MAP ══════════════════════════════════════════ */
  .map {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
    gap: 0 clamp(80px, 14vw, 200px);
    margin-top: 48px;
  }
  .map-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .map-lines :global(path) {
    fill: none;
    stroke: var(--n-300);
    stroke-width: 1;
    opacity: 0.55;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition:
      stroke-dashoffset 1200ms var(--ease),
      stroke 400ms var(--ease),
      opacity 400ms var(--ease);
  }
  .map[data-on='true'] .map-lines :global(path) {
    stroke-dashoffset: 0;
  }
  .map-lines :global(path.is-on) {
    stroke: var(--teal-500);
    stroke-width: 2;
    opacity: 1;
  }
  .map-col {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .map-h {
    margin-bottom: 6px;
    font-family: var(--mono);
    font-size: 9.9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .map-f {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 4px 16px;
    align-items: baseline;
    padding: 12px 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    cursor: default;
    transition:
      border-color 400ms var(--ease),
      box-shadow 400ms var(--ease);
  }
  .map-f b {
    font-family: var(--hero-serif);
    font-size: 18px;
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .map-f > span {
    font-size: 12.6px;
    line-height: 1.5;
    color: var(--ink-3);
  }
  .map-f.is-on {
    border-color: var(--teal-500);
    box-shadow: inset 3px 0 0 var(--teal-500);
  }
  .map-chips {
    display: none;
  }
  .map-right {
    justify-content: flex-start;
  }
  .map-a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 47px;
    padding: 10px 16px;
    font-size: 13.5px;
    color: var(--ink-2);
    background: var(--surface);
    border: 1px solid var(--line);
    transition:
      border-color 400ms var(--ease),
      color 400ms var(--ease),
      background 400ms var(--ease);
  }
  .map-a svg {
    flex: none;
    width: 14px;
    height: 14px;
    color: var(--n-300);
    transition: color 400ms var(--ease);
  }
  .map-a.is-on {
    color: var(--ink);
    border-color: var(--teal-500);
    background: var(--teal-100);
  }
  .map-a.is-on svg {
    color: var(--teal-700);
  }
  @media (max-width: 860px) {
    .map {
      grid-template-columns: minmax(0, 1fr);
    }
    .map-lines,
    .map-right {
      display: none;
    }
    .map-f {
      grid-template-columns: minmax(0, 1fr);
    }
    .map-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 8px;
    }
    .map-chips i {
      padding: 2px 8px;
      font-family: var(--mono);
      font-size: 9.9px;
      font-style: normal;
      color: var(--teal-800);
      background: var(--teal-100);
    }
  }

  /* ══ IN-HOUSE vs WITH US ═════════════════════════════════════
     Sixteen time columns, no units: the point is the shape. */
  .lanes {
    margin: 46px 0 0;
    padding: 24px 24px 16px;
    background: var(--n-50);
    border: 1px solid var(--line);
  }
  .lane {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding-block: 18px;
  }
  .lane + .lane {
    border-top: 1px dashed var(--line-2);
  }
  .lane-name {
    font-family: var(--hero-serif);
    font-size: 18px;
    letter-spacing: -0.01em;
  }
  .lane-us .lane-name {
    color: var(--teal-700);
  }
  .lane-track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(16, minmax(0, 1fr));
    min-height: 44px;
    align-items: center;
  }
  .seg {
    grid-row: 1;
    grid-column: var(--s) / var(--e);
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    margin-right: 3px;
    padding: 6px 10px;
    overflow: hidden;
    font-size: 12.15px;
    line-height: 1.3;
    color: var(--ink-2);
    background: var(--n-200);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 800ms var(--ease) calc(var(--i) * 420ms + 150ms);
  }
  .seg b {
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    white-space: nowrap;
  }
  .lanes[data-on='true'] .seg {
    clip-path: inset(0 0 0 0);
  }
  .seg-hatch {
    background: repeating-linear-gradient(135deg, var(--n-200) 0 6px, var(--n-100) 6px 12px);
  }
  .seg-dash {
    background: transparent;
    border: 1px dashed var(--n-400);
    color: var(--ink-3);
  }
  .seg-fade {
    background: linear-gradient(90deg, var(--n-200), transparent);
    color: var(--ink-3);
  }
  .seg-us {
    color: #fff;
    background: var(--teal-700);
  }
  .seg-live {
    flex-wrap: wrap;
    gap: 2px 10px;
    color: var(--teal-800);
    background: var(--teal-100);
    box-shadow: inset 3px 0 0 var(--teal-500);
  }
  .seg-live b {
    font-weight: 400;
    color: var(--teal-700);
  }
  .flag {
    grid-row: 1;
    grid-column: var(--s);
    position: relative;
    z-index: 2;
    align-self: start;
    transform: translate(-6px, -24px);
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--amber-800);
    opacity: 0;
    transition: opacity 500ms var(--ease) 1100ms;
  }
  .flag::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 14px;
    width: 1px;
    height: 36px;
    background: var(--amber-500);
  }
  .lanes[data-on='true'] .flag {
    opacity: 1;
  }
  .brace {
    grid-row: 1;
    grid-column: var(--s) / var(--e);
    align-self: end;
    transform: translateY(24px);
    margin-right: 3px;
    padding-top: 5px;
    border-top: 1px solid var(--teal-500);
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    color: var(--teal-700);
    opacity: 0;
    transition: opacity 500ms var(--ease) 1300ms;
  }
  .lanes[data-on='true'] .brace {
    opacity: 1;
  }
  .lane-us {
    padding-bottom: 34px;
  }
  .lanes-axis {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 16px;
    padding-top: 10px;
    border-top: 1px solid var(--line-2);
  }
  .lanes-axis span {
    grid-column: 2;
    font-family: var(--mono);
    font-size: 9.9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--n-400);
  }
  .lanes-axis span::after {
    content: ' →';
  }
  @media (max-width: 820px) {
    .lane,
    .lanes-axis {
      grid-template-columns: minmax(0, 1fr);
    }
    .lanes-axis span {
      grid-column: 1;
    }
    .lane-track {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
    .seg,
    .brace,
    .flag {
      grid-row: auto;
      grid-column: 1;
      transform: none;
    }
    .flag::before {
      display: none;
    }
    .lane-us {
      padding-bottom: 18px;
    }
  }

  .diy {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    margin-top: 40px;
    border-top: 1px solid var(--line);
  }
  .diy-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 18px 0 0;
  }
  .diy-item + .diy-item {
    padding-left: 18px;
    border-left: 1px solid var(--line);
  }
  .diy-icon {
    width: 28px;
    height: 28px;
    margin-bottom: 8px;
    color: var(--ink-3);
  }
  .diy-item b {
    font-family: var(--hero-serif);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .diy-item > span:last-child {
    font-size: 12.6px;
    line-height: 1.6;
    color: var(--ink-3);
    text-wrap: pretty;
  }
  .pull {
    margin-top: 52px;
    max-width: 30ch;
    font-family: var(--hero-serif);
    font-size: clamp(24px, 2.8vw, 34px);
    font-style: italic;
    line-height: 1.25;
    letter-spacing: -0.018em;
    color: var(--teal-800);
    text-wrap: balance;
  }
  @media (max-width: 1000px) {
    .diy {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .diy-item,
    .diy-item + .diy-item {
      padding: 20px 18px 20px 0;
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }
  }
  @media (max-width: 520px) {
    .diy {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ══ ENGAGEMENT FLOW ═════════════════════════════════════════
     Five stops on one line. The line fills coral left to right on
     view, each stop lights as it arrives, and a dashed loop under the
     last two says the work repeats. */
  .flow {
    position: relative;
    margin-top: 52px;
  }
  .flow-span {
    display: block;
    margin: 0 0 26px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--coral-200);
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--coral-700);
  }
  .flow-steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 18px;
  }
  /* The line runs through the node centres. */
  .flow-steps::before,
  .flow-steps::after {
    content: '';
    position: absolute;
    left: 28px;
    right: calc(20% - 28px);
    top: 28px;
    height: 2px;
    background: var(--line-2);
  }
  .flow-steps::after {
    background: var(--coral);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 2400ms var(--ease) 200ms;
  }
  .flow[data-on='true'] .flow-steps::after {
    transform: scaleX(1);
  }
  .flow-step {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .flow-node {
    width: 58px;
    height: 58px;
    padding: 15px;
    color: var(--n-400);
    background: var(--surface);
    border: 1.5px solid var(--line-2);
    transition:
      color 500ms var(--ease) calc(var(--i) * 480ms + 300ms),
      background 500ms var(--ease) calc(var(--i) * 480ms + 300ms),
      border-color 500ms var(--ease) calc(var(--i) * 480ms + 300ms);
  }
  .flow-node svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .flow[data-on='true'] .flow-node {
    color: #fff;
    background: var(--coral);
    border-color: var(--coral);
  }
  .flow-step b {
    margin-top: 18px;
    font-family: var(--hero-serif);
    font-size: 22.5px;
    font-weight: 400;
    letter-spacing: -0.014em;
  }
  .flow-line {
    margin-top: 4px;
    font-size: 13.5px;
    color: var(--ink-3);
  }
  .flow-out {
    margin-top: 14px;
    padding: 4px 10px;
    font-family: var(--mono);
    font-size: 10.35px;
    color: var(--teal-800);
    background: var(--teal-100);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 500ms var(--ease) calc(var(--i) * 480ms + 600ms),
      transform 500ms var(--ease) calc(var(--i) * 480ms + 600ms);
  }
  .flow[data-on='true'] .flow-out {
    opacity: 1;
    transform: none;
  }
  /* The loop: from Ship back to Attack, under the last two columns. */
  .flow-loop {
    position: relative;
    margin: 22px 0 0 calc(60% + 18px * 0.6 + 28px);
    width: calc(20% + 18px * 0.2);
    height: 34px;
    border: 1.5px dashed var(--coral);
    border-top: 0;
    opacity: 0;
    transition: opacity 600ms var(--ease) 2600ms;
  }
  .flow-loop::before {
    content: '';
    position: absolute;
    left: -5.5px;
    top: -2px;
    width: 8px;
    height: 8px;
    border-top: 1.5px solid var(--coral);
    border-left: 1.5px solid var(--coral);
    transform: rotate(45deg);
  }
  .flow-loop span {
    position: absolute;
    left: 50%;
    bottom: -24px;
    transform: translateX(-50%);
    font-family: var(--mono);
    font-size: 9.9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--coral-700);
  }
  .flow[data-on='true'] .flow-loop {
    opacity: 1;
  }
  @media (max-width: 860px) {
    .flow-span {
      width: 100%;
    }
    .flow-steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
    }
    .flow-steps::before,
    .flow-steps::after {
      left: 28px;
      right: auto;
      top: 28px;
      bottom: 28px;
      width: 2px;
      height: auto;
    }
    .flow-steps::after {
      transform: scaleY(0);
      transform-origin: top;
    }
    .flow[data-on='true'] .flow-steps::after {
      transform: scaleY(1);
    }
    .flow-step {
      display: grid;
      grid-template-columns: 58px minmax(0, 1fr);
      gap: 0 18px;
    }
    .flow-node {
      grid-row: 1 / 4;
    }
    .flow-step b {
      margin-top: 4px;
    }
    .flow-out {
      justify-self: start;
      margin-top: 8px;
    }
    .flow-loop {
      display: none;
    }
  }

  /* ══ IN PRODUCTION ═══════════════════════════════════════════ */
  /* One sentence per line; the column is widened so the second fits. */
  #cases .split-head {
    grid-template-columns: minmax(0, 1fr) minmax(0, 52ch);
  }
  @media (max-width: 860px) {
    #cases .split-head {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .lede-split span {
    display: block;
    text-wrap: balance;
  }
  .cases {
    display: grid;
