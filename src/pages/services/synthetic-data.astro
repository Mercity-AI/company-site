/* Staggered columns, cards at their natural height. The column count
   is chosen so the datasets divide evenly (ten → five columns of two),
   which is what leaves no hole at the bottom. Dealt round-robin, so
   reading order runs across the grid. */
const DS_COLS = 5;
const dsColumns = Array.from({ length: DS_COLS }, (_, c) => datasets.filter((_, i) => i % DS_COLS === c));

/* ── Known failure modes, and the check for each ───────────────── */
const controls = [
  {
    icon: 'repeat',
    risk: 'It over-represents the easy cases',
    fix: 'We map your domain before generating, so rare cases are produced on purpose and coverage is measured.',
  },
  {
    icon: 'wrong',
    risk: 'Samples read well and are wrong',
    fix: 'An independent model verifies every sample against your rules. Failures are regenerated or dropped.',
  },
  {
    icon: 'same',
    risk: 'It collapses into sameness',
    fix: 'We vary brief, style and difficulty case by case, and measure diversity on every batch.',
  },
  {
    icon: 'leak',
    risk: 'Test data leaks into training',
    fix: 'We deduplicate against your evaluation sets, so a benchmark gain means the model improved.',
