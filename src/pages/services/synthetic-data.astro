---

<V2Layout
  title="Synthetic data generation"
  description="Large-scale synthetic data for model training and evaluation, engineered around your domain, verified sample by sample, and yours to keep."
  path="/services/synthetic-data"
  image="/simula-og.jpg"
>
  <!-- ═══ HERO: a pinned scroll on the indigo strata ═════════════ -->
  <section class="sh" data-sh>
    <div class="sh-stage" data-vsticky="0">
      <div class="sh-plate" aria-hidden="true">
        <canvas class="sh-sharp" data-backdrop="sdStrata" data-seed="4471" data-dpr="1"></canvas>
        <canvas class="sh-soft" data-backdrop="sdStrata" data-seed="4471" data-dpr="0.35"></canvas>
        <span class="sh-light l1"></span>
        <span class="sh-light l2"></span>
        <span class="sh-light l3"></span>
        <span class="sh-shade"></span>
      </div>

      <div class="sh-copy" data-sh-copy data-live="true">
        <div class="shell sh-copy-in">
          <h1 class="sh-in">Large-scale synthetic data, engineered for training your models.</h1>
          <p class="sh-in d1">
            Generating training data at scale is the work we have specialised in for years. We have produced more than 100
            billion tokens for client projects, and our clients have trained state-of-the-art models on it. <br /> Every dataset is
            planned around your domain and verified sample by sample, so your model reaches production sooner, with fewer
            retraining cycles.
          </p>
          <div class="sh-actions sh-in d2">
            <a class="btn-l" href="/contact">
              <span class="btn-l-fill"></span>
              <span class="btn-l-label">Scope your dataset</span>
              <span class="btn-l-label" aria-hidden="true">→</span>
            </a>
            <a class="quiet on-dark" href="#generate">See what we generate<span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </div>

      <div class="sh-cue" aria-hidden="true">
        <span>Scroll</span>
        <i></i>
      </div>
    </div>
  </section>


  <!-- ═══ DOMAINS ════════════════════════════════════════════════ -->
  <section class="band band-tint domains wash" id="domains">
    <canvas class="wash-bg" data-backdrop="sdWashWarm" data-seed="9053" data-dpr="0.6" aria-hidden="true"></canvas>
    <div class="shell">
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">Domains we generate for</h2>
    </div>
    <div class="mq rv" data-rv>
      <div class="mq-track">
        {
          [0, 1].map((copy) => (
            <ul aria-hidden={copy === 1 ? 'true' : undefined}>
              {industries.map((name) => (
                <li>{name}</li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>


  <!-- ═══ THE PROBLEMS: six nodes, one hub ═══════════════════════ -->
  <section class="band" id="problems">
    <div class="shell">
      <div class="split-head">
        <h2 class="h2 rv" data-rv style="--rv-delay:80ms">The data problems we are brought in to solve.</h2>
        <p class="lede rv" data-rv style="--rv-delay:160ms">
          Most teams come to us with more than one problem. Our dataset engineered for your domain resolves all six at once.
        </p>
      </div>

      <div class="nodes" data-nodes>
        <svg class="nodes-lines" aria-hidden="true"></svg>
        <figure class="hub rv" data-rv data-hub>
          <canvas data-backdrop="sdStrata" data-seed="918" data-dpr="1" aria-hidden="true"></canvas>
          <span class="hub-eyebrow">All six, one answer</span>
          <span class="hub-word">An engineered dataset</span>
          <span class="hub-note">Planned · Generated · Verified</span>
        </figure>
        {
          problems.map((p, i) => (
            <div
              class:list={['node rv', i < 3 ? 'node-l' : 'node-r']}
              data-rv
              data-from={i < 3 ? 'left' : 'right'}
              data-node={i}
              style={`--rv-delay:${120 + (i % 3) * 80}ms;grid-row:${(i % 3) + 1}`}
            >
              <span class="node-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" set:html={ICON[p.icon]} />
              </span>
              <span class="node-text">
                <b>{p.title}</b>
                {p.line}
                <span class="node-fix">{p.fix}</span>
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>


  <!-- ═══ WHAT WE GENERATE ═══════════════════════════════════════ -->
  <section class="band band-tint" id="generate">
    <div class="shell">
      <div class="split-head">
        <h2 class="h2 rv" data-rv style="--rv-delay:80ms">What we generate.</h2>
        <p class="lede rv" data-rv style="--rv-delay:160ms">
          Data for training and evaluating language models, delivered in the schema your pipeline already uses.
        </p>
      </div>
      <div class="kinds">
        {
          kinds.map((k, i) => (
            <article class="kind rv" data-rv style={`--rv-delay:${60 + (i % 4) * 70}ms`}>
              <span class="kind-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" set:html={ICON[k.icon]} />
              </span>
              <h3>{k.title}</h3>
              <p>{k.line}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>


  <!-- ═══ HOW WE KEEP IT USABLE ══════════════════════════════════ -->
  <section class="band" id="quality">
    <div class="shell">
      <div class="split-head">
        <h2 class="h2 rv" data-rv style="--rv-delay:80ms">We engineer against known failures in data generation.</h2>
        <p class="lede rv" data-rv style="--rv-delay:160ms">
          These are the failure modes we have seen repeatedly across client projects. Each is planned for before
          generation starts and checked before any data reaches you.
        </p>
      </div>
      <div class="controls">
        <div class="controls-head" aria-hidden="true">
          <span>The failure mode</span>
          <span>How we prevent it</span>
        </div>
        {
          controls.map((c, i) => (
            <div class="control rv" data-rv style={`--rv-delay:${Math.min(i, 3) * 60}ms`}>
              <span class="control-risk">
                <span class="control-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" set:html={ICON[c.icon]} />
                </span>
                {c.risk}
              </span>
              <span class="control-fix">
                <i aria-hidden="true"></i>
                {c.fix}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>


  <!-- ═══ TWO WAYS TO START ══════════════════════════════════════ -->
  <section class="band band-tint" id="start">
    <div class="shell">
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">Two ways to start.</h2>
      <p class="lede rv" data-rv style="--rv-delay:160ms">
        It depends on what you already have. Either way, we plan the data before we generate any of it.
      </p>

      <div class="starts">
        {
          starts.map((s, i) => (
            <article class="start rv" data-rv data-from={i ? 'right' : 'left'} style={`--rv-delay:${140 + i * 80}ms`}>
              <figure class="start-art">
                {i === 0 ? (
                  <svg viewBox="0 0 400 276" role="img" aria-label="Existing data on a grid: one case type has no samples and one corner was never reached">
                    <defs>
                      <pattern id="st-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                        <path d="M0 0 V6" class="hatch" />
                      </pattern>
                    </defs>
                    {gridX.map((x) => (
                      <path class="grid" d={`M${x.toFixed(1)} ${PA.y0} V${PA.y1}`} />
                    ))}
                    {gridY.map((y) => (
                      <path class="grid" d={`M${PA.x0} ${y.toFixed(1)} H${PA.x1}`} />
                    ))}
                    <rect class="miss" x={MISSING.x.toFixed(1)} y={PA.y0} width={MISSING.w.toFixed(1)} height={PA.y1 - PA.y0} />
                    <circle class="miss rare" cx={RARE.x} cy={RARE.y} r={RARE.r} />
                    {scatter.map((p) => (
                      <circle class="pt" cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="2.4" />
                    ))}
                    <path class="axis" d={`M${PA.x0} ${PA.y0} V${PA.y1} H${PA.x1}`} />
                    <text class="lbl" x={PA.x1} y={PA.y1 + 16} text-anchor="end">case type →</text>
                    <text class="lbl" x={-PA.y0} y={PA.x0 - 10} text-anchor="end" transform="rotate(-90)">difficulty →</text>
                    <g class="tag">
                      <rect x={(MISSING.x + MISSING.w / 2 - 25).toFixed(1)} y={PA.y0 + 60} width="50" height="16" />
                      <text x={(MISSING.x + MISSING.w / 2).toFixed(1)} y={PA.y0 + 71.5}>missing</text>
                    </g>
                    <g class="tag">
                      <rect x={RARE.x - 58} y={RARE.y + RARE.r + 4} width="50" height="16" />
                      <text x={RARE.x - 33} y={RARE.y + RARE.r + 15.5}>no data</text>
                    </g>
                  </svg>
                ) : (
                  <svg viewBox="0 0 400 276" role="img" aria-label="Notes from your experts with three rules marked, turned into a specification, which generates samples tagged by the rule they cover">
                    {noteLines.map((l) =>
                      l.tag ? (
                        <path class="ln" d={curve({ x: l.tag.x + l.tag.w, y: l.y }, { x: SPEC.x - 14, y: SPEC.y })} />
                      ) : null,
