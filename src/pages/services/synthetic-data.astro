<script is:inline>
  /* ── Scroll-driven pieces ────────────────────────────────────────
     The hero (ground frosts, then the copy blurs away) and the loop
     rail follow the scroll.
     Under the layout's virtual scroll, `v2scroll` fires inside its own
     frame after the wrapper moves, so we update synchronously there;
     native scrolling goes through one rAF. */
  (() => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (v) => (v < 0 ? 0 : v > 1 ? 1 : v);
    const ease = (t) => 1 - Math.pow(1 - t, 3);
    const set = (el, k, v) => el.style.setProperty(k, v.toFixed(4));

    const hero = document.querySelector('[data-sh]');
    const stage = hero && hero.querySelector('.sh-stage');
    const copy = hero && hero.querySelector('[data-sh-copy]');
    const loop = document.querySelector('[data-loop]');
    const steps = loop ? [...loop.querySelectorAll('[data-step]')] : [];
    const csv = loop && loop.querySelector('[data-csv]');

    if (reduce) {
      if (hero) copy.dataset.live = 'true';
      if (loop) {
        steps.forEach((s) => (s.dataset.on = 'true'));
        csv.dataset.stage = loop.dataset.stage = '3';
      }
      return;
    }

    const update = () => {
      const vh = window.innerHeight;
      if (hero) {
        const r = hero.getBoundingClientRect();
        const span = r.height - stage.offsetHeight;
        const p = span > 0 ? clamp(-r.top / span) : 1;
        set(hero, '--a', ease(clamp(p / 0.5)));
        // Ease in, so the copy holds and then leaves quickly.
        const o = clamp((p - 0.45) / 0.5);
        set(hero, '--o', o * o);
        copy.dataset.live = o < 0.5 ? 'true' : 'false';
      }
      /* The loop: a step is current once its top passes 66% of the
         screen, so each state arrives a little ahead of the reader.
         The CSV beside it shows that step's state, and the rail fills
         to the current step. */
      if (loop) {
        const line = vh * 0.66;
        let stage = -1;
        steps.forEach((s, i) => {
          if (s.getBoundingClientRect().top < line) stage = i;
        });
        steps.forEach((s, i) => (s.dataset.on = i <= stage ? 'true' : 'false'));
        csv.dataset.stage = loop.dataset.stage = String(stage);
      }
    };

    let raf = 0;
    const req = () => {
      if (!raf)
        raf = requestAnimationFrame(() => {
          raf = 0;
          update();
        });
    };
    window.addEventListener('scroll', () => (document.documentElement.dataset.vscroll ? null : req()), {
      passive: true,
    });
    window.addEventListener('v2scroll', update);
    window.addEventListener('resize', req);
    update();
  })();

  /* ── Problem nodes: a curve from the hub to each node, drawn when
     the figure comes into view, with a pulse running in along it. ── */
  (() => {
    const root = document.querySelector('[data-nodes]');
    if (!root) return;
    const svg = root.querySelector('.nodes-lines');
    const hub = root.querySelector('[data-hub]');
    const nodes = [...root.querySelectorAll('[data-node]')];
    const NS = 'http://www.w3.org/2000/svg';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const build = () => {
      svg.replaceChildren();
      if (getComputedStyle(svg).display === 'none') return;
      /* Layout offsets, not client rects: the reveal and the virtual
         scroll both move things with transforms, which offsets ignore. */
      svg.setAttribute('viewBox', `0 0 ${root.offsetWidth} ${root.offsetHeight}`);
      const hx = hub.offsetLeft;
      const hy = hub.offsetTop;
      nodes.forEach((n, i) => {
        const left = n.classList.contains('node-l');
        const row = i % 3;
        const x1 = left ? hx : hx + hub.offsetWidth;
        const y1 = hy + hub.offsetHeight * (0.3 + row * 0.2);
        const x2 = left ? n.offsetLeft + n.offsetWidth : n.offsetLeft;
        const y2 = n.offsetTop + n.offsetHeight / 2;
        const mx = (x1 + x2) / 2;
        const path = document.createElementNS(NS, 'path');
        path.setAttribute('d', `M${x1} ${y1} C${mx} ${y1}, ${mx} ${y2}, ${x2} ${y2}`);
        path.setAttribute('pathLength', '1');
        path.setAttribute('id', 'np-' + i);
        path.style.transitionDelay = 200 + row * 120 + 'ms';
        svg.appendChild(path);
        [x1, x2].forEach((x, j) => {
          const dot = document.createElementNS(NS, 'circle');
          dot.setAttribute('cx', x);
          dot.setAttribute('cy', j ? y2 : y1);
          dot.setAttribute('r', '3');
          dot.setAttribute('class', 'end');
          svg.appendChild(dot);
        });
        if (reduce) return;
        const pulse = document.createElementNS(NS, 'circle');
        pulse.setAttribute('r', '3.2');
        pulse.setAttribute('class', 'pulse');
        const move = document.createElementNS(NS, 'animateMotion');
        move.setAttribute('dur', '2.8s');
        move.setAttribute('repeatCount', 'indefinite');
        move.setAttribute('begin', -(i * 0.47).toFixed(2) + 's');
        // Inward: each problem runs into the hub that answers it.
        move.setAttribute('keyPoints', '1;0');
        move.setAttribute('keyTimes', '0;1');
        move.setAttribute('calcMode', 'spline');
        move.setAttribute('keySplines', '0.4 0 0.2 1');
        const mpath = document.createElementNS(NS, 'mpath');
        mpath.setAttribute('href', '#np-' + i);
        move.appendChild(mpath);
        pulse.appendChild(move);
        svg.appendChild(pulse);
      });
    };

    let t;
    const rebuild = () => {
      clearTimeout(t);
      t = setTimeout(build, 80);
    };
    if ('ResizeObserver' in window) new ResizeObserver(rebuild).observe(root);
    else window.addEventListener('resize', rebuild);
    build();

    if (!('IntersectionObserver' in window) || reduce) {
      root.dataset.on = 'true';
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries[0].isIntersecting) return;
        root.dataset.on = 'true';
        io.disconnect();
      },
      { threshold: 0.35 }
    );
    io.observe(root);
  })();

  /* ── Datasets shader ──────────────────────────────────────────────
     One WebGL canvas under the whole datasets section. Everywhere it
     draws a slow domain-warped flow (fbm of fbm of fbm) in ivory,
     lilac, peach and mint. Inside each card's rectangle it draws that
     card's own three-colour flow instead, with a white lift under the
     description so ink stays readable. Card rectangles are measured
     every frame, so the colour follows the reveal and the hover lift.
     Hovering a card speeds its flow and deepens its colours. Rendered
     at half resolution (the fields are smooth; grain is a CSS layer on
     top), capped near 30fps, and only while the section is on screen.
     Reduced motion draws one still frame. No WebGL: the CSS cards and
     the sdBlurField canvas stay as they are. */
  (() => {
    const sec = document.getElementById('datasets');
    const cv = sec && sec.querySelector('.ds-gl');
    if (!cv) return;
    const gl = cv.getContext('webgl', { antialias: false, alpha: false, preserveDrawingBuffer: false });
    if (!gl) return;
    const tiles = [...sec.querySelectorAll('.ds-tile')].slice(0, 12);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const VERT = 'attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}';
    const FRAG = `
      precision highp float;
      uniform vec2 uRes;
      uniform float uScale;
      uniform float uTime;
      uniform int uCount;
      uniform vec4 uRect[12];
      uniform vec3 uPal[36];
      uniform float uPhase[12];
      uniform float uHov[12];
      uniform float uCardMix;

      float hash(vec2 p){ p = fract(p * vec2(123.34, 456.21)); p += dot(p, p + 45.32); return fract(p.x * p.y); }
      float noise(vec2 p){
        vec2 i = floor(p), f = fract(p);
        vec2 u = f * f * (3. - 2. * f);
        return mix(mix(hash(i), hash(i + vec2(1., 0.)), u.x), mix(hash(i + vec2(0., 1.)), hash(i + vec2(1., 1.)), u.x), u.y);
      }
      float fbm(vec2 p){
        float v = 0., a = .5;
        mat2 m = mat2(1.6, 1.2, -1.2, 1.6);
        for (int i = 0; i < 5; i++){ v += a * noise(p); p = m * p; a *= .5; }
        return v;
      }
      float warp(vec2 p, float t, out vec2 q, out vec2 r){
        q = vec2(fbm(p + t * .10), fbm(p + vec2(5.2, 1.3) - t * .08));
        r = vec2(fbm(p + 2.6 * q + vec2(1.7, 9.2) + t * .12), fbm(p + 2.6 * q + vec2(8.3, 2.8) - t * .10));
        return fbm(p + 2.4 * r);
      }

      void main(){
        vec2 px = vec2(gl_FragCoord.x, uRes.y - gl_FragCoord.y) / uScale;
        vec2 q, r;
        float f = warp(px / 560., uTime * .6, q, r);
        vec3 col = vec3(.985, .972, .952);
        col = mix(col, vec3(.87, .85, .985), smoothstep(.35, .85, f));
        col = mix(col, vec3(.995, .87, .81), smoothstep(.45, .95, q.x) * .75);
        col = mix(col, vec3(.81, .945, .925), smoothstep(.5, .95, r.y) * .65);

        for (int i = 0; i < 12; i++){
          if (i >= uCount) break;
          vec4 R = uRect[i];
          vec2 uv = (px - R.xy) / R.zw;
          if (uv.x < 0. || uv.y < 0. || uv.x > 1. || uv.y > 1.) continue;
          vec2 p = vec2(uv.x * R.z / R.w, uv.y) * 1.25 + vec2(float(i) * 3.7, float(i) * 1.9);
          vec2 cq, cr;
          float g = warp(p, uPhase[i], cq, cr);
          vec3 c0 = uPal[i * 3], c1 = uPal[i * 3 + 1], c2 = uPal[i * 3 + 2];
          vec3 cc = mix(c0, c1, smoothstep(.22, .78, g));
          cc = mix(cc, c2, smoothstep(.3, .85, cr.x) * .9);
          cc += .07 * smoothstep(.55, .95, cq.y);
          cc = mix(cc, pow(cc, vec3(1.35)), uHov[i] * .55);
          cc = mix(cc, vec3(1.), smoothstep(.5, 1., uv.y) * .42);
          // Card strength: how much of the flow shows over white.
          col = mix(vec3(1.), cc, uCardMix + uHov[i] * .15);
        }
        gl_FragColor = vec4(col, 1.);
      }`;

    const sh = (type, src) => {
      const s = gl.createShader(type);
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return gl.getShaderParameter(s, gl.COMPILE_STATUS) ? s : null;
    };
    const vs = sh(gl.VERTEX_SHADER, VERT);
    const fs = sh(gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) return;
    const prog = gl.createProgram();
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const aLoc = gl.getAttribLocation(prog, 'a');
    gl.enableVertexAttribArray(aLoc);
    gl.vertexAttribPointer(aLoc, 2, gl.FLOAT, false, 0, 0);
    const U = {};
    ['uRes', 'uScale', 'uTime', 'uCount', 'uRect', 'uPal', 'uPhase', 'uHov', 'uCardMix'].forEach(
      (n) => (U[n] = gl.getUniformLocation(prog, n))
    );

    /* Three colours per card, in dataset order. Mid-light values, so
       dark ink reads on every one of them. */
    const PAL = [
      [[243, 85, 77], [282, 70, 84], [22, 95, 83]],
      [[176, 58, 71], [205, 78, 82], [148, 55, 84]],
      [[262, 72, 80], [330, 72, 86], [210, 82, 84]],
      [[30, 95, 79], [350, 80, 85], [48, 95, 83]],
      [[196, 78, 77], [243, 72, 84], [168, 55, 84]],
      [[166, 55, 73], [46, 92, 81], [200, 72, 85]],
      [[314, 58, 83], [243, 78, 81], [26, 92, 85]],
      [[20, 92, 79], [270, 62, 85], [188, 72, 83]],
      [[338, 76, 83], [262, 72, 81], [36, 95, 85]],
      [[212, 82, 79], [158, 56, 81], [262, 66, 87]],
      [[40, 95, 79], [14, 86, 85], [243, 72, 86]],
      [[150, 52, 77], [196, 72, 83], [282, 56, 87]],
    ];
    const rgb = ([h, s, l]) => {
      s /= 100;
      l /= 100;
      const k = (n) => (n + h / 30) % 12;
      const a = s * Math.min(l, 1 - l);
      const f = (n) => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
      return [f(0), f(8), f(4)];
    };
    /* Every card uses the Kimi K3 card's palette (indigo, violet,
       peach). Each still flows on its own, since the pattern offset
       and phase differ per card. Set CARD_PAL to null to go back to
       one palette per dataset. */
    const CARD_PAL = 0;
    const pal = new Float32Array(36 * 3);
    tiles.forEach((t, i) => {
      const p = CARD_PAL === null ? PAL[Number(t.dataset.pal) % PAL.length] : PAL[CARD_PAL];
      p.forEach((c, k) => pal.set(rgb(c), (i * 3 + k) * 3));
    });
    gl.uniform3fv(U.uPal, pal);
    /* How strongly the card colour shows over white: 1 is full colour,
       0 is plain white. Hover adds 0.15 on top. */
    const CARD_MIX = 0.4;
    gl.uniform1f(U.uCardMix, CARD_MIX);
    gl.uniform1i(U.uCount, tiles.length);

    const hovT = new Float32Array(12);
    const hov = new Float32Array(12);
    const phase = new Float32Array(12).map((_, i) => i * 1.7);
    tiles.forEach((t, i) => {
      const on = () => (hovT[i] = 1);
      const off = () => (hovT[i] = 0);
      t.addEventListener('pointerenter', on);
      t.addEventListener('pointerleave', off);
      t.addEventListener('focus', on);
      t.addEventListener('blur', off);
    });

    let scale = 1;
    const resize = () => {
      scale = Math.min(window.devicePixelRatio || 1, 2) * 0.5;
      cv.width = Math.max(1, Math.round(sec.clientWidth * scale));
      cv.height = Math.max(1, Math.round(sec.clientHeight * scale));
      gl.viewport(0, 0, cv.width, cv.height);
    };
    const rects = new Float32Array(48);
    let t0 = performance.now();
    let last = 0;
    const draw = (now) => {
      const dt = Math.min(0.1, (now - last) / 1000 || 0);
      last = now;
      const sr = sec.getBoundingClientRect();
      tiles.forEach((t, i) => {
        const r = t.getBoundingClientRect();
        rects.set([r.left - sr.left, r.top - sr.top, r.width, r.height], i * 4);
        hov[i] += (hovT[i] - hov[i]) * Math.min(1, dt * 6);
        phase[i] += dt * (0.55 + hov[i] * 1.6);
      });
      gl.uniform2f(U.uRes, cv.width, cv.height);
      gl.uniform1f(U.uScale, scale);
      gl.uniform1f(U.uTime, (now - t0) / 1000);
      gl.uniform4fv(U.uRect, rects);
      gl.uniform1fv(U.uPhase, phase);
      gl.uniform1fv(U.uHov, hov);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };

    resize();
    sec.classList.add('gl-on');
    let running = false;
    let raf = 0;
    let lastFrame = 0;
    const loop = (now) => {
      raf = 0;
      if (!running) return;
      if (now - lastFrame >= 32) {
        lastFrame = now;
        draw(now);
      }
      raf = requestAnimationFrame(loop);
    };
    const start = () => {
      if (reduce) return draw(performance.now());
      if (!raf) raf = requestAnimationFrame(loop);
    };
    if ('ResizeObserver' in window)
      new ResizeObserver(() => {
        resize();
        draw(performance.now());
      }).observe(sec);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          running = entries[0].isIntersecting;
          if (running) start();
        },
        { rootMargin: '100px' }
      ).observe(sec);
    } else {
      running = true;
      start();
    }
    draw(performance.now());
  })();

  /* ── Counters: count up once, when their strip comes into view. ── */
  (() => {
    const groups = [...document.querySelectorAll('[data-counts]')];
    if (!groups.length || !('IntersectionObserver' in window)) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const fmt = (n) => Math.round(n).toLocaleString('en-US');
    const run = (n) => {
      const to = Number(n.dataset.count);
      const t0 = performance.now();
      const tick = (t) => {
        const k = Math.min(1, (t - t0) / 1400);
        n.textContent = fmt(to * (1 - Math.pow(1 - k, 4))) + n.dataset.suffix;
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.querySelectorAll('[data-count]').forEach(run);
          io.unobserve(e.target);
        });
      },
      { threshold: 0.4 }
    );
    groups.forEach((g) => {
      g.querySelectorAll('[data-count]').forEach((n) => (n.textContent = '0' + n.dataset.suffix));
      io.observe(g);
    });
  })();
</script>

<style>
