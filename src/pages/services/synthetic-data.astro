/* ── Two ways to start: the illustrations ──────────────────────── */
function rng(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
/* A: your data, plotted, with its gaps. A grid over the plot, one case
   type with no samples at all (a hatched column) and a rare corner
   that was never reached. */
const PA = { x0: 44, x1: 384, y0: 14, y1: 240 };
const BIN_W = (PA.x1 - PA.x0) / 10;
const MISSING = { x: PA.x0 + BIN_W * 3, w: BIN_W };
const RARE = { x: 338, y: 50, r: 26 };
const scatterRand = rng(7719);
const gauss = () => {
  const u = 1 - scatterRand();
  const v = scatterRand();
  return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
};
const points: { x: number; y: number }[] = [];
for (const cl of [
  { x: 92, y: 150, sx: 24, sy: 40, n: 54 },
  { x: 240, y: 164, sx: 34, sy: 36, n: 64 },
  { x: 352, y: 198, sx: 14, sy: 20, n: 16 },
]) {
  for (let i = 0; i < cl.n; i++) points.push({ x: cl.x + gauss() * cl.sx, y: cl.y + gauss() * cl.sy });
}
for (let i = 0; i < 16; i++) points.push({ x: PA.x0 + scatterRand() * (PA.x1 - PA.x0), y: PA.y0 + scatterRand() * (PA.y1 - PA.y0) });
const scatter = points.filter(
  (p) =>
    p.x > PA.x0 + 6 &&
    p.x < PA.x1 - 6 &&
    p.y > PA.y0 + 6 &&
    p.y < PA.y1 - 6 &&
    (p.x < MISSING.x - 5 || p.x > MISSING.x + MISSING.w + 5) &&
    Math.hypot(p.x - RARE.x, p.y - RARE.y) > RARE.r + 6,
);
const gridX = Array.from({ length: 11 }, (_, i) => PA.x0 + i * BIN_W);
const gridY = Array.from({ length: 7 }, (_, i) => PA.y0 + (i * (PA.y1 - PA.y0)) / 6);

/* B: your experts' knowledge, turned into data. Their notes on the
   left with three rules marked, each feeding a written spec, which
   generates the samples on the right, tagged by the rule they cover. */
const NOTE = { x: 16, y: 34, w: 132, h: 200 };
const noteRand = rng(3307);
const noteTags = [
  { row: 1, label: 'rule', tone: 'i' },
  { row: 4, label: 'edge case', tone: 't' },
  { row: 7, label: 'format', tone: 'p' },
];
const noteLines = Array.from({ length: 9 }, (_, r) => {
  const y = NOTE.y + 44 + r * 17;
  const tag = noteTags.find((t) => t.row === r);
  if (tag) {
    const w = tag.label.length * 6.1 + 12;
    return { y, tag: { ...tag, w, x: NOTE.x + 12 }, after: 14 + noteRand() * 30 };
  }
  return { y, bar: 54 + noteRand() * 52 };
});
const SPEC = { x: 196, y: 134 };
const outRows = Array.from({ length: 7 }, (_, i) => ({
  y: 38 + i * 30,
  tone: ['i', 't', 'p', 'i', 't', 'i', 'p'][i],
  a: 46 + noteRand() * 44,
  b: 22 + noteRand() * 36,
}));
const curve = (a: { x: number; y: number }, b: { x: number; y: number }) => {
  const mx = (a.x + b.x) / 2;
  return `M${a.x} ${a.y} C${mx} ${a.y}, ${mx} ${b.y}, ${b.x} ${b.y}`;
};

/* ── Dataset tile illustrations ────────────────────────────────────
   One small SVG per dataset (240 × 90), a picture of what the data is
   rather than a row of it. Seeded, so every build draws the same.
   Colours are classes styled in the page CSS: indigo ink, violet and
   peach from the cards' palette, soft indigo and neutral grey. */
const VIZ: Record<string, string> = (() => {
  const R = rng(5281);
  const n1 = (v: number) => v.toFixed(1);
  const o2 = (v: number) => v.toFixed(2);
  const g = () => {
    const u = 1 - R();
    return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * R());
  };
  const bar = (x: number, y: number, w: number, cls: string, op = 1, h = 3.6) =>
    `<rect class="${cls}" x="${n1(x)}" y="${n1(y - h / 2)}" width="${n1(w)}" height="${h}" rx="${h / 2}" fill-opacity="${o2(op)}"/>`;
  const out: Record<string, string> = {};

  // Simula stories: a taxonomy branches into leaves, each leaf a story.
  {
    let s = '';
    const root = { x: 16, y: 45 };
    [18, 45, 72].forEach((y) => {
      const m = { x: 60, y };
      s += `<path class="v-line" d="${curve(root, m)}"/>`;
      [-8, 8].forEach((dy) => {
        const l = { x: 100, y: y + dy };
        s += `<path class="v-line" d="${curve(m, l)}"/><circle class="v-peach" cx="100" cy="${l.y}" r="3"/>`;
        s += bar(110, l.y, 50 + R() * 76, 'v-vio', 0.35 + R() * 0.4);
      });
      s += `<circle class="v-ink" cx="60" cy="${y}" r="3.4"/>`;
    });
    s += `<rect class="v-ink" x="11.5" y="40.5" width="9" height="9"/>`;
    out['kimi-k3-story-corpus-embeddings'] = s;
  }

  // Memory triplets: a message, memories that belong near it, and
  // hard negatives pushed away.
  {
    const m = { x: 36, y: 45 };
    const pos = [
      { x: 92, y: 26 },
      { x: 100, y: 62 },
    ];
    const neg = [
      { x: 196, y: 20 },
      { x: 212, y: 64 },
    ];
    let s = '';
    pos.forEach((p) => (s += `<path class="v-inkS" d="M${m.x} ${m.y} L${p.x} ${p.y}"/>`));
    neg.forEach((p) => (s += `<path class="v-dash" d="M${m.x} ${m.y} L${p.x} ${p.y}"/>`));
    s += `<circle class="v-halo" cx="${m.x}" cy="${m.y}" r="30"/>`;
    s += `<circle class="v-ink" cx="${m.x}" cy="${m.y}" r="6"/>`;
    pos.forEach((p) => (s += `<circle class="v-vio" cx="${p.x}" cy="${p.y}" r="4.5"/>`));
    neg.forEach((p) => (s += `<circle class="v-hollow" cx="${p.x}" cy="${p.y}" r="4.5"/>`));
    s += `<text class="v-txt" x="36" y="84" text-anchor="middle">message</text>`;
    s += `<text class="v-txt" x="108" y="68">positive</text>`;
    s += `<text class="v-txt" x="204" y="45" text-anchor="middle">negative</text>`;
    out['Memory-Embeddings'] = s;
  }

  // ReasonBridge: a long reasoning trace, many strands of thought
  // weaving across, converging into one short answer.
  {
    const C = { x: 172, y: 45 };
    let s = `<defs>
      <linearGradient id="rb-a" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="hsl(275 60% 70%)" stop-opacity="0.25"/>
        <stop offset="0.7" stop-color="hsl(262 70% 62%)" stop-opacity="0.8"/>
        <stop offset="1" stop-color="hsl(243 75% 52%)"/>
      </linearGradient>
      <radialGradient id="rb-glow"><stop offset="0" stop-color="hsl(22 95% 66%)" stop-opacity="0.55"/><stop offset="1" stop-color="hsl(22 95% 66%)" stop-opacity="0"/></radialGradient>
    </defs>`;
    const bez = (p0: number[], p1: number[], p2: number[], p3: number[], t: number) =>
      [0, 1].map((k) => {
        const u = 1 - t;
        return u * u * u * p0[k] + 3 * u * u * t * p1[k] + 3 * u * t * t * p2[k] + t * t * t * p3[k];
      });
    for (let k = 0; k < 9; k++) {
      const y0 = 8 + k * 9.25;
      const wob = (R() - 0.5) * 34;
      const p0 = [10, y0];
      const p1 = [64, y0 + wob];
      const p2 = [118, C.y + (y0 - C.y) * 0.25 - wob * 0.4];
      const p3 = [C.x, C.y];
      s += `<path d="M${p0.join(' ')} C${n1(p1[0])} ${n1(p1[1])}, ${n1(p2[0])} ${n1(p2[1])}, ${p3.join(' ')}" fill="none" stroke="url(#rb-a)" stroke-width="${k % 3 === 1 ? 1.6 : 1.1}" stroke-linecap="round"/>`;
      [0.18, 0.42].forEach((t, j) => {
        if ((k + j) % 2) return;
        const [x, y] = bez(p0, p1, p2, p3, t + R() * 0.08);
        s += `<circle class="${j ? 'v-vio' : 'v-soft'}" cx="${n1(x)}" cy="${n1(y)}" r="${j ? 2 : 1.7}"/>`;
      });
    }
    s += `<circle cx="${C.x}" cy="${C.y}" r="16" fill="url(#rb-glow)"/>`;
    s += `<circle class="v-ink" cx="${C.x}" cy="${C.y}" r="3"/>`;
    s += `<path class="v-inkS" d="M${C.x + 4} ${C.y} H186"/>`;
    s += `<rect class="v-answer" x="188" y="31" width="44" height="28" rx="4"/>`;
    s += bar(195, 40, 30, 'v-peach', 0.95, 3.4) + bar(195, 48.5, 20, 'v-peach', 0.6, 3.4);
    s += `<text class="v-txt" x="10" y="88">reasoning trace</text><text class="v-txt" x="232" y="72" text-anchor="end">answer</text>`;
    out['ReasonBridge-URT'] = s;
  }

  // FineWeb: page after page of web text.
  {
    let s = '';
    for (let y = 10; y <= 82; y += 8) {
      let x = 10;
      while (x < 228) {
        const w = Math.min(10 + R() * 36, 230 - x);
        if (w > 4) s += bar(x, y, w, R() < 0.12 ? 'v-vio' : 'v-mute', R() < 0.12 ? 0.55 : 0.9, 3.2);
        x += w + 4;
      }
    }
    out['FineWeb-Preprocessed'] = s;
  }

  // LAION: images paired with captions.
  {
    let s = '';
    [12, 126].forEach((x, i) => {
      const y = 8;
      s += `<rect class="v-frame" x="${x}" y="${y}" width="102" height="50"/>`;
      s += `<path class="v-soft" d="M${x + 6} ${y + 46} L${x + 32} ${y + 20} L${x + 48} ${y + 34} L${x + 64} ${y + 22} L${x + 96} ${y + 46} Z"/>`;
      s += `<circle class="v-peach" cx="${x + 80}" cy="${y + 14}" r="${i ? 4 : 5}"/>`;
      s += bar(x, 70, 84 - i * 14, 'v-vio', 0.55) + bar(x, 79, 56 + i * 10, 'v-vio', 0.35);
    });
    out['laion-subset'] = s;
  }

  // Mahabharat: rows of verses as embedding vectors.
  {
    let s = '';
    [16, 34, 52, 70].forEach((y) => {
      for (let c = 0; c < 26; c++) {
        const v = R();
        s += `<rect class="${v > 0.9 ? 'v-peach' : 'v-ink'}" x="${n1(12 + c * 8.4)}" y="${y - 7}" width="7.4" height="14" fill-opacity="${o2(v > 0.9 ? 0.85 : 0.08 + v * 0.7)}"/>`;
      }
    });
    out['mahabharat-embeddings'] = s;
  }

  // Ramayana: embedded passages falling into clusters.
  {
    let s = '';
    [
      { x: 58, y: 42, c: 'v-ink' },
      { x: 128, y: 60, c: 'v-vio' },
      { x: 192, y: 30, c: 'v-peach' },
    ].forEach((k) => {
      s += `<circle class="${k.c}" cx="${k.x}" cy="${k.y}" r="24" fill-opacity="0.1"/>`;
      for (let i = 0; i < 15; i++) {
        s += `<circle class="${k.c}" cx="${n1(k.x + g() * 9)}" cy="${n1(k.y + g() * 8)}" r="2.3" fill-opacity="0.85"/>`;
      }
    });
    out['ramayana-embeddings'] = s;
  }

  // Bhagavad Gita: verse vectors from one origin, and the angle
  // between two of them that similarity search reads.
  {
    const o = { x: 24, y: 78 };
    let s = `<path class="v-line" d="M${o.x} 8 V${o.y} H232"/>`;
    const vecs = [
      [22, 170, 'v-ink'],
      [38, 140, 'v-vio'],
      [56, 96, 'v-mute'],
      [74, 72, 'v-mute'],
    ] as const;
    vecs.forEach(([deg, len, cls]) => {
      const a = (deg * Math.PI) / 180;
      const x = o.x + Math.cos(a) * len;
      const y = o.y - Math.sin(a) * len * 0.62;
      const ang = Math.atan2(y - o.y, x - o.x);
      const hx = (d: number) => n1(x - 7 * Math.cos(ang + d));
      const hy = (d: number) => n1(y - 7 * Math.sin(ang + d));
      const stroke = cls === 'v-mute' ? 'v-lineS' : cls === 'v-ink' ? 'v-inkS' : 'v-vioS';
      s += `<path class="${stroke}" d="M${o.x} ${o.y} L${n1(x)} ${n1(y)} M${hx(0.45)} ${hy(0.45)} L${n1(x)} ${n1(y)} L${hx(-0.45)} ${hy(-0.45)}"/>`;
    });
    s += `<path class="v-peachS" d="M${n1(o.x + 46 * Math.cos((22 * Math.PI) / 180))} ${n1(o.y - 46 * Math.sin((22 * Math.PI) / 180) * 0.62)} A46 28 0 0 0 ${n1(o.x + 46 * Math.cos((38 * Math.PI) / 180))} ${n1(o.y - 46 * Math.sin((38 * Math.PI) / 180) * 0.62)}"/>`;
    s += `<text class="v-txt" x="70" y="75">cos θ</text>`;
    out['bhagavad_gita-embeddings'] = s;
  }

  // Anime diffusion: noise resolving into an image, step by step.
  {
    let s = '';
    [1, 0.62, 0.3, 0].forEach((noise, k) => {
      const x0 = 12 + k * 58;
      const y0 = 16;
      for (let i = 0; i < 6; i++) {
        for (let j = 0; j < 6; j++) {
          const t = (i + j) / 10;
          const clean = `hsl(${n1((22 - t * 110 + 360) % 360)} 78% ${n1(80 - t * 12)}%)`;
          const fill = R() < noise ? `hsl(${n1(R() * 360)} 28% ${n1(46 + R() * 46)}%)` : clean;
          s += `<rect x="${n1(x0 + i * 7.5)}" y="${n1(y0 + j * 7.5)}" width="7.5" height="7.5" fill="${fill}"/>`;
        }
      }
      s += `<rect class="v-edge" x="${x0}" y="${y0}" width="45" height="45"/>`;
      if (k < 3) s += `<path class="v-lineS" d="M${x0 + 49} 38.5 l4 0 M${x0 + 51} 36 l2.5 2.5 l-2.5 2.5"/>`;
    });
    s += `<text class="v-txt" x="12" y="78">noise</text><text class="v-txt" x="231" y="78" text-anchor="end">image</text>`;
    out['AnimeDiffusion_Dataset'] = s;
  }

  // Figure skating: a programme seen from above. The rink, the path
  // the skater traced across it, and the elements marked where they
  // happened: jumps as a hop off the trace, a spin as a tight spiral.
  // The dataset classifies those elements from pose sequences.
  {
    let s = `<defs>
      <linearGradient id="fs-path" x1="0" x2="1">
        <stop offset="0" stop-color="hsl(275 60% 72%)" stop-opacity="0.35"/>
        <stop offset="0.55" stop-color="hsl(262 70% 62%)"/>
        <stop offset="1" stop-color="hsl(243 75% 52%)"/>
      </linearGradient>
    </defs>`;
    // The rink.
    s += `<rect x="5" y="5" width="230" height="80" rx="34" fill="hsl(243 80% 97.5%)" stroke="hsl(243 54% 87%)" stroke-width="1.1"/>`;
    s += `<path d="M120 5 V85" stroke="hsl(243 54% 87%)" stroke-width="1" stroke-dasharray="3 3"/>`;
    s += `<circle cx="120" cy="45" r="11" fill="none" stroke="hsl(243 54% 87%)" stroke-width="1"/>`;

    // The trace: a Catmull-Rom curve through the waypoints.
    const W: [number, number][] = [
      [20, 60], [40, 34], [70, 24], [100, 34], [116, 58], [146, 70], [178, 62], [200, 38], [222, 30],
    ];
    const seg = (p0: number[], p1: number[], p2: number[], p3: number[]) =>
      ` C${n1(p1[0] + (p2[0] - p0[0]) / 6)} ${n1(p1[1] + (p2[1] - p0[1]) / 6)}, ${n1(p2[0] - (p3[0] - p1[0]) / 6)} ${n1(p2[1] - (p3[1] - p1[1]) / 6)}, ${p2[0]} ${p2[1]}`;
    let d = `M${W[0][0]} ${W[0][1]}`;
    for (let i = 0; i < W.length - 1; i++) {
      d += seg(W[Math.max(0, i - 1)], W[i], W[i + 1], W[Math.min(W.length - 1, i + 2)]);
    }
    s += `<path d="${d}" fill="none" stroke="url(#fs-path)" stroke-width="1.7" stroke-linecap="round"/>`;
    // Where the skater is now, at the end of the trace.
    s += `<circle class="v-ink" cx="222" cy="30" r="3"/>`;

    // A spin: a tight spiral sitting on the trace.
    {
      const cx = 40;
      const cy = 34;
      const pts: string[] = [];
      for (let i = 0; i <= 60; i++) {
        const u = i / 60;
        const a = u * Math.PI * 2 * 2.4;
        const r = 9 * (1 - u) + 1;
        pts.push(`${n1(cx + Math.cos(a) * r)} ${n1(cy + Math.sin(a) * r)}`);
      }
      s += `<path class="v-vioS" d="M${pts.join(' L')}" stroke-width="1.2"/>`;
    }
    // Jumps: a hop arcing off the trace, landing further along.
    const hop = (x0: number, y0: number, x1: number, y1: number) =>
      `<path class="v-peachS" d="M${x0} ${y0} Q${(x0 + x1) / 2} ${Math.min(y0, y1) - 16} ${x1} ${y1}" stroke-dasharray="2.5 2.5"/>` +
      `<circle class="v-peach" cx="${x0}" cy="${y0}" r="2.4"/><circle class="v-peach" cx="${x1}" cy="${y1}" r="2.4"/>`;
    s += hop(70, 24, 100, 34) + hop(146, 70, 178, 62);

    // Element labels, as small chips.
    // Colours are set on the shapes themselves as well as by class, so
    // the chips never fall back to the SVG default of solid black.
    const chip = (x: number, y: number, label: string, cls: string) => {
      const w = label.length * 4.4 + 9;
      const edge = cls === 'v-chip2' ? 'hsl(275 58% 70%)' : 'hsl(22 90% 64%)';
      return `<rect class="${cls}" x="${n1(x - w / 2)}" y="${y - 6}" width="${n1(w)}" height="11" rx="5.5" fill="#fff" stroke="${edge}" stroke-width="1"/>` +
        `<text class="v-chiptxt" x="${x}" y="${y + 2.2}" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-size="7" fill="hsl(240 10% 27%)">${label}</text>`;
    };
    s += chip(40, 57, 'spin', 'v-chip2');
    s += chip(85, 13, 'axel', 'v-chip');
    s += chip(162, 48, 'lutz', 'v-chip');
    out['Figure-Skating-Classification-Data'] = s;
  }

  return out;
})();

