---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import V2Layout from '@/layouts/V2Layout.astro';
import Article from '@/components/v2/Article.astro';
import { entryToRow, getResearchUrl, sortPostsByPublishedDate } from '@/utils/blog';
import { papers } from '@/data/papers';
import { articleNodes } from '@/utils/schema';

export async function getStaticPaths() {
  const entries = await getCollection('research');

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'research'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const publishedTimeISO = entry.data.publishedAt.toISOString();
const modifiedTimeISO = entry.data.updatedAt ? entry.data.updatedAt.toISOString() : undefined;
const articlePath = getResearchUrl(entry);

const more = sortPostsByPublishedDate(await getCollection('research'))
  .filter((e) => e.id !== entry.id)
  .slice(0, 3)
  .map((e) => entryToRow(e, getResearchUrl(e)));

/* A log that has a paper (src/data/papers.ts) cites it and links its code. */
const paper = papers.find((p) => p.log === articlePath);
const schema = articleNodes({
  entry,
  path: articlePath,
  type: 'TechArticle',
  section: { name: 'Research', path: '/research' },
  citations: paper
    ? [
        { name: paper.title, url: paper.href, type: 'paper', author: paper.authors },
        ...(paper.code ? [{ name: `${paper.title} (code)`, url: paper.code, type: 'code' as const }] : []),
      ]
    : [],
});
---

<V2Layout
  title={entry.data.title}
  description={entry.data.summary}
  image={entry.data.image}
  path={articlePath}
  type="article"
  publishedTime={publishedTimeISO}
  modifiedTime={modifiedTimeISO}
  author={entry.data.authors[0]?.name}
  tags={entry.data.tags}
  schema={schema}
>
  <Article entry={entry} backHref="/research" section="Research" more={more}>
    <Content />
  </Article>
</V2Layout>
