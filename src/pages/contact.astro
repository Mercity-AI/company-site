---
/**
 * Contact, on the V2 shell. Quiet, like About: type, rules, one form.
 *
 * The form posts { name, email, company, message } to the contact
 * backend (`backend/main.py`, `/api/contact`), whose base URL comes from
 * PUBLIC_CONTACT_API_BASE_URL. The booking calendar is Calendly's inline
 * widget, loaded only when its band comes near the screen.
 */
import V2Layout from '@/layouts/V2Layout.astro';
import ListHead from '@/components/v2/ListHead.astro';

const CALENDLY_URL = 'https://calendly.com/pranav-mercity/30min';
// The embed takes the site's indigo for its accents (Calendly honours
// colour parameters on paid plans and ignores them otherwise).
const CALENDLY_EMBED = `${CALENDLY_URL}?hide_gdpr_banner=1&primary_color=3028d7`;
const EMAIL = 'pranav@mercity.io';
const contactApiBaseUrl = import.meta.env.PUBLIC_CONTACT_API_BASE_URL ?? 'http://127.0.0.1:8000';
---

<V2Layout
  title="Contact"
  description="Send Mercity the task, the model you use now and where it falls short, or book a 30-minute call."
  path="/contact"
>
  <ListHead
    title="Tell us what you are building."
    lede={['Send us the task, the model you use now and where it falls short.', 'We will come back with a concrete next step.']}
  />

  <!-- ═══ THE FORM ═══════════════════════════════════════════════ -->
  <section class="band" id="message">
    <div class="shell contact-grid">
      <form class="cf rv" data-rv id="contact-form" data-api-base-url={contactApiBaseUrl}>
        <div class="cf-grid">
          <label class="cf-field">
            <span class="cf-label">Name</span>
            <input name="name" type="text" required autocomplete="name" placeholder="Your name" />
          </label>
          <label class="cf-field">
            <span class="cf-label">Email</span>
            <input name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
          </label>
          <label class="cf-field cf-wide">
            <span class="cf-label">Company <i>optional</i></span>
            <input name="company" type="text" autocomplete="organization" placeholder="Where you work" />
          </label>
          <label class="cf-field cf-wide">
            <span class="cf-label">What are you working on?</span>
            <textarea
              name="message"
              rows="7"
              required
              placeholder="What the system does, the model you use now, and where it falls short. An example or two helps."
            ></textarea>
          </label>
        </div>
        <div class="cf-foot">
          <button class="wipe" type="submit">
            <span class="wipe-fill"></span>
            <span class="wipe-label">Send message</span>
            <span class="wipe-label" aria-hidden="true">→</span>
          </button>
          <p class="cf-status" id="contact-form-status" aria-live="polite"></p>
        </div>
      </form>

      <aside class="ways">
        <div class="way rv" data-rv style="--rv-delay:80ms">
          <h2>Prefer email?</h2>
          <p>Write to us directly.</p>
          <a class="quiet" href={`mailto:${EMAIL}`}>{EMAIL}<span aria-hidden="true">→</span></a>
        </div>
        <div class="way rv" data-rv style="--rv-delay:140ms">
          <h2>Prefer to talk?</h2>
          <p>Book thirty minutes to talk the problem through.</p>
          <a class="quiet" href="#book">Pick a time<span aria-hidden="true">↓</span></a>
        </div>
      </aside>
    </div>
  </section>

  <!-- ═══ BOOK A CALL ════════════════════════════════════════════ -->
  <section class="band band-tint" id="book">
    <div class="shell">
      <div class="book-head">
        <div>
          <h2 class="h2 rv" data-rv>Or book a 30-minute call.</h2>
          <p class="lede rv" data-rv style="--rv-delay:80ms">Pick any open slot. No form needed.</p>
        </div>
        <a class="quiet rv" data-rv style="--rv-delay:140ms" href={CALENDLY_URL} target="_blank" rel="noopener noreferrer">
          Open in a new tab<span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="cal rv" data-rv style="--rv-delay:120ms">
        <div class="calendly-inline-widget" data-url={CALENDLY_EMBED} data-cal></div>
      </div>
    </div>
  </section>
</V2Layout>

<script is:inline>
  (() => {
    /* ── The form ── */
    const form = document.getElementById('contact-form');
    const status = document.getElementById('contact-form-status');
    const button = form && form.querySelector('button[type="submit"]');
    const apiBaseUrl = (form && form.dataset.apiBaseUrl) || 'http://127.0.0.1:8000';

    const setStatus = (text, state) => {
      status.textContent = text;
      status.dataset.state = state;
    };

    if (form) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const value = (k) => String(data.get(k) ?? '').trim();
        const payload = { name: value('name'), email: value('email'), company: value('company'), message: value('message') };

        button.disabled = true;
        setStatus('Sending…', 'busy');
        try {
          const response = await fetch(`${apiBaseUrl}/api/contact`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!response.ok) throw new Error(`Request failed with status ${response.status}`);
          setStatus(`Sent. We will reply to ${payload.email}.`, 'ok');
          form.reset();
        } catch (error) {
          console.error('Failed to send contact form', error);
          setStatus('Could not send just now. Try again in a minute, or email pranav@mercity.io.', 'error');
        } finally {
          button.disabled = false;
        }
      });
    }

    /* ── The calendar: Calendly's script, fetched once the band is
       within a screen of view. It renders every .calendly-inline-widget
       on load. ── */
    const cal = document.querySelector('[data-cal]');
    if (cal) {
      const load = () => {
        const s = document.createElement('script');
        s.src = 'https://assets.calendly.com/assets/external/widget.js';
        s.async = true;
        document.body.appendChild(s);
      };
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            load();
          }
        },
        { rootMargin: '100% 0px' },
      );
      io.observe(cal);
    }
  })();
</script>

<style>
  .quiet {
    display: inline-flex;
    align-items: center;
    gap: 7.2px;
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
    transition: color 300ms var(--ease);
  }
  .quiet span {
    transition: transform 400ms var(--ease);
  }
  .quiet:hover {
    color: var(--ink);
  }
  .quiet:hover span {
    transform: translateY(2px);
  }
  .quiet[target='_blank']:hover span {
    transform: translate(2px, -2px);
  }

  /* ══ THE FORM, AND WHAT SITS BESIDE IT ═══════════════════════ */
  #message {
    padding-top: clamp(36px, 4vw, 54px);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(36px, 5vw, 72px);
    align-items: start;
  }

  /* The form is one flush object: every field a cell, every edge a
     shared hairline, as in the stat grids. A field's focus draws the
     nav's 1px indigo underline along its bottom edge. */
  .cf {
    background: var(--surface);
    border: 1px solid var(--line-2);
  }
  .cf-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .cf-field {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 20px 16px;
    border-bottom: 1px solid var(--line);
    cursor: text;
    transition: background 300ms var(--ease);
  }
  .cf-field:first-child {
    border-right: 1px solid var(--line);
  }
  .cf-wide {
    grid-column: 1 / -1;
  }
  .cf-field::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--indigo-600);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 500ms var(--ease);
  }
  .cf-field:focus-within {
    background: var(--n-50);
  }
  .cf-field:focus-within::after {
    transform: scaleX(1);
  }
  .cf-label {
    font-family: var(--mono);
    font-size: 10.35px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    transition: color 300ms var(--ease);
  }
  .cf-label i {
    margin-left: 6px;
    font-style: normal;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--n-400);
  }
  .cf-field:focus-within .cf-label {
    color: var(--indigo-600);
  }
  /* Only after the reader has touched a field and left it wrong. */
  .cf-field:has(:user-invalid) .cf-label {
    color: var(--amber-800);
  }
  .cf input,
  .cf textarea {
    width: 100%;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    font-size: 15.3px;
    line-height: 1.6;
    color: var(--ink);
  }
  .cf textarea {
    min-height: 168px;
    resize: vertical;
  }
  .cf input::placeholder,
  .cf textarea::placeholder {
    color: var(--n-400);
    opacity: 1;
  }
  .cf-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 22px;
    padding: 20px;
  }
  button.wipe {
    background: none;
    color: var(--ink);
    font-family: inherit;
    cursor: pointer;
  }
  button.wipe:disabled {
    opacity: 0.5;
    cursor: progress;
  }
  .cf-status {
    font-size: 13.05px;
    line-height: 1.5;
    color: var(--ink-3);
    text-wrap: pretty;
  }
  .cf-status[data-state='ok'] {
    color: var(--teal-700);
  }
  .cf-status[data-state='error'] {
    color: var(--amber-800);
  }

  /* Beside the form: three short blocks on rules. */
  .way {
    padding: 20px 0 22px;
    border-top: 1px solid var(--line);
  }
  .way:last-child {
    border-bottom: 1px solid var(--line);
  }
  .way h2 {
    font-family: var(--hero-serif);
    font-size: 19.8px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.014em;
  }
  .way p {
    margin-top: 8px;
    font-size: 13.05px;
    line-height: 1.7;
    color: var(--ink-3);
  }
  .way .quiet {
    margin-top: 14px;
    text-transform: none;
    letter-spacing: 0.04em;
    font-size: 11.25px;
  }
  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .cf-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .cf-field:first-child {
      border-right: 0;
    }
    .cf-wide {
      grid-column: auto;
    }
  }

  /* ══ BOOK A CALL ═════════════════════════════════════════════ */
  .book-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px 36px;
  }
  .book-head .h2 {
    margin-top: 0;
  }
  /* Calendly draws its own card, so it sits straight on the band. */
  .cal {
    margin-top: 18px;
  }
  .calendly-inline-widget {
    min-width: 320px;
    height: 700px;
  }
</style>
