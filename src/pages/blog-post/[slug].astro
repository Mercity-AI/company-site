---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import V2Layout from '@/layouts/V2Layout.astro';
import Article from '@/components/v2/Article.astro';
import { entryToRow, getPostUrl, sortPostsByPublishedDate } from '@/utils/blog';

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const publishedTimeISO = post.data.publishedAt.toISOString();
const modifiedTimeISO = post.data.updatedAt ? post.data.updatedAt.toISOString() : undefined;
const articlePath = getPostUrl(post);

/* Same category first, then whatever is newest. */
const others = sortPostsByPublishedDate(await getCollection('posts')).filter((p) => p.id !== post.id);
const more = [
  ...others.filter((p) => p.data.category === post.data.category),
  ...others.filter((p) => p.data.category !== post.data.category),
]
  .slice(0, 3)
  .map((p) => entryToRow(p, getPostUrl(p)));
---

<V2Layout
  title={post.data.title}
  description={post.data.summary}
  image={post.data.image}
  path={articlePath}
  type="article"
  publishedTime={publishedTimeISO}
  modifiedTime={modifiedTimeISO}
  author={post.data.authors[0]?.name}
  tags={post.data.tags}
>
  <Article entry={post} backHref="/blog" section="Blog" more={more}>
    <Content />
  </Article>
</V2Layout>
