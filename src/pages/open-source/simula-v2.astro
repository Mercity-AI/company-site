---
/**
 * Simula, second version: told as why and how we built it.
 *
 * A working surface next to /open-source/simula until it replaces it.
 * Every number, example and artifact is from the research log (the
 * 1,000-row job-posting run and the 10K e-commerce run) or the README.
 * The three briefs in step 03 are the log's own example round.
 */
import V2Layout from '@/layouts/V2Layout.astro';
import CoverageTree from '@/components/v2/CoverageTree.astro';

const GITHUB_URL = 'https://github.com/Mercity-AI/Simula';
const PAPER_URL = 'https://arxiv.org/abs/2603.29791';
const LOG_URL = '/research/building-simula-our-synthetic-data-generation-library';
const DEMO_URL = 'https://blog-cdn.mercity.ai/blog/open-source-simula/simula-demo.mp4';


/* What went wrong on client work, and what the library does about it. */
const problems = [
  {
    title: 'Prompting in a loop repeats the common cases.',
    example:
      'Ask for shopping queries and you get four hundred versions of “cheap wireless earbuds” and none about warranty transfers or regional sizing.',
    fix: 'Simula plans the cases before it generates any, so coverage becomes a count. Our 10K run reached 1,739 of the 1,740 leaves it planned.',
    keys: ['taxonomy.json'],
  },
  {
    title: 'The same requirements give the same row.',
    example: 'Every “footwear, known item, negation” request came back as the same shoe query with a different brand.',
    fix: 'Before generating, a model drafts three short briefs for the sampled requirements and one is picked at random. Identical requirements still produce different rows.',
    keys: ['scenarios_per_mix'],
  },
  {
    title: 'Models under-sample what they think is unlikely.',
    example:
      'Our extraction dataset needed far more queries with exclusions than the model considered natural. A moderation classifier needs the hostile queries a model avoids writing.',
    fix: 'Weighted strategies decide which branches are combined and how often. Write guidance for them in plain English, or edit the file and rerun.',
    keys: ['strategies.json', 'strategy.guidance'],
  },
  {
    title: 'Rows that look right and are wrong.',
    example: 'The generator filled in location_state: “Texas” for a job ad that only mentioned Austin.',
    fix: 'A separate critic checks every record against your rules and returns accept or reject with a reason. Rejected records are rewritten from that reason, up to a limit you set.',
    keys: ['critic', 'max_refine_attempts'],
  },
  {
    title: 'Long runs fail near the end.',
    example:
      'Under rate limits, calls hung for over 800 seconds. Our first version was one run away from sending 1,400 reasoning calls at once.',
    fix: 'Concurrency has a hard cap, calls time out after 180 seconds by default, and each finished row is written to disk straight away. A killed run resumes where it stopped.',
    keys: ['concurrency', 'resume'],
  },
];

const briefs = [
  'A runner hunting a specific shoe model they already know, with a hard price cap and one excluded color. Terse keyword phrasing.',
  'Race-week replacement search: brand + waterproof + size, under $80, typed as bare keywords with a negation.',
  'A bargain-hunter comparing two named brands on waterproofing and grip, budget-capped.',
];
const PICKED = 1;

const cli = [
  { cmd: 'validate', body: 'Config, schema subset, roles, prompt module, output path. No model calls.' },
  { cmd: 'taxonomy', body: 'Builds taxonomy.json; auto-accept, write-then-edit, or confirm in the terminal.' },
  { cmd: 'generate', body: 'Taxonomy → strategies → meta-prompts → records. --stop-after halts at any artifact.' },
  { cmd: 'evaluate', body: 'Dedupe, decontaminate, coverage, diversity, complexity. Writes eval_report.json.' },
  { cmd: 'run', body: 'All of the above, end to end.' },
];

const evalSuite = [
  {
    title: 'Dedupe and decontamination',
    body: '13-gram sets, Jaccard overlap at 0.8. Dedupe compares against rows already kept. Decontamination compares against your test set, so no test item ends up in training.',
  },
  {
    title: 'Coverage, two ways',
    body: 'From lineage, which costs nothing. Or by reassignment: the critic places each row on the tree independently, which audits the generator and also works on datasets you did not generate.',
  },
  {
    title: 'Embedding diversity',
    body: 'Global: mean distance across the dataset. Local: mean distance to each row’s ten nearest neighbours. Taxonomy depth raises the first; the briefs raise the second.',
  },
  {
    title: 'Complexity by calibrated Elo',
    body: 'Rated alone, almost everything scores a 7. So the critic ranks five records at a time, and Elo turns those comparisons into one ranking across the dataset.',
  },
];

const stats = [
  { figure: '1,206', label: 'attempts', note: 'of 1,400 planned; the rest killed under rate limits' },
  { figure: '96%', label: 'accept rate', note: '1,157 accepted, trimmed to 1,000' },
  { figure: '100%', label: 'leaf coverage', note: '16/16 · 28/28 · 29/29 · 20/20' },
  { figure: '0', label: 'duplicates', note: 'and 0 rows with empty lineage' },
  { figure: '841', label: 'distinct key-sets', note: 'across 1,000 rows, 6.7 fields avg' },
  { figure: '~4,440', label: 'model calls', note: '3.43M tokens in · 5.57M out' },
  { figure: '84 min', label: 'wall time', note: 'at concurrency 25' },
  { figure: '≈ $2.60', label: 'total cost', note: 'including the taxonomy build' },
];

const limits = [
  'Single-process concurrency, not distributed workers.',
  'A single-pass binary critic, not the paper’s double critic.',
  'Lineage coverage by default; independent reassignment is opt-in.',
  'Complexity Elo is measured but not yet used by any later step.',
];

/* Code samples, pre-tokenised. Keys indigo, values teal, comments quiet:
   the same rule the research log's code blocks follow. */
const treeCode = `<span class="tok-k">product_vertical</span>
├─ <span class="tok-s">footwear</span>
│  ├─ <span class="tok-s">athletic</span>
│  │  ├─ <span class="tok-s">trail_running</span>        <span class="tok-c">← this row</span>
│  │  ├─ road_running
│  │  └─ gym_training
│  └─ casual <span class="tok-c">…</span>
├─ electronics <span class="tok-c">…</span>
└─ apparel <span class="tok-c">…</span>
<span class="tok-k">shopper_intent</span>    <span class="tok-c">…</span>
<span class="tok-k">attribute_focus</span>   <span class="tok-c">…</span>
<span class="tok-k">query_complexity</span>  <span class="tok-c">…</span>`;

const mixCode = `<span class="tok-c"># strategies, by weight</span>
<span class="tok-k">mainstream_purchase</span>  <span class="wbar" style="--w:3"></span> <span class="tok-n">3.0</span>  <span class="tok-c">← drawn</span>
<span class="tok-k">hard_cases</span>           <span class="wbar" style="--w:0.5"></span> <span class="tok-n">0.5</span>
<span class="tok-c">…</span>

<span class="tok-c"># the mix: one node per factor</span>
<span class="tok-k">product_vertical</span>   footwear <span class="tok-c">›</span> athletic <span class="tok-c">›</span> <span class="tok-s">trail_running</span>
<span class="tok-k">shopper_intent</span>     <span class="tok-s">known_item_hunt</span>
<span class="tok-k">attribute_focus</span>    <span class="tok-s">price_and_availability</span>
<span class="tok-k">query_complexity</span>   <span class="tok-s">terse_multi_constraint_with_negation</span>`;

const recordCode = `<span class="tok-k">"query"</span>: <span class="tok-s">"waterproof trail running shoes size 9 under $80, nothing neon"</span>
<span class="tok-k">"extraction"</span>: {
  <span class="tok-k">"category"</span>: <span class="tok-s">"trail running shoes"</span>,
  <span class="tok-k">"waterproof"</span>: <span class="tok-n">true</span>,
  <span class="tok-k">"size"</span>: <span class="tok-s">"9"</span>,
  <span class="tok-k">"price_max"</span>: <span class="tok-n">80</span>,
  <span class="tok-k">"color_excluded"</span>: [<span class="tok-s">"neon"</span>]
}`;

const lineageCode = `<span class="tok-k">"taxonomy_mix"</span>:     [<span class="tok-s">"product_vertical.footwear.athletic.trail_running"</span>, <span class="tok-c">…</span>]
<span class="tok-k">"strategy_id"</span>:      <span class="tok-s">"mainstream_purchase"</span>
<span class="tok-k">"meta_prompt"</span>:      <span class="tok-s">"Race-week replacement search: …"</span>
<span class="tok-k">"generator_model"</span>:  <span class="tok-s">"deepseek/deepseek-v4-flash:nitro"</span>
<span class="tok-k">"critic_verdicts"</span>:  [{ <span class="tok-k">"verdict"</span>: <span class="tok-s">"accept"</span>, <span class="tok-k">"explanation"</span>: <span class="tok-c">…</span> }]
<span class="tok-k">"schema_valid"</span>:     <span class="tok-n">true</span>
<span class="tok-k">"accepted"</span>:         <span class="tok-n">true</span>`;

const yamlCode = `<span class="tok-c"># The minimum viable config. Everything else has a default.</span>
<span class="tok-k">description</span>: <span class="tok-s">"Describe the dataset to generate."</span>

<span class="tok-k">schema</span>:                       <span class="tok-c"># null → free-text mode</span>
  <span class="tok-k">type</span>: <span class="tok-s">object</span>
  <span class="tok-k">required</span>: [<span class="tok-s">"input"</span>, <span class="tok-s">"output"</span>]
  <span class="tok-k">properties</span>:
    <span class="tok-k">input</span>:  { <span class="tok-k">type</span>: <span class="tok-s">string</span> }
    <span class="tok-k">output</span>: { <span class="tok-k">type</span>: <span class="tok-s">string</span> }

<span class="tok-k">provider</span>:
  <span class="tok-k">base_url</span>: <span class="tok-s">"https://openrouter.ai/api/v1"</span>
  <span class="tok-k">api_key_env</span>: <span class="tok-s">"OPENROUTER_API_KEY"</span>   <span class="tok-c"># from .env</span>

<span class="tok-k">models</span>:
  <span class="tok-k">strategic</span>: { <span class="tok-k">model</span>: <span class="tok-s">"google/gemini-3-flash-preview"</span> }
  <span class="tok-k">bulk</span>:      { <span class="tok-k">model</span>: <span class="tok-s">"google/gemini-3-flash-preview"</span> }
  <span class="tok-k">critic</span>:    { <span class="tok-k">model</span>: <span class="tok-s">"google/gemini-3-flash-preview"</span> }`;

const installCode = `<span class="tok-c">$</span> git clone https://github.com/Mercity-AI/Simula
<span class="tok-c">$</span> cd Simula &amp;&amp; python -m pip install -e <span class="tok-s">".[dev]"</span>
<span class="tok-c">$</span> python -m simula.cli run examples/basic_qa.yaml
<span class="tok-c">  # fake model: runs offline, no API key needed</span>`;
---

<V2Layout
  title="Simula: synthetic data generation library"
  description="Simula is the synthetic data pipeline we built for our client work, now open source: coverage planned as a taxonomy, a critic on every record, and lineage on every row. Python, MIT licensed."
  path="/open-source/simula-v2"
  image="/simula-og.jpg"
  noindex
>
  <!-- ═══ HERO ═══════════════════════════════════════════════════ -->
  <section class="hero">
    <div class="shell hero-in">
      <div class="hero-copy">
        <h1 class="rv" data-rv style="--rv-delay:80ms">Open-sourcing the pipeline we use to generate training data for clients.</h1>
        <p class="lede rv" data-rv style="--rv-delay:160ms">
          We’ve generated hundreds of billions of tokens of synthetic data for client projects. We kept running into the
          same problems, so we built an internal pipeline to fix them. Simula is that pipeline.
        </p>
        <div class="hero-actions rv" data-rv style="--rv-delay:240ms">
          <a class="wipe" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
            <span class="wipe-fill"></span>
            <svg class="wipe-label icon" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
            <span class="wipe-label">View on GitHub</span>
            <span class="wipe-label" aria-hidden="true">↗</span>
          </a>
          <a class="quiet" href={LOG_URL}><svg class="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M3.5 1.5h6l3 3v10h-9z"/><path d="M9.5 1.5v3h3"/><path d="M5.5 8h5M5.5 10.5h5M5.5 13h3"/></svg>Read how we built it<span aria-hidden="true">→</span></a>
        </div>
      </div>
      <figure class="plate rv" data-rv data-from="right" style="--rv-delay:200ms">
        <canvas data-backdrop="plate" data-seed="7731" data-dpr="1.3" aria-hidden="true"></canvas>
        <span class="plate-word" aria-hidden="true">Simula</span>
      </figure>
    </div>
  </section>

  <!-- ═══ THE MAP ════════════════════════════════════════════════ -->
  <section class="band band-tint" id="map">
    <div class="shell">
      <div class="map-head">
        <div>
          <h2 class="h2 rv" data-rv style="--rv-delay:80ms">Map the space first, then sample it.</h2>
        </div>
        <p class="lede rv" data-rv style="--rv-delay:160ms">
          The description is split into factors of variation, and each factor grows into a tree. Every row takes one node
          from each factor, so the rows reach the rare cases as well as the common ones.
        </p>
      </div>
      <CoverageTree />
    </div>
  </section>

  <!-- ═══ WHY ════════════════════════════════════════════════════ -->
  <section class="band" id="why">
    <div class="shell">
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">We kept fixing the same problems, so we built a library.</h2>
      <p class="lede rv" data-rv style="--rv-delay:160ms">
        Almost every client project we take on starts with generating a dataset, and we were writing the same fixes
        each time. Then we found a
        <a class="inline-link" href={PAPER_URL} target="_blank" rel="noopener noreferrer">Google paper</a> built on most
        of the same ideas and tested past 100M tokens. Simula combines the two, and takes its name from the paper.
      </p>

      <div class="ledger">
        <div class="ledger-head" aria-hidden="true">
          <span>What went wrong</span>
          <span>What Simula does</span>
        </div>
        {
          problems.map((p, i) => (
            <div class="ledger-row rv" data-rv style={`--rv-delay:${Math.min(i, 3) * 60}ms`}>
              <div class="ledger-problem">
                <h3>{p.title}</h3>
                <p class="ledger-ex">{p.example}</p>
              </div>
              <div class="ledger-fix">
                <span class="ledger-label">What Simula does</span>
                <p>{p.fix}</p>
                <ul class="ledger-keys">
                  {p.keys.map((k) => (
                    <li>
                      <code>{k}</code>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ ONE ROW ════════════════════════════════════════════════ -->
  <section class="band band-tint" id="how">
    <div class="shell">
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">How Simula works, step by step.</h2>
      <p class="lede rv" data-rv style="--rv-delay:160ms">
        Every stage writes a file you can open and edit, and a file already on disk is reused on the next run, so hand
        edits are kept. The examples follow one row from a dataset of shopper searches.
      </p>

      <ol class="flow">
        <li class="flow-row rv" data-rv>
          <div class="flow-text">
            <span class="flow-top"><b>01</b> Strategic model</span>
            <h3>Map the space</h3>
            <p>
              The tree grows one level at a time. Each node's children are proposed twice, and a second call merges and
              prunes them. You can stop here, edit the tree by hand and rerun.
            </p>
          </div>
          <div class="flow-art">
            <pre class="code"><code set:html={treeCode} /></pre>
          </div>
        </li>

        <li class="flow-row rv" data-rv>
          <div class="flow-text">
            <span class="flow-top"><b>02</b> Strategic model</span>
            <h3>Pick a mix</h3>
            <p>
              Weighted strategies say which branches go together and how often. Each row draws a strategy, then one node
              per factor. That mix is the spec for one row.
            </p>
          </div>
          <div class="flow-art">
            <pre class="code"><code set:html={mixCode} /></pre>
          </div>
        </li>

        <li class="flow-row rv" data-rv>
          <div class="flow-text">
            <span class="flow-top"><b>03</b> Bulk model</span>
            <h3>Write briefs</h3>
            <p>
              Three briefs are drafted for the mix and one is picked at random, so two rows from the same mix still
              differ. A share you set is then rewritten to be harder.
            </p>
          </div>
          <div class="flow-art">
            <ol class="briefs">
              {
                briefs.map((b, i) => (
                  <li class:list={['brief', { picked: i === PICKED }]}>
                    <span class="brief-n">{i === PICKED ? 'Picked' : `0${i + 1}`}</span>
                    <p>{b}</p>
                  </li>
                ))
              }
            </ol>
          </div>
        </li>

        <li class="flow-row rv" data-rv>
          <div class="flow-text">
            <span class="flow-top"><b>04</b> Bulk and critic models</span>
            <h3>Generate and check</h3>
            <p>
              The record is checked against the schema first, with one repair attempt. Then the critic accepts it or
              rejects it with a reason, and rejected records are rewritten.
            </p>
          </div>
          <div class="flow-art">
            <pre class="code"><code set:html={recordCode} /></pre>
            <ul class="verdicts">
              <li><span>schema</span> valid</li>
              <li><span>critic</span> accept</li>
            </ul>
          </div>
        </li>

        <li class="flow-row rv" data-rv>
          <div class="flow-text">
            <span class="flow-top"><b>05</b> No model call</span>
            <h3>Keep the lineage</h3>
            <p>
              Everything that produced the row is stored on it. The trim reads those paths and keeps the rows that cover
              the most of the tree; the coverage report reads them too.
            </p>
          </div>
          <div class="flow-art">
            <pre class="code"><code set:html={lineageCode} /></pre>
          </div>
        </li>
      </ol>

      <p class="flow-note rv" data-rv>
        Each role takes its own model. The strategic model builds the tree and the strategies once per dataset, so it
        can be a large, expensive one. The bulk and critic models are called thousands of times, so they should be fast
        and cheap.
      </p>
    </div>
  </section>

  <!-- ═══ RUN ════════════════════════════════════════════════════ -->
  <section class="band" id="run">
    <div class="shell run">
      <div class="run-copy">
        <h2 class="h2 rv" data-rv style="--rv-delay:80ms">One YAML per run. Five commands.</h2>
        <p class="lede rv" data-rv style="--rv-delay:160ms">
          A run needs a description and a model for each role. Everything else has a default, and a bad value fails when
          the config loads, before any model call. Start with twenty rows: our twenty-row test cost thirty cents and
          caught a concurrency bug before the 1,000-row run.
        </p>
        <pre class="code rv" data-rv style="--rv-delay:220ms"><code set:html={installCode} /></pre>
        <ol class="cli rv" data-rv style="--rv-delay:280ms">
          {
            cli.map((c) => (
              <li>
                <code>simula {c.cmd}</code>
                <span>{c.body}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="run-side">
        <figure class="term rv" data-rv data-from="right" style="--rv-delay:160ms">
          <video
            data-demo
            src={DEMO_URL}
            poster="/simula-demo-poster.jpg"
            muted
            loop
            playsinline
            preload="none"
            width="1010"
            height="830"
          ></video>
          <figcaption>
            <code>simula run</code> on the 10K e-commerce config, building the taxonomy. 53 seconds, muted.
          </figcaption>
        </figure>
        <pre class="code rv" data-rv data-from="right" style="--rv-delay:240ms"><code set:html={yamlCode} /></pre>
      </div>
    </div>
  </section>

  <!-- ═══ EVALUATION ═════════════════════════════════════════════ -->
  <section class="band band-tint" id="evaluation">
    <div class="shell">
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">Evaluation reads the dataset. It never writes to it.</h2>
      <p class="lede rv" data-rv style="--rv-delay:160ms">
        <code>evaluate</code> reads <code>dataset.final.jsonl</code> and writes its results to separate files. We kept the
        two apart because an evaluation bug that rewrites a shipped dataset cannot be undone.
      </p>
      <div class="suite">
        {
          evalSuite.map((e, i) => (
            <div class="suite-item rv" data-rv style={`--rv-delay:${120 + i * 70}ms`}>
              <h3>{e.title}</h3>
              <p>{e.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ NUMBERS ════════════════════════════════════════════════ -->
  <section class="band" id="numbers">
    <div class="shell">
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">A thousand rows, logged in full.</h2>
      <p class="lede rv" data-rv style="--rv-delay:160ms">
        Job-posting extraction, with a different set of keys on almost every row. The provider rate-limited the last 194
        attempts, so we killed the run: 1,157 rows were already accepted, more than the 1,000 we needed.
      </p>
      <dl class="stats rv" data-rv style="--rv-delay:200ms">
        {
          stats.map((s) => (
            <div class="stat">
              <dt>{s.label}</dt>
              <dd>
                <span class="stat-figure">{s.figure}</span>
                <span class="stat-note">{s.note}</span>
              </dd>
            </div>
          ))
        }
      </dl>
      <div class="limits rv" data-rv style="--rv-delay:260ms">
        <h3>Pilot scale, on purpose.</h3>
        <ul>
          {limits.map((l) => <li>{l}</li>)}
        </ul>
        <p>
          Next is batched and multi-turn generation, and a warning when a run finishes under its target. Every
          stage, including what did not work, is in <a href={LOG_URL}>the research log</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ CLOSER ═════════════════════════════════════════════════ -->
  <section class="band band-tint closer">
    <div class="shell closer-in">
      <div>
        <h2 class="rv" data-rv>Run it on your data.</h2>
        <p class="rv" data-rv style="--rv-delay:100ms">
          The offline example runs every stage with a stand-in model, so you can try it with no API key and nothing to
          pay. When you want it on your own data, we can help you set it up, or generate large synthetic datasets for
          you.
        </p>
      </div>
      <div class="closer-actions rv" data-rv style="--rv-delay:200ms">
        <a class="wipe" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
          <span class="wipe-fill"></span>
