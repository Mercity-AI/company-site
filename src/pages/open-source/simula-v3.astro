/**
 * Simula, third pass (2026-11-13). Pranav: "Can you redo the simula page
 * on our site? Ts old and doesn't look good", copy and style both.
 *
 * The open-source page system. Service pages own the pinned scroll
 * hero, the strata grounds and the frosted closer; open-source pages
 * use none of them. Instead:
 *   - A one-viewport hero on the home page's `contour` map (the
 *     generator its open-source cards use), faded out under the copy,
 *     with a small live graphic of the product on it. Here: records
 *     landing on the map as teal squares.
 *   - The clone command as a CTA with a copy button, beside GitHub.
 *   - Plain grounds: no shaders, strata or dot grids.
 *   - Drawn figures for each step of how it works.
 * Rejected on 2026-11-13 (Harsh): the full pipeline diagram in the
 * hero ("a little too much upfront"), a dot-grid ground, and a repo
 * bar with licence, version and the arXiv link. The arXiv paper is
 * Google's, which Simula is named after, not ours.
 *   - A terminal closer that types out the install and first run.
 * Keep these for the next open-source page (PromptKeep) and nowhere
 * else.
 *
 * Facts come from the `optimizations` branch of Mercity-AI/Simula
 * (README, DOCS.md, notes/CHANGELOG.md, notes/testing-notes.md,
 * examples/support_tickets.yaml), as of commit 0073402:
 *   - 10,000-row e-commerce run (2026-06-25): 13,000 attempts, 10,985
 *     accepted, 10,000 final; ~$4.79 strategic build + ~$16.9 for
 *     generation (48,447 calls), ~$22 in all; ~5 h at 48 concurrent
 *     calls; 9,625 distinct key-sets; 0 empty lineage; 5 exact
 *     duplicate queries.
 *   - 1,000-row job-posting run (2026-06-14): 100% leaf coverage on all
 *     four factors (16, 28, 29, 20 leaves).
 *   - November support-ticket benchmark: about $0.85 per 1,000 tickets
 *     on the combined path with the critic on, 95–97% accepted; with
 *     situations, no near-duplicates in 10,000 tickets for about 4% of
 *     the run's cost, Vendi 42 → 51 at 1,000.
 *   - The strategy skew warning text is the one DOCS.md prints.
 * Illustrative: the hero's records and verdicts, the situations list,
 * the critic exchange and the coverage comparison. Factor names and
 * level-1 nodes are from the ticket example's config; the trees show
 * three branches of each factor.
 *
 * Copy is scanned against the Claudisms banlist: no em dashes in copy,
 * no "real", "worth", "honest", "quietly", "carry", "hold". Rescan
 * after edits.
 */
import V2Layout from '@/layouts/V2Layout.astro';

const GITHUB_URL = 'https://github.com/Mercity-AI/Simula';
const SERVICE_URL = '/services/synthetic-data';
const DOCS_URL = 'https://simula.readthedocs.io/en/latest/index.html';
const INSTALL = 'pip install simula-gen';

const GH_PATH =
  'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z';

/* ── The tree both figures draw: five factors from the ticket example,
   three level-1 nodes each, three leaves under each node. ── */
const TREE = [
  { f: 'category', short: 'category', b: ['billing', 'bug_report', 'how_to'] },
  { f: 'priority', short: 'priority', b: ['low', 'high', 'urgent'] },
  { f: 'sentiment', short: 'sentiment', b: ['neutral', 'frustrated', 'angry'] },
  { f: 'customer_context', short: 'customer', b: ['free', 'pro', 'enterprise'] },
  { f: 'ticket_style', short: 'style', b: ['chat fragment', 'standard message', 'log-heavy report'] },
];
const R3 = [0, 1, 2];
const curve = (x1: number, y1: number, x2: number, y2: number) => {
  const m = (x1 + x2) / 2;
  return `M${x1} ${y1}C${m} ${y1} ${m} ${y2} ${x2} ${y2}`;
};
type Geo = { root: [number, number]; fx: number; fy0: number; fdy: number; bx: number; bdy: number; lx: number; ldy: number; row?: boolean };
const layout = (g: Geo) =>
  TREE.map((t, i) => {
    const fy = g.fy0 + i * g.fdy;
    return {
      ...t,
      i,
      fy,
      root: curve(g.root[0], g.root[1], g.fx, fy),
      branches: t.b.map((name, j) => {
        const by = fy + (j - 1) * g.bdy;
        return {
          name,
          j,
          by,
          link: curve(g.fx, fy, g.bx, by),
          // In a row, a branch's three leaves sit side by side on its
          // line; otherwise they fan out in a short column.
          leaves: R3.map((k) => {
            if (g.row) {
              const lx = g.lx + k * 14;
              return { k, lx, ly: by, link: `M${g.bx} ${by}H${lx - 4}` };
            }
            const ly = by + (k - 1) * g.ldy;
            return { k, lx: g.lx, ly, link: curve(g.bx, by, g.lx - 3, ly) };
          }),
        };
      }),
    };
  });

/* Hero: records landing across the map. A jittered 12 × 7 grid over
   the right of the hero, so the squares spread evenly; the script
   reveals them in a fixed shuffle. Seeded, so the picture is stable. */
const DOTS = (() => {
  let t = 2611;
  const rnd = () => (t = (t * 1103515245 + 12345) % 2147483648) / 2147483648;
  const out: { x: number; y: number; o: number }[] = [];
  for (let r = 0; r < 7; r++)
    for (let c = 0; c < 12; c++) {
      if (rnd() < 0.18) continue;
      out.push({ x: 470 + c * 42 + (rnd() - 0.5) * 26, y: 70 + r * 72 + (rnd() - 0.5) * 34, o: rnd() });
    }
  return out.sort((a, b) => a.o - b.o).map((d, k) => ({ ...d, k }));
})();
// Each square links to the two nearest squares already down, if they
// are close, so the map fills as one connected net.
const LINKS = DOTS.flatMap((d) =>
  DOTS.filter((e) => e.k < d.k)
    .map((e) => ({ e, dist: Math.hypot(e.x - d.x, e.y - d.y) }))
    .filter((c) => c.dist < 110)
    .sort((a, b) => a.dist - b.dist)
    .slice(0, 2)
    .map(({ e }) => ({ k: d.k, x1: e.x, y1: e.y, x2: d.x, y2: d.y })),
);

/* Walkthrough tree, in a 720 × 430 viewBox. Step 3 lights one path
   per factor; `pick` is the level-1 node and `leaf` its leaf label. */
const SG: Geo = { root: [26, 215], fx: 160, fy0: 35, fdy: 90, bx: 300, bdy: 26, lx: 410, ldy: 0, row: true };
const stageTree = layout(SG);
const PICK = [
  { j: 0, leaf: 'charged for removed seats' },
  { j: 1, leaf: 'team blocked before a client deadline' },
  { j: 1, leaf: 'second follow-up' },
  { j: 1, leaf: 'agency owner · writer picks below' },
  { j: 1, leaf: 'short, two paragraphs' },
];

/* ── The problem. 240 tickets dropped onto a map of the ticket
   example's eight categories, twice: asked of a model directly, they
   pile up in a few places; sampled from Simula's map, they cover
   every category evenly. Positions are seeded, so the picture is
   stable. Illustrative. ── */
const CATS = ['billing', 'account_access', 'bug_report', 'outage_performance', 'how_to', 'feature_request', 'integrations_api', 'security_privacy'];
const ZW = 140;
const ZH = 160;
const ZY = 18;
const zone = (c: number) => ({ x: (c % 4) * ZW, y: ZY + Math.floor(c / 4) * ZH });
const scatter = (counts: number[], spread: number, seed: number) => {
  let t = seed;
  const rnd = () => (t = (t * 1103515245 + 12345) % 2147483648) / 2147483648;
  const gauss = () => Math.sqrt(-2 * Math.log(rnd() || 1e-9)) * Math.cos(6.2832 * rnd());
  const dots: { x: number; y: number; d: number }[] = [];
  counts.forEach((n, c) => {
    const z = zone(c);
    const cx = z.x + ZW * (0.36 + rnd() * 0.28);
    const cy = z.y + ZH * (0.42 + rnd() * 0.2);
    for (let k = 0; k < n; k++) {
      let x;
      let y;
      if (spread) {
        // Even cover: a jittered grid over the zone.
        const cols = 6;
        const r = Math.floor(k / cols);
        const rows = Math.ceil(n / cols);
        x = z.x + 16 + ((k % cols) + 0.5) * ((ZW - 32) / cols) + (rnd() - 0.5) * 12;
        y = z.y + 34 + (r + 0.5) * ((ZH - 50) / rows) + (rnd() - 0.5) * 12;
      } else {
        x = cx + gauss() * 7;
        y = cy + gauss() * 6;
      }
      dots.push({ x: +x.toFixed(1), y: +y.toFixed(1), d: Math.round(rnd() * 900) });
    }
  });
  return dots;
};
const piles = [
  {
    name: 'Prompting a model directly',
    dots: scatter([152, 61, 18, 0, 9, 0, 0, 0], 0, 4021),
    reached: 4,
    foot: '152 tickets are one billing complaint, reworded',
    notes: [
      { c: 0, t: '“billed twice”', sub: '×152' },
      { c: 1, t: '“can’t log in”', sub: '×61' },
    ],
  },
  {
    name: 'Sampling from Simula’s map',
    dots: scatter([30, 30, 30, 30, 30, 30, 30, 30], 1, 7753),
    reached: 8,
    foot: '30 tickets in every category, each about something different',
    sim: true,
    notes: [
      { c: 6, t: '“duplicate webhook”' },
      { c: 1, t: '“SSO login loop”' },
      { c: 7, t: '“SOC 2 audit logs”' },
    ],
  },
];

/* ── How it works: six steps. ── */
const steps = [
  {
    title: 'Map the space',
    role: 'strategic model',
    body: 'The strategic model reads your description, lists the factors the data should vary along, and grows each factor into a tree of subtopics. Each level is reviewed before the next is built. You can also write the factors yourself.',
    file: 'taxonomy.json',
  },
  {
    title: 'Decide how often',
    role: 'strategic model',
    body: 'Strategies set how often each branch is used and which combinations are never allowed. Before generating anything, Simula runs 5,000 test draws and warns you when a strategy pushes a factor more than 5 points away from the weights you set.',
    file: 'strategies.json',
  },
  {
    title: 'Pick what each record is about',
    role: 'code',
    body: 'For every record, code picks one branch from each factor’s tree, by weight. The model never chooses the topic, which is what keeps coverage even. You can stop code at a level and let the writer pick the details below it.',
    file: 'taxonomy_mix',
  },
  {
    title: 'Give each record its own case',
    role: 'bulk model',
    body: 'Records on the same branch tend to tell the same obvious story. Simula writes a list of distinct situations for each branch in one call, and every record gets its own. In one of our runs this removed near-duplicates from 10,000 records for about 4% extra cost.',
    file: 'situations.jsonl',
  },
  {
    title: 'Write against a schema',
    role: 'bulk model',
    body: 'The bulk model writes each record from its picks and its situation, one at a time or five per call. Every record must match your JSON schema. A record that fails is repaired once, then dropped.',
    file: 'dataset.raw.jsonl',
  },
  {
    title: 'Judge, refine, trim',
    role: 'critic model',
    body: 'The critic model accepts or rejects each record and gives a reason. Rejected records are fixed and checked again. Simula then removes duplicates and trims the set to your target size, keeping the records that cover branches nothing else covers.',
    file: 'dataset.final.jsonl',
  },
];

// The skew example from DOCS.md: 5,000 test mixes against tree weights.
const skew = [
  { name: 'low', mix: 23, tree: 30 },
  { name: 'medium', mix: 26, tree: 35 },
  { name: 'high', mix: 38, tree: 25, warn: true },
  { name: 'urgent', mix: 13, tree: 10 },
];

const situations = [
  'An agency removed six seats mid-cycle and the next invoice still billed all twenty.',
  'A contractor’s seat is still charged a week after the admin deleted the account.',
  'A downgrade from Pro left three guest seats on the annual renewal.',
  'Two workspaces were merged and the removed members are billed in both.',
];

const mixIn = [
  ['category', 'billing › seat changes › charged for removed seats'],
  ['priority', 'high › team blocked before a client deadline'],
  ['sentiment', 'frustrated › second follow-up'],
  ['customer_context', 'pro › agency owner'],
  ['situation', 'An agency removed six seats mid-cycle…'],
];
const record = [
  { k: 'subject', v: '"Still billed for removed seats"' },
  { k: 'body', v: '"Following up again. We removed 6 seats on the 3rd…"' },
  { k: 'channel', v: '"email"' },
  { k: 'customer_tier', v: '"pro"' },
  { k: 'category', v: '"billing"' },
  { k: 'priority', v: '"high"' },
  { k: 'sentiment', v: '"frustrated"' },
  { k: 'escalate', v: 'false' },
];

const funnel = [
  { label: 'attempts', n: 13000 },
  { label: 'accepted', n: 10985 },
  { label: 'final', n: 10000 },
];

/* ── Model roles and the 10,000-row run's bill. ── */
const roles = [
  { name: 'Strategic model', does: 'Builds the tree and the strategies.', when: 'Runs once per dataset. A strong model costs little here.' },
  { name: 'Bulk model', does: 'Writes the situations and the records, and fixes rejected ones.', when: 'Runs for every record and uses most of the tokens. A fast, lighter model works.' },
  { name: 'Critic model', does: 'Accepts or rejects each record and says why.', when: 'Runs for every record, and again after each fix.' },
];
const BILL = { plan: 4.79, write: 16.9 };
const billTotal = BILL.plan + BILL.write;

/* ── Lineage: one row of dataset.final.jsonl, values shortened. ── */
const lineage = [
  { k: 'id', v: '"row-04812"' },
  { k: 'record', v: '{ ticket: {…}, labels: {…} }', dim: true },
  { k: 'taxonomy_mix', v: '{ category: "billing › seat changes › …", … }', hl: true },
  { k: 'strategy_id', v: '"billing_heavy"', hl: true },
  { k: 'meta_prompt', v: '"Plan: a second follow-up from an agency owner…"', hl: true },
  { k: 'generator_model', v: '"deepseek/deepseek-v4-flash"', hl: true },
  { k: 'critic_verdicts', v: '[{ verdict: "accept", explanation: "…" }]', hl: true },
  { k: 'schema_valid', v: 'true' },
  { k: 'accepted', v: 'true' },
];
const files = [
  { f: 'taxonomy.json', d: 'The tree and its node weights', stop: true },
  { f: 'strategies.json', d: 'Weights and banned combinations', stop: true },
  { f: 'situations.jsonl', d: 'One situation per record' },
  { f: 'meta_prompts.jsonl', d: 'One writing plan per record', stop: true },
  { f: 'dataset.final.jsonl', d: 'The rows, with lineage' },
  { f: 'llm_calls.jsonl', d: 'Every prompt and response, as it returns' },
  { f: 'eval_report.json', d: 'Dedupe, coverage, diversity' },
  { f: 'cost_summary.json', d: 'Tokens and spend by role and task' },
];

/* ── Measured. ── */
const measured = [
  { fig: '42 → 51', line: 'Vendi diversity score of 1,000 tickets, before and after situations', src: 'Ticket benchmark, Nov 2026' },
  { fig: '96%', line: 'of 10,000 search-extraction rows have a unique set of keys (9,625)', src: 'E-commerce run, DeepSeek V4' },
  { fig: '0', line: 'near-duplicates in 10,000 tickets with situations on, for about 4% extra cost', src: 'Ticket benchmark, Nov 2026' },
  { fig: '$0.85', line: 'per 1,000 tickets, five per call with the critic on, 95–97% accepted', src: 'Ticket benchmark, GLM 5.3 Flash' },
  { fig: '100%', line: 'of the tree’s leaves covered in a 1,000-row run, on all four factors', src: 'Job-posting run' },
  { fig: '0', line: 'rows without lineage in either run; 5 exact duplicates in 10,000', src: 'Both runs, audited' },
];
const limits = [
  { t: 'Coverage counts what was requested.', d: 'The default report checks which branches each record was asked to cover. Set coverage_mode: reassign to have the critic check each record independently.' },
  { t: 'A label can disagree with its text.', d: 'A record can read differently from the label it was given. Run a pilot of 5–7% of the target and check the labels.' },
  { t: 'Runs on one machine.', d: 'Generation runs in parallel on one machine, not across a cluster. Every role calls an OpenAI-compatible chat endpoint.' },
  { t: 'CLI only, text only.', d: 'No web UI, database or training harness.' },
];

const commands = [
  { c: 'simula validate config.yaml', d: 'Checks the config and schema. No model calls.' },
  { c: 'simula taxonomy config.yaml', d: 'Builds the tree, so you can read it first.' },
  { c: 'simula generate config.yaml --stop-after strategies', d: 'Stops once strategies are written. Edit, then rerun.' },
  { c: 'simula generate config.yaml', d: 'Picks up from the files on disk and writes the rows.' },
  { c: 'simula evaluate config.yaml', d: 'Dedupe, coverage and the eval report.' },
];

const term = [
  { p: '$', t: INSTALL },
  { p: '#', t: 'quickstart.yaml from the docs: every role on the fake model', c: true },
  { p: '$', t: 'simula run quickstart.yaml' },
  { p: '›', t: 'Building taxonomy', o: true },
  { p: '', t: 'Taxonomy: 2 factors, depth 2', o: true },
  { p: '›', t: 'Generating 7 attempts (target 5)', o: true },
  { p: '', t: 'Accepted 7 → 5 final (target 5, trim enabled)', o: true },
  { p: '', t: 'Run complete: 5 final records', o: true },
  { p: '', t: 'Artifacts: runs/quickstart', o: true },
];
---

<V2Layout
  title="Simula: open-source synthetic data generation"
  description="Simula maps the space of a dataset as a taxonomy, samples every record from that map, has a critic judge each one and keeps the lineage of every row. Python, MIT licensed."
  path="/open-source/simula-v3"
  image="/simula-og.jpg"
  noindex
>
  <!-- ═══ HERO: the map, and records landing on it ══════════════════ -->
  <section class="os-hero">
    <canvas class="os-map" data-backdrop="contour" data-seed="2611" data-dpr="1" aria-hidden="true"></canvas>
    <svg class="os-dots" data-dots viewBox="0 0 1000 600" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
      <g class="os-links">
        {LINKS.map((l) => <line x1={l.x1.toFixed(1)} y1={l.y1.toFixed(1)} x2={l.x2.toFixed(1)} y2={l.y2.toFixed(1)} pathLength="1" data-k={l.k} />)}
      </g>
      {DOTS.map((d) => <rect x={(d.x - 5).toFixed(1)} y={(d.y - 5).toFixed(1)} width="10" height="10" data-k={d.k} />)}
    </svg>
    <div class="shell os-in">
      <div class="os-copy">
        <h1 class="rv" data-rv style="--rv-delay:80ms"><span>Generate synthetic data</span> <span>with complete domain</span> <span>coverage - with <em>Simula</em></span></h1>
        <p class="rv" data-rv style="--rv-delay:160ms">
          Simula is a state-of-the-art synthetic data framework. Describe the data you need in one paragraph, and it
          maps every case the dataset should cover, has a model write each record, has a second model check it, and
          saves where every row came from.
        </p>
        <div class="os-actions rv" data-rv style="--rv-delay:240ms">
          <a class="wipe" href={DOCS_URL} target="_blank" rel="noopener noreferrer">
            <span class="wipe-fill"></span>
            <span class="wipe-label">Read the docs</span>
            <span class="wipe-label" aria-hidden="true">↗</span>
          </a>
          <button class="clone" type="button" data-copy={INSTALL} aria-label="Copy the install command">
            <code><span>$</span> {INSTALL}</code>
            <span class="clone-ic"><svg class="ic-copy" viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" /><path d="M10.5 3.5v-1h-8v8h1" /></svg><svg class="ic-done" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" /></svg></span>
          </button>
        </div>
        <div class="os-more rv" data-rv style="--rv-delay:320ms">
          <a class="quiet" href={GITHUB_URL} target="_blank" rel="noopener noreferrer"><svg class="gh" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d={GH_PATH} /></svg>View on GitHub<span aria-hidden="true">↗</span></a>
          <a class="quiet" href="#how">How it works<span aria-hidden="true">↓</span></a>
        </div>
        <p class="os-proof rv" data-rv style="--rv-delay:380ms">
          Generate 10,000 training records for about $22.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ HOW IT WORKS: a pinned walkthrough ═══════════════════════ -->
  <section class="band paper paper-tint" id="how">
    <div class="shell">
      <div class="split-head">
        <h2 class="h2 rv" data-rv style="--rv-delay:80ms">How Simula builds a dataset.</h2>
      </div>

      <div class="how" data-how>
        <div class="how-pin">
          <div class="stage" data-stage data-step="0" data-vsticky="96">
            <div class="stage-bar">
              <span class="stage-file" data-stage-file>{steps[0].file}</span>
              <span class="stage-dots" aria-hidden="true">
                {steps.map((_, i) => <i class:list={[i === 0 && 'is-on']} data-stage-dot />)}
              </span>
            </div>

            <!-- 01 and 03 share the tree -->
            <div class="stage-tree" aria-hidden="true">
              <svg viewBox="0 0 720 430">
                <circle class="st-nd lv0" cx={SG.root[0]} cy={SG.root[1]} r="5" />
                {
                  stageTree.map((f, i) => (
                    <g class:list={['st-f', `f${i}`]}>
                      <path class="st-ln lv1" d={f.root} />
                      {f.branches.map((b) => (
                        <g class:list={['st-b', PICK[i].j === b.j && 'is-pick']}>
                          <path class="st-ln lv2" d={b.link} />
                          {b.leaves.map((l) => (
                            <path class:list={['st-ln lv3', PICK[i].j === b.j && l.k === 1 && 'is-pick']} d={l.link} />
                          ))}
                        </g>
                      ))}
                    </g>
                  ))
                }
                {
                  stageTree.map((f, i) => (
                    <g class:list={['st-f', `f${i}`]}>
                      <circle class="st-nd lv1" cx={SG.fx} cy={f.fy} r="4.5" />
                      <text class="st-lf lv1" x={SG.fx} y={f.fy - 11} text-anchor="middle">{f.f}</text>
                      {f.branches.map((b) => (
                        <g class:list={['st-b', PICK[i].j === b.j && 'is-pick']}>
                          <circle class="st-nd lv2" cx={SG.bx} cy={b.by} r="3.5" />
                          <text class="st-lb lv2" x={SG.bx + 8} y={b.by - 5}>{b.name}</text>
                          {b.leaves.map((l) => (
                            <rect class:list={['st-leaf lv3', PICK[i].j === b.j && l.k === 1 && 'is-pick']} x={l.lx - 3} y={l.ly - 3} width="6" height="6" />
                          ))}
