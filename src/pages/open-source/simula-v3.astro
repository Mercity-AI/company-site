<script is:inline>
  /* ── Copy buttons: the repo bar's clone command and the terminal. ── */
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    const label = btn.querySelector('[data-copy-label]');
    btn.addEventListener('click', () => {
      navigator.clipboard?.writeText(btn.dataset.copy).then(() => {
        btn.dataset.copied = 'true';
        if (label) label.textContent = 'copied';
        setTimeout(() => {
          delete btn.dataset.copied;
          if (label) label.textContent = 'copy';
        }, 1600);
      });
    });
  });

  /* ── Hero: records land on the map one at a time, in the shuffle
     the frontmatter set; once all are down they hold, clear and start
     again. Runs only on screen. Reduced motion shows them all. ── */
  (() => {
    const svg = document.querySelector('[data-dots]');
    if (!svg) return;
    const dots = [...svg.querySelectorAll('rect')].sort((a, b) => a.dataset.k - b.dataset.k);
    const links = [...svg.querySelectorAll('line')];
    const linksOf = dots.map((_, k) => links.filter((l) => +l.dataset.k === k));
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      [...dots, ...links].forEach((d) => d.classList.add('is-on'));
      return;
    }
    let n = 0;
    let timer = 0;
    let running = false;
    const tick = () => {
      if (!running) return;
      if (n < dots.length) {
        dots[n].classList.add('is-on', 'is-new');
        linksOf[n].forEach((l) => l.classList.add('is-on'));
        if (n) dots[n - 1].classList.remove('is-new');
        n += 1;
        timer = setTimeout(tick, 650);
      } else {
        dots[n - 1].classList.remove('is-new');
        timer = setTimeout(() => {
          svg.classList.add('is-clearing');
          timer = setTimeout(() => {
            [...dots, ...links].forEach((d) => d.classList.remove('is-on'));
            svg.classList.remove('is-clearing');
            n = 0;
            timer = setTimeout(tick, 700);
          }, 900);
        }, 5000);
      }
    };
    new IntersectionObserver((e) => {
      const on = e[0].isIntersecting;
      if (on === running) return;
      running = on;
      clearTimeout(timer);
      if (on) timer = setTimeout(tick, 1400);
    }).observe(svg);
  })();

  /* ── Play once: [data-play] gets data-on when well in view. ── */
  (() => {
    const els = [...document.querySelectorAll('[data-play]')];
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      els.forEach((el) => (el.dataset.on = 'true'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.dataset.on = 'true';
          io.unobserve(e.target);
        }),
      { threshold: 0.35 }
    );
    els.forEach((el) => io.observe(el));
  })();

  /* ── The walkthrough: the step whose text sits nearest the stage's
     middle is current, once the first step passes 70% of the screen. ── */
  (() => {
    const how = document.querySelector('[data-how]');
    if (!how) return;
    const stage = how.querySelector('[data-stage]');
    const steps = [...how.querySelectorAll('[data-how-step]')];
    const dots = [...stage.querySelectorAll('[data-stage-dot]')];
    const file = stage.querySelector('[data-stage-file]');
    const names = steps.map((s) => s.querySelector('.how-file').textContent);
    let cur = -1;
    const update = () => {
      const vh = window.innerHeight;
      const sr = stage.getBoundingClientRect();
      const mid = sr.height && sr.top < vh ? sr.top + sr.height / 2 : vh * 0.5;
      let best = 0;
      let bestD = Infinity;
      steps.forEach((s, i) => {
        const r = s.getBoundingClientRect();
        if (r.top > vh * 0.7) return;
        const d = Math.abs(r.top + Math.min(r.height, 200) / 2 - mid);
        if (d < bestD) {
          bestD = d;
          best = i;
        }
      });
      if (best === cur) return;
      cur = best;
      stage.dataset.step = String(best);
      steps.forEach((s, i) => s.classList.toggle('is-on', i === best));
      dots.forEach((d, i) => d.classList.toggle('is-on', i <= best));
      file.textContent = names[best];
    };
    let raf = 0;
    const req = () => {
      if (!raf)
        raf = requestAnimationFrame(() => {
          raf = 0;
          update();
        });
    };
    window.addEventListener('scroll', () => (document.documentElement.dataset.vscroll ? null : req()), { passive: true });
    window.addEventListener('v2scroll', req);
    window.addEventListener('resize', req);
    update();
  })();

</script>

