    gap: 7.2px;
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
    transition: color 300ms var(--ease);
  }
  .quiet span {
    transition: transform 400ms var(--ease);
  }
  .quiet:hover {
    color: var(--vi-700);
  }
  .quiet:hover span {
    transform: translate(2px, 2px);
  }
  figure figcaption,
  .cov-note,
  .scene-foot {
    font-family: var(--mono);
    font-size: 10.35px;
    line-height: 1.65;
    color: var(--ink-3);
  }

  /* ══ HERO ════════════════════════════════════════════════════
     One viewport. The home page's `contour` map fills it, faded out
     under the copy, and records land on it as teal squares. */
  .os-hero {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: calc(100vh - var(--nav-h));
    min-height: calc(100svh - var(--nav-h));
    background: var(--n-50);
  }
  .os-map,
  .os-dots {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .os-map {
    opacity: 0.62;
    -webkit-mask-image: linear-gradient(100deg, transparent 22%, #000 62%);
    mask-image: linear-gradient(100deg, transparent 22%, #000 62%);
  }
  .os-dots {
    -webkit-mask-image: linear-gradient(100deg, transparent 38%, #000 58%);
    mask-image: linear-gradient(100deg, transparent 38%, #000 58%);
  }
  .os-links line {
    stroke: var(--teal-500);
    stroke-width: 1.2;
    stroke-opacity: 0.55;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 900ms var(--ease);
  }
  .os-links line.is-on {
    stroke-dashoffset: 0;
  }
  .os-dots.is-clearing line {
    stroke-opacity: 0;
    transition: stroke-opacity 800ms;
  }
  .os-dots rect {
    fill: var(--teal-500);
    stroke: var(--surface);
    stroke-width: 2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.3);
    transition:
      opacity 500ms var(--ease),
      transform 500ms var(--ease),
      fill 600ms var(--ease);
  }
  .os-dots rect.is-on {
    opacity: 1;
    transform: none;
  }
  .os-dots rect.is-new {
    fill: var(--vi);
    transform: scale(1.35);
  }
  .os-dots.is-clearing rect {
    opacity: 0;
    transition-duration: 800ms;
  }
  .os-in {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: 48px 72px;
  }
  .os-copy {
    max-width: 820px;
  }
  /* The headline says what Simula is; the hook under it is the
     measured claim (Hopkins: specifics over slogans). */
  .os-copy h1 {
    max-width: none;
    font-family: var(--hero-serif);
    font-size: clamp(34px, 3.9vw, 54px);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  /* Three lines of about equal length (Harsh: no short last line,
     a line is full or about three quarters): "Generate synthetic
     data" / "with complete domain" / "coverage - with Simula", the
     name in italic indigo. Below 720px the lines wrap freely. */
  .os-copy h1 em {
    font-style: italic;
    color: var(--indigo-600);
  }
  @media (min-width: 720px) {
    .os-copy h1 span {
      display: block;
      white-space: nowrap;
    }
  }
  .os-copy p {
    margin-top: 26px;
    max-width: 52ch;
    font-size: clamp(15px, 1.3vw, 16.4px);
    line-height: 1.74;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .os-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 16px;
    margin-top: 34px;
  }
  .gh {
    width: 14px;
    height: 14px;
  }
  .quiet .gh {
    width: 13px;
    height: 13px;
    color: var(--ink);
  }
  /* The install command: dark, like a terminal line, with a copy icon
     that turns into a tick once copied. Same height as the button. */
  .clone {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    max-width: 100%;
    padding: 12px 12px 12px 16px;
    background: var(--n-900);
    border: 1px solid var(--n-900);
    font: inherit;
    color: #fff;
    cursor: pointer;
    transition: background 300ms var(--ease);
  }
  .clone code {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 12px;
    color: #fff;
  }
  .clone code span {
    color: hsl(172 60% 64%);
  }
  .clone-ic {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    color: hsl(0 0% 100% / 0.6);
    transition: color 300ms var(--ease);
  }
  .clone-ic svg {
    grid-area: 1 / 1;
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity 250ms var(--ease),
      transform 250ms var(--ease);
  }
  .clone .ic-done {
    opacity: 0;
    transform: scale(0.6);
    stroke: hsl(172 60% 64%);
    stroke-width: 1.8;
  }
  .clone[data-copied] .ic-copy {
    opacity: 0;
    transform: scale(0.6);
  }
  .clone[data-copied] .ic-done {
    opacity: 1;
    transform: none;
  }
  .clone:hover {
    background: var(--navy);
  }
  .clone:hover .clone-ic {
    color: #fff;
  }
  .os-proof {
    margin-top: 22px !important;
    max-width: 60ch;
    font-family: var(--mono);
    font-size: 10.8px !important;
    line-height: 1.7 !important;
    color: var(--ink-3) !important;
  }
  .os-more {
    display: flex;
    gap: 28px;
    margin-top: 30px;
  }
  @media (max-width: 760px) {
    .os-map {
      -webkit-mask-image: linear-gradient(180deg, transparent 40%, #000 85%);
      mask-image: linear-gradient(180deg, transparent 40%, #000 85%);
    }
    .os-dots {
      display: none;
    }
  }

  /* ══ THE PROBLEM ═════════════════════════════════════════════
     240 tickets fall onto the eight categories. On the left they pile
     into dark blobs and most of the map stays empty; on the right they
     cover it evenly. A few callouts say what the tickets are. */
  .pile {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 46px;
  }
  .pile-panel {
    padding: 22px 22px 18px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .pile-panel.is-sim {
    border-color: var(--ink);
  }
  .pile-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 14px;
  }
  .pile-name {
    font-family: var(--hero-serif);
    font-size: 21px;
    color: var(--ink);
  }
  .pile-count {
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--ink-3);
  }
  .pile-count b {
    font-family: var(--hero-serif);
    font-size: 24px;
    font-weight: 400;
    color: var(--ink);
  }
  .is-sim .pile-count b {
    color: var(--teal-700);
  }
  .pile svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--mono);
  }
  .pz rect {
    fill: var(--n-50);
    stroke: var(--line);
  }
  .pz text {
    font-size: 9.6px;
    fill: var(--ink-3);
  }
  .pd circle {
    fill: var(--teal-500);
    fill-opacity: 0.5;
    transform: translate(var(--dx), var(--dy)) scale(0.2);
    opacity: 0;
    transition:
      transform 900ms var(--ease) var(--d),
      opacity 400ms var(--ease) var(--d);
  }
  .pile-panel:not(.is-sim) .pd circle {
    fill: hsl(248 20% 40%);
    fill-opacity: 0.35;
  }
  .pile[data-on='true'] .pd circle {
    transform: none;
    opacity: 1;
  }
  .pn rect {
    fill: var(--surface);
    stroke: var(--ink);
    stroke-width: 0.8;
  }
  .pn text {
    font-size: 9.8px;
    fill: var(--ink);
  }
  .pn tspan {
    fill: var(--amber-800);
    font-weight: 600;
  }
  .is-sim .pn text {
    fill: var(--teal-800);
  }
  .pn {
    opacity: 0;
    transition: opacity 500ms var(--ease);
  }
  .pile[data-on='true'] .pn {
    opacity: 1;
    transition-delay: calc(1500ms + var(--i) * 200ms);
  }
  .pile-foot {
    margin-top: 12px;
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--ink-3);
  }
  .pile-note {
    margin-top: 12px;
    font-family: var(--mono);
    font-size: 10.35px;
    color: var(--ink-3);
  }
  @media (max-width: 860px) {
    .pile {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ══ HOW IT WORKS ════════════════════════════════════════════ */
  .how {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(28px, 4vw, 64px);
    margin-top: 46px;
  }
  .how-pin {
    position: relative;
  }
  .stage {
    position: sticky;
    top: 96px;
    height: min(560px, calc(100vh - 140px));
    background: var(--surface);
    border: 1px solid var(--line-2);
    box-shadow: 0 30px 70px -52px hsl(250 40% 20% / 0.4);
    overflow: hidden;
  }
  :global(html[data-vscroll]) .stage {
    position: relative;
    top: 0;
  }
  .stage-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 42px;
    padding: 0 20px;
    border-bottom: 1px solid var(--line);
  }
  .stage-file {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--vi-700);
  }
  .stage-dots {
    display: flex;
    gap: 6px;
  }
  .stage-dots i {
    width: 18px;
    height: 2px;
    background: var(--line-2);
    transition: background 400ms var(--ease);
  }
  .stage-dots i.is-on {
    background: var(--vi);
  }
  .scene,
  .stage-tree {
    position: absolute;
    inset: 42px 0 0;
    padding: 30px 34px 24px;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition:
      opacity 450ms var(--ease),
      transform 450ms var(--ease),
      visibility 0s linear 450ms;
  }
  .stage-tree {
    padding: 34px 30px 52px;
    justify-content: center;
  }
  .stage-tree svg {
    width: 100%;
    height: 100%;
    font-family: var(--mono);
  }
  .stage[data-step='0'] [data-scene='0'],
  .stage[data-step='1'] [data-scene='1'],
  .stage[data-step='2'] [data-scene='2'],
  .stage[data-step='3'] [data-scene='3'],
  .stage[data-step='4'] [data-scene='4'],
  .stage[data-step='5'] [data-scene='5'],
  .stage[data-step='0'] .stage-tree,
  .stage[data-step='2'] .stage-tree {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 450ms var(--ease) 120ms,
      transform 450ms var(--ease) 120ms,
      visibility 0s;
  }
  .scene-foot {
    margin-top: auto;
    padding-top: 14px;
  }
  .scene-title {
    margin-bottom: 18px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink-2);
  }
  /* Children of the current scene arrive one after another. */
  .scene li,
  .scene .vd {
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 400ms var(--ease),
      transform 400ms var(--ease);
  }
  .stage[data-step='1'] [data-scene='1'] li,
  .stage[data-step='3'] [data-scene='3'] li,
  .stage[data-step='4'] [data-scene='4'] li,
  .stage[data-step='5'] [data-scene='5'] li,
  .stage[data-step='5'] [data-scene='5'] .vd {
    opacity: 1;
    transform: none;
    transition-delay: calc(200ms + var(--i) * 90ms);
  }

  /* 01 / 03: the tree. On 01 it grows level by level; on 03 one path
     per factor lights and every other branch steps back. */
  .st-ln {
    fill: none;
    stroke: var(--n-300);
    stroke-width: 1;
    transition:
      opacity 500ms var(--ease),
      stroke 400ms var(--ease),
      stroke-width 400ms var(--ease);
  }
  .st-nd {
    fill: var(--surface);
    stroke: var(--n-300);
    stroke-width: 1.2;
    transition: all 400ms var(--ease);
  }
  .st-nd.lv0 {
    fill: var(--vi);
    stroke: var(--vi);
  }
  .st-root,
  .st-lf {
    font-size: 12px;
    font-weight: 600;
    fill: var(--vi-700);
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4px;
  }
  .st-lb {
    font-size: 11px;
    fill: var(--ink-3);
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4px;
    transition: fill 400ms var(--ease);
  }
  .st-leaf {
    fill: var(--surface);
    stroke: var(--n-300);
    transition: all 400ms var(--ease);
  }
  .st-pick {
    font-size: 11.5px;
    fill: var(--teal-700);
    opacity: 0;
    transition: opacity 400ms var(--ease);
  }
  .stage .lv0,
  .stage .lv1,
  .stage .lv2,
  .stage .lv3 {
    opacity: 0;
  }
  .stage[data-step='0'] .lv0,
  .stage[data-step='0'] .lv1,
  .stage[data-step='0'] .lv2,
  .stage[data-step='0'] .lv3,
  .stage[data-step='2'] .lv0,
  .stage[data-step='2'] .lv1,
  .stage[data-step='2'] .lv2,
  .stage[data-step='2'] .lv3 {
    opacity: 1;
  }
  .stage[data-step='0'] .lv1 {
    transition-delay: 350ms;
  }
  .stage[data-step='0'] .lv2 {
    transition-delay: 750ms;
  }
  .stage[data-step='0'] .lv3 {
    transition-delay: 1150ms;
  }
  .stage[data-step='2'] .st-b:not(.is-pick) .st-ln,
  .stage[data-step='2'] .st-b:not(.is-pick) .st-nd,
  .stage[data-step='2'] .st-b:not(.is-pick) .st-leaf,
  .stage[data-step='2'] .st-b .st-ln.lv3:not(.is-pick),
  .stage[data-step='2'] .st-b .st-leaf:not(.is-pick) {
    opacity: 0.22;
  }
  .stage[data-step='2'] .st-f > .st-ln.lv1,
  .stage[data-step='2'] .st-b.is-pick > .st-ln.lv2,
  .stage[data-step='2'] .st-ln.lv3.is-pick {
    stroke: var(--vi);
    stroke-width: 2;
  }
  .stage[data-step='2'] .st-f > .st-nd.lv1,
  .stage[data-step='2'] .st-b.is-pick > .st-nd {
    fill: var(--vi);
    stroke: var(--vi);
  }
  .stage[data-step='2'] .st-b.is-pick > .st-lb {
    fill: var(--ink);
  }
  .stage[data-step='2'] .st-leaf.is-pick {
    fill: var(--teal-500);
    stroke: var(--teal-500);
  }
  .stage[data-step='2'] .st-pick {
    opacity: 1;
    transition-delay: 500ms;
  }

  /* 02 skew */
  .skew li {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr) 132px;
    gap: 14px;
    align-items: center;
    padding: 12px 0;
    font-family: var(--mono);
    font-size: 13px;
  }
  .skew-track {
    position: relative;
    height: 18px;
    background: var(--n-100);
  }
  .skew-bar {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--w) * 2%);
    background: var(--teal-500);
  }
  .is-warn .skew-bar {
    background: var(--amber-500);
  }
  .skew-tree {
    position: absolute;
    top: -5px;
    bottom: -5px;
    left: calc(var(--t) * 2%);
    width: 2px;
    background: var(--ink);
  }
  .skew-n small {
    color: var(--ink-3);
    font-size: 10.5px;
  }
  .skew-warn {
    margin-top: 18px;
    padding: 12px 14px;
    background: var(--amber-100);
    border-left: 2px solid var(--amber-500);
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.6;
    color: var(--amber-800);
  }

  /* 04 situations: one leaf, a rail, four cases branching off it. */
  .sit-leaf {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .sit-leaf i {
    font-style: normal;
  }
  .sit-leaf b {
    font-weight: 500;
    color: var(--teal-700);
  }
  .sit-sq {
    width: 10px;
    height: 10px;
    background: var(--teal-500);
  }
  .sits {
    margin: 4px 0 0 4px;
    padding-top: 6px;
    border-left: 1px solid var(--vi-200);
  }
  .sits li {
    position: relative;
    margin: 12px 0 0 28px;
    padding: 12px 16px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
    background: var(--n-50);
    border: 1px solid var(--line);
  }
  .sits li::before {
    content: '';
    position: absolute;
    left: -29px;
    top: 50%;
    width: 28px;
    border-top: 1px solid var(--vi-200);
  }
  .sits .is-pick {
    color: var(--ink);
    background: var(--surface);
    border-color: var(--vi);
  }
  .sits .is-pick::before {
    border-top: 2px solid var(--vi);
  }
  .sits em {
    display: block;
    margin-top: 4px;
    font-style: normal;
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--vi-700);
  }

  /* 05 write: ingredients in, fields out, each ticked. */
  .wr {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 40px minmax(0, 1.1fr);
    gap: 12px;
    align-items: center;
  }
  .wr-in li {
    padding: 8px 10px;
    margin-bottom: 6px;
    background: var(--n-50);
    border-left: 2px solid var(--vi);
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.45;
    color: var(--teal-700);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .wr-in li span {
    display: block;
    font-size: 9.9px;
    color: var(--vi-700);
  }
  .wr-arrow {
    width: 40px;
    height: 200px;
  }
  .wr-arrow path {
    fill: none;
    stroke: var(--vi-200);
    stroke-width: 1.2;
  }
  .wr-out {
    padding: 10px 14px;
    border: 1px solid var(--ink);
  }
  .wr-out li {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) 14px;
    gap: 8px;
    align-items: center;
    padding: 6px 0;
    border-bottom: 1px dashed var(--line);
    font-family: var(--mono);
    font-size: 11.5px;
  }
  .wr-out li:last-child {
    border-bottom: 0;
  }
  .wr-k {
    color: var(--vi-700);
  }
  .wr-v {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--teal-700);
  }
  .wr-out svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: var(--teal-500);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 06 judge */
  .verdicts {
    display: grid;
    gap: 8px;
  }
  .vd {
    padding: 12px 16px;
    font-size: 14.6px;
    line-height: 1.55;
    color: var(--ink-2);
    border-left: 2px solid var(--line-2);
    background: var(--n-50);
  }
  .vd b {
    display: block;
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 500;
    color: var(--ink);
  }
  .vd-no {
    border-left-color: var(--amber-500);
  }
  .vd-yes {
    border-left-color: var(--teal-500);
  }
  .vd-yes b {
    color: var(--teal-700);
  }
  .funnel {
    margin-top: 22px;
  }
  .funnel li {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr) 64px;
    gap: 12px;
    align-items: center;
    padding: 7px 0;
    font-family: var(--mono);
    font-size: 12.4px;
  }
  .funnel-track {
    height: 12px;
  }
  .funnel-bar {
    display: block;
    height: 100%;
    width: calc(var(--w) * 1%);
    background: var(--teal-500);
  }
  .funnel-n {
    text-align: right;
    color: var(--ink);
  }

  /* Steps: tall enough that each takes its turn at the stage. */
  .how-steps {
    padding-bottom: 18vh;
  }
  .how-step {
    min-height: 62vh;
    padding-top: 6px;
    opacity: 0.38;
    transition: opacity 450ms var(--ease);
  }
  .how-step:first-child {
    min-height: 44vh;
  }
