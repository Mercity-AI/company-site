---
import BaseLayout from '@/layouts/BaseLayout.astro';

const tools = [
  {
    name: 'Simula',
    slug: 'simula',
    tagline: 'Deliberate synthetic data generation',
    summary:
      'A compact, CLI-first Python library for schema-shaped and free-text synthetic data. Simula maps the concept space before sampling it — taxonomies as coverage maps, weighted sampling strategies, generator–critic loops, and full lineage on every row.',
    language: 'Python',
    license: 'MIT',
    github: 'https://github.com/Mercity-AI/Simula',
  },
];
---

<BaseLayout
  title="Open Source"
  description="Tools we built for our own work and released under permissive licenses — synthetic data generation, and more on the way."
  path="/open-source"
  hideNavOnScroll
>
  <div class="max-w-5xl mx-auto px-6 py-12">
    <div class="mb-24 pt-12">
      <h1 class="text-6xl md:text-8xl font-serif italic text-slate-900 mb-6 opacity-90">Open Source</h1>
      <p class="text-slate-500 max-w-xl text-lg font-light">
        Tools we built because our own work demanded them, then released so yours doesn't have to. Permissively
        licensed, deliberately small, maintained in production.
      </p>
    </div>

    <div class="space-y-20">
      {
        tools.map((tool) => (
          <article class="group block border-t border-slate-200 pt-12 article-reveal" data-article-reveal>
            <a href={`/open-source/${tool.slug}`} class="grid grid-cols-1 md:grid-cols-12 gap-6" data-astro-prefetch>
              <div class="md:col-span-3 text-sm text-slate-400 font-mono flex flex-col gap-2">
                <span>{tool.language}</span>
                <span>{tool.license} License</span>
              </div>
              <div class="md:col-span-9">
                <h2 class="text-2xl md:text-4xl font-light text-slate-900 mb-2 group-hover:text-indigo-900 transition-colors leading-tight">
                  {tool.name}
                </h2>
                <p class="text-sm font-mono uppercase tracking-widest text-slate-400 mb-4">{tool.tagline}</p>
                <p class="text-slate-500 font-light text-lg leading-relaxed max-w-3xl mb-6">{tool.summary}</p>
                <div class="flex items-center gap-2 text-sm font-medium uppercase tracking-widest text-slate-900 opacity-0 transform -translate-x-4 group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300 mt-4">
                  View Tool <span class="text-lg">→</span>
                </div>
              </div>
            </a>
          </article>
        ))
      }
    </div>

    <div class="border-t border-slate-200 mt-20 pt-12">
      <p class="text-slate-500 font-light text-lg max-w-2xl">
        Everything here ships from
        <a
          href="https://github.com/Mercity-AI/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-900 underline underline-offset-4 hover:text-indigo-900 transition-colors"
        >
          github.com/Mercity-AI</a
        >. The reasoning behind each release lives in
        <a href="/research" class="text-slate-900 underline underline-offset-4 hover:text-indigo-900 transition-colors" data-astro-prefetch>
          Research</a
        >.
      </p>
    </div>
  </div>

  <script is:inline data-astro-rerun>
    (() => {
      if (window.__mercityBlogRevealCleanup) {
        window.__mercityBlogRevealCleanup();
      }

      const items = document.querySelectorAll('[data-article-reveal]');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.setAttribute('data-visible', 'true');
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '-50px' },
      );

      items.forEach((item) => observer.observe(item));

      window.__mercityBlogRevealCleanup = () => {
        observer.disconnect();
      };
    })();
  </script>
</BaseLayout>
