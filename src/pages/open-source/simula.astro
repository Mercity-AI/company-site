---
import BaseLayout from '@/layouts/BaseLayout.astro';

const GITHUB_URL = 'https://github.com/Mercity-AI/Simula';
const RESEARCH_LOG_URL = '/research/building-simula-our-synthetic-data-generation-library';

const pipeline = [
  {
    step: '01',
    title: 'Map the space',
    detail: 'Turn an open-ended brief into a taxonomy of the factors that actually matter.',
    artifact: 'taxonomy.json',
    accent: 'text-indigo-500',
  },
  {
    step: '02',
    title: 'Design the mix',
    detail: 'Weight the combinations that belong together before a model generates a word.',
    artifact: 'strategies.json',
    accent: 'text-sky-500',
  },
  {
    step: '03',
    title: 'Generate with intent',
    detail: 'Sample the map, write a local meta-prompt, and produce schema-safe records.',
    artifact: 'dataset.raw.jsonl',
    accent: 'text-emerald-500',
  },
  {
    step: '04',
    title: 'Critique & refine',
    detail: 'Put every record through validation, criticism, repair, and acceptance.',
    artifact: 'dataset.final.jsonl',
    accent: 'text-fuchsia-500',
  },
  {
    step: '05',
    title: 'Prove the result',
    detail: 'Dedupe, measure coverage, and keep the lineage that explains every row.',
    artifact: 'eval_report.json',
    accent: 'text-amber-500',
  },
];

const roles = [
  {
    name: 'strategic',
    color: 'text-indigo-600',
    label: 'The thinker',
    calls: '~65 calls per run',
    detail:
      'Factor discovery, taxonomy expansion, strategy generation. Called rarely, so it can afford to be an expensive reasoning model — its decisions amortize across every row.',
  },
  {
    name: 'bulk',
    color: 'text-sky-600',
    label: 'The workhorse',
    calls: 'Thousands of calls',
    detail:
      'Meta-prompts, complexification, record generation, repairs, refinements. Called constantly, so it should be fast and cheap. This is where volume lives.',
  },
  {
    name: 'critic',
    color: 'text-emerald-600',
    label: 'The judge',
    calls: 'One verdict per record',
    detail:
      'Semantic critique, complexity scoring, coverage reassignment. Runs at low temperature for consistent, strict verdicts. Models judge better than they generate — the pipeline leans on that gap.',
  },
];

const evalSuite = [
  {
    title: 'Dedupe & decontamination',
    detail:
      '13-gram Jaccard overlap against kept rows and against your test set. If your domain has a benchmark, decontamination is not optional.',
  },
  {
    title: 'Coverage, two ways',
    detail:
      'Lineage-based coverage is free and trusts the generator. LLM reassignment costs a call per row and trusts nothing — and it works on datasets you didn’t generate.',
  },
  {
    title: 'Embedding diversity',
    detail:
      'Global diversity asks whether the dataset spans the space. Local diversity asks whether nearby records are actually different. The two disagree in instructive ways.',
  },
  {
    title: 'Complexity via calibrated Elo',
    detail:
      'Models are better at comparing than scoring, so records are ranked through batched comparisons stitched into one global rating — the chess system, applied to data.',
  },
];

const heroYaml = `<span class="tok-c"># one config, one command</span>
<span class="tok-k">description</span>: <span class="tok-s">&gt;</span>
<span class="tok-s">  E-commerce search queries paired with</span>
<span class="tok-s">  their parsed, structured extractions.</span>

<span class="tok-k">models</span>:
  <span class="tok-k">strategic</span>: <span class="tok-s">"deepseek-v4-pro"</span>   <span class="tok-c"># thinks once</span>
  <span class="tok-k">bulk</span>:      <span class="tok-s">"deepseek-v4-flash"</span> <span class="tok-c"># the workhorse</span>
  <span class="tok-k">critic</span>:    <span class="tok-s">"deepseek-v4-flash"</span> <span class="tok-c"># the judge</span>

<span class="tok-k">generation</span>:
  <span class="tok-k">target_size</span>: <span class="tok-n">10000</span>
  <span class="tok-k">complexity_ratio</span>: <span class="tok-n">0.3</span>  <span class="tok-c"># fraction pushed harder</span>
  <span class="tok-k">concurrency</span>: <span class="tok-n">48</span>`;

const yamlConfig = `<span class="tok-c"># One YAML per run. Bad config fails at load, not mid-run.</span>
<span class="tok-k">description</span>: <span class="tok-s">"E-commerce search-query extraction"</span>

<span class="tok-k">schema</span>:
  <span class="tok-k">type</span>: <span class="tok-s">object</span>
  <span class="tok-k">required</span>: [<span class="tok-s">"query"</span>, <span class="tok-s">"extraction"</span>]

<span class="tok-k">generation</span>:
  <span class="tok-k">target_size</span>: <span class="tok-n">10000</span>
  <span class="tok-k">scenarios_per_mix</span>: <span class="tok-n">3</span>    <span class="tok-c"># local diversity</span>
  <span class="tok-k">complexity_ratio</span>: <span class="tok-n">0.3</span>  <span class="tok-c"># fraction pushed harder</span>
  <span class="tok-k">concurrency</span>: <span class="tok-n">48</span>`;

const lineageJson = `{
  <span class="tok-k">"record"</span>: {
    <span class="tok-k">"query"</span>: <span class="tok-s">"waterproof trail shoes size 9 under $80, no neon"</span>,
    <span class="tok-k">"extraction"</span>: { <span class="tok-k">"category"</span>: <span class="tok-s">"trail running shoes"</span>, <span class="tok-s">…</span> }
  },
  <span class="tok-k">"taxonomy_mix"</span>: [<span class="tok-s">"footwear &rarr; athletic &rarr; trail_running"</span>, <span class="tok-s">"..."</span>],
  <span class="tok-k">"strategy_id"</span>: <span class="tok-s">"mainstream_purchase"</span>,
  <span class="tok-k">"meta_prompt"</span>: <span class="tok-s">"Race-week replacement search: brand + ..."</span>,
  <span class="tok-k">"complexified"</span>: <span class="tok-n">true</span>,
  <span class="tok-k">"critic_verdicts"</span>: [{ <span class="tok-k">"verdict"</span>: <span class="tok-s">"accept"</span> }],
  <span class="tok-k">"accepted"</span>: <span class="tok-n">true</span>
}`;

const recordJson = `<span class="text-slate-800">"waterproof trail running shoes size 9 under $80, nothing neon"</span>
<span class="tok-c">&#123; <span class="tok-k">"category"</span>: <span class="tok-s">"trail running shoes"</span>, <span class="tok-k">"waterproof"</span>: <span class="tok-n">true</span>, <span class="tok-k">"size"</span>: <span class="tok-s">"9"</span>,
  <span class="tok-k">"price_max"</span>: <span class="tok-n">80</span>, <span class="tok-k">"color_excluded"</span>: [<span class="tok-s">"neon"</span>] &#125;</span>`;
---

<BaseLayout
  title="Simula — Deliberate Synthetic Data Generation"
  description="Simula is a compact, CLI-first Python library for schema-shaped and free-text synthetic data. Map the concept space first, then sample it on purpose. MIT licensed."
  path="/open-source/simula"
  image="/simula-og.jpg"
  hideNavOnScroll
>
  <div class="max-w-[92rem] mx-auto px-6 lg:px-[3.25rem] py-12">
    <!-- Hero -->
    <header class="relative isolate grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-12 items-center mb-28 pt-8 lg:min-h-[calc(100svh-16rem)]">
      <!-- frosted glow orbs -->
      <div class="absolute inset-0 -z-10 pointer-events-none" aria-hidden="true">
        <div class="hero-orb absolute -top-64 right-[16%] w-[36rem] h-[36rem] rounded-full bg-indigo-400/[0.225] blur-[110px] motion-safe:animate-[orb-drift-a_22s_ease-in-out_infinite]"></div>
        <div class="hero-orb absolute top-[58%] left-[34%] w-[26rem] h-[26rem] rounded-full bg-sky-300/[0.27] blur-[100px] motion-safe:animate-[orb-drift-b_26s_ease-in-out_infinite]"></div>
        <div class="hero-orb absolute top-[22%] -left-32 w-80 h-80 rounded-full bg-fuchsia-300/[0.18] blur-[90px]"></div>
      </div>
      <div>
        <p class="font-mono text-xs text-slate-500 mb-10">Python&ensp;·&ensp;MIT License&ensp;·&ensp;pip install simula</p>
        <h1 class="text-[clamp(2rem,8.4vw,3rem)] sm:text-[3.2rem] md:text-[3.75rem] lg:text-[clamp(2.6rem,4.2vw,4.05rem)] font-serif italic font-light text-slate-900 leading-[1.05] tracking-tight mb-8">
          High-quality synthetic data<br />
          <span class="whitespace-nowrap">with measurable coverage.</span>
        </h1>
        <p class="text-slate-500 font-light text-lg leading-relaxed max-w-md mb-10">
          Simula is a CLI-first Python library that turns a written brief into a schema-validated, critic-reviewed
          dataset.
        </p>
        <div class="flex flex-wrap items-center gap-4 mb-8">
          <a
            href={GITHUB_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-6 py-3 text-xs font-semibold uppercase tracking-wider bg-slate-900 text-white rounded-full hover:bg-indigo-900 transition-all duration-300"
          >
            <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
            View on GitHub
          </a>
          <a
            href={RESEARCH_LOG_URL}
            class="inline-flex items-center px-6 py-3 text-xs font-semibold uppercase tracking-wider bg-slate-900 text-white rounded-full hover:bg-indigo-900 transition-all duration-300"
            data-astro-prefetch
          >
            Read the Research Log
          </a>
        </div>
      </div>

      <!-- config.yaml card -->
      <div class="hidden lg:block">
        <div class="code-paper rounded-xl overflow-hidden shadow-lg shadow-indigo-900/5 max-w-xl ml-auto" data-demo-card>
          <div class="flex items-center justify-between px-5 py-3 border-b border-[#e8e4d8]">
            <span class="font-mono text-xs text-slate-500">config.yaml</span>
            <span class="font-mono text-xs text-slate-400" data-demo-label>the whole interface</span>
          </div>
          <div class="relative overflow-hidden transition-[height] duration-300 ease-out" data-demo-body>
            <pre class="p-6 overflow-x-auto text-[13px] leading-relaxed transition-opacity duration-200" data-demo-config><code set:html={heroYaml} /></pre>
            <video
              class="hidden absolute inset-0 w-full h-full object-cover bg-[#0a1020]"
              data-demo-video
              src="https://blog-cdn.mercity.ai/blog/open-source-simula/simula-demo.mp4"
              muted
              loop
              playsinline
              preload="metadata"
              aria-label="Recorded terminal session of simula run generating a dataset"
            ></video>
          </div>
          <button
            type="button"
            class="w-full flex items-center justify-between gap-4 px-5 py-2.5 border-t border-[#e8e4d8] cursor-pointer hover:bg-[#f3efe3] transition-colors duration-200"
            data-demo-toggle
            aria-pressed="false"
          >
            <span class="font-mono text-xs text-slate-600">$ simula run config.yaml</span>
            <span
              class="inline-flex items-center rounded-full bg-indigo-600 px-3.5 py-1.5 font-mono text-xs text-white"
              data-demo-glyph
            >⏎ run</span>
          </button>
        </div>
      </div>
    </header>

    <!-- The premise -->
    <section class="border-t border-slate-200 pt-16 mb-28">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <div class="md:col-span-5">
          <p class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">The premise</p>
          <h2 class="text-3xl md:text-4xl font-light text-slate-900 leading-tight">
            Random prompting samples what the model finds probable. That's not your dataset.
          </h2>
        </div>
        <div class="md:col-span-6 md:col-start-7">
          <p class="text-slate-500 font-light text-lg leading-relaxed mb-6">
            Prompt a model in a loop and it clusters around semantic modes: four hundred variations of "cheap wireless
            earbuds," zero queries about warranty transfers or regional sizing. The edges of the space — the cases your
            model will actually fail on — never show up.
          </p>
          <p class="text-slate-500 font-light text-lg leading-relaxed">
            Simula's fix is structural. Decompose the domain into factors of variation, expand each into a taxonomy,
            and sample data points as deliberate mixes of taxonomy nodes. Diversity stops being a hope and becomes a
            number: combinations covered over combinations that exist.
          </p>
        </div>
      </div>
    </section>

    <!-- See it run -->
    <section class="mb-28">
      <p class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-8">See it run</p>
      <video
        class="block w-full max-w-4xl mx-auto h-auto rounded-xl shadow-xl shadow-slate-900/10"
        data-demo-strip
        src="https://blog-cdn.mercity.ai/blog/open-source-simula/simula-demo.mp4"
        muted
        loop
        playsinline
        preload="metadata"
        aria-label="Recorded terminal session: simula run generating and evaluating a dataset"
      ></video>
    </section>

    <!-- Pipeline -->
    <section class="mb-28">
      <p class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-8">The pipeline</p>
      <div class="grid grid-cols-1 md:grid-cols-5 border-y border-slate-200 md:divide-x divide-slate-200">
        {
          pipeline.map((stage) => (
            <div class="py-10 md:px-6 first:md:pl-0 last:md:pr-0 flex flex-col border-t border-slate-200 first:border-t-0 md:border-t-0">
              <span class="font-mono text-xs text-slate-400 mb-12">{stage.step}</span>
              <h3 class="text-lg font-medium text-slate-900 mb-3">{stage.title}</h3>
              <p class="text-sm text-slate-500 font-light leading-relaxed mb-10 flex-grow">{stage.detail}</p>
              <div class="flex items-center gap-2.5">
                <svg class={`w-3.5 h-3.5 ${stage.accent}`} viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 3l9 9M12 5.5V12H5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="font-mono text-xs text-slate-400">{stage.artifact}</span>
              </div>
            </div>
          ))
        }
      </div>
      <p class="text-sm text-slate-400 font-light mt-6 max-w-2xl">
        Every stage writes a human-inspectable artifact. Edit <span class="font-mono text-slate-500">taxonomy.json</span>
        by hand and the pipeline reuses it — thirty seconds of expert review beats any amount of downstream filtering.
      </p>
    </section>

    <!-- One data point, end to end -->
    <section class="pt-8 mb-28">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-12">
        <div class="md:col-span-5">
          <p class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">Anatomy of a data point</p>
          <h2 class="text-3xl md:text-4xl font-light text-slate-900 leading-tight">From sampled mix to accepted record.</h2>
        </div>
        <div class="md:col-span-6 md:col-start-7">
          <p class="text-slate-500 font-light text-lg leading-relaxed">
            No record goes straight from requirements to output. Each sampled mix fans out into multiple meta-prompt
            scenarios — one picked at random — so identical requirements still produce genuinely different records.
            That indirection is what keeps nearby rows from being near-duplicates.
          </p>
        </div>
      </div>

      <div class="bg-white/70 border border-slate-200 rounded-2xl p-6 md:p-12">
        <div class="max-w-4xl">
          <!-- Mix -->
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-slate-400 mb-4">
              <span class="text-indigo-500 font-medium">1</span> · Sampled mix — one node per factor
            </p>
            <div class="flex flex-wrap gap-2">
              <span class="font-mono text-xs bg-sky-50 text-sky-800 border border-sky-100 px-3 py-1.5 rounded-full">
                product_vertical: footwear → trail_running
              </span>
              <span class="font-mono text-xs bg-indigo-50 text-indigo-800 border border-indigo-100 px-3 py-1.5 rounded-full">
                shopper_intent: known_item_hunt
              </span>
              <span class="font-mono text-xs bg-emerald-50 text-emerald-800 border border-emerald-100 px-3 py-1.5 rounded-full">
                attribute_focus: price_and_availability
              </span>
              <span class="font-mono text-xs bg-fuchsia-50 text-fuchsia-800 border border-fuchsia-100 px-3 py-1.5 rounded-full">
                query_complexity: terse_with_negation
              </span>
            </div>
          </div>

          <div class="text-slate-300 py-4 pl-1" aria-hidden="true">↓</div>

          <!-- Meta-prompts -->
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-slate-400 mb-4">
              <span class="text-sky-500 font-medium">2</span> · Meta-prompts — 3 drafted, 1 picked at random
            </p>
            <div class="space-y-3 max-w-2xl">
              <p class="text-sm text-slate-400 font-light border-l-2 border-slate-200 pl-4 leading-relaxed">
                "A runner hunting a specific shoe model they already know, with a hard price cap and one excluded
                color."
              </p>
              <div class="border-l-2 border-indigo-500 pl-4">
                <p class="text-slate-800 font-light leading-relaxed">
                  "Race-week replacement search: brand + waterproof + size, under $80, typed as bare keywords with a
                  negation."
                  <span class="ml-2 inline-block align-middle font-mono text-[10px] uppercase tracking-wider bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded-full">
                    picked
                  </span>
                </p>
              </div>
              <p class="text-sm text-slate-400 font-light border-l-2 border-slate-200 pl-4 leading-relaxed">
                "A bargain-hunter comparing two named brands on waterproofing and grip, budget-capped."
              </p>
            </div>
          </div>

          <div class="flex items-center gap-3 py-4 pl-1" aria-hidden="true">
            <span class="text-slate-300">↓</span>
            <span class="font-mono text-xs text-amber-600/80">complexified at p = 0.3 — more constraints, same requirements</span>
          </div>

          <!-- Record -->
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-slate-400 mb-4">
              <span class="text-amber-500 font-medium">3</span> · Generated record — schema-validated
            </p>
            <div class="code-paper rounded-lg overflow-x-auto max-w-2xl">
              <pre class="p-4 text-[13px] leading-relaxed"><code set:html={recordJson} /></pre>
            </div>
          </div>

          <div class="text-slate-300 py-4 pl-1" aria-hidden="true">↓</div>

          <!-- Critic -->
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-slate-400 mb-4">
              <span class="text-emerald-500 font-medium">4</span> · Critic verdict
            </p>
            <div class="flex flex-wrap items-center gap-3">
              <span class="font-mono text-xs bg-emerald-50 text-emerald-800 border border-emerald-100 px-3 py-1.5 rounded-full">
                accept ✓
              </span>
              <span class="text-sm text-slate-500 font-light">
                Rejections feed up to <span class="font-mono text-xs">max_refine_attempts</span> revisions — or the row
                dies with its reason recorded.
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Model roles -->
    <section class="mb-28">
      <div class="mb-10">
        <p class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">Three model roles</p>
        <h2 class="text-3xl md:text-4xl font-light text-slate-900 leading-tight max-w-3xl">
          Expensive intelligence where it amortizes. Cheap throughput where volume lives.
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 border-y border-slate-200 md:divide-x divide-slate-200">
        {
          roles.map((role) => (
            <div class="py-10 md:px-8 first:md:pl-0 last:md:pr-0 border-t border-slate-200 first:border-t-0 md:border-t-0">
              <div class="flex items-baseline justify-between mb-6">
                <span class={`font-mono text-sm font-medium ${role.color}`}>{role.name}</span>
                <span class="font-mono text-xs text-slate-400">{role.calls}</span>
              </div>
              <h3 class="text-lg font-medium text-slate-900 mb-3">{role.label}</h3>
              <p class="text-sm text-slate-500 font-light leading-relaxed">{role.detail}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Config -->
    <section class="pt-4 mb-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-5 lg:-translate-y-[25%]">
          <p class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3">Configuration</p>
          <h2 class="text-2xl md:text-3xl font-light text-slate-900 leading-tight mb-4">One YAML per run.</h2>
          <p class="text-slate-500 font-light text-base leading-relaxed mb-4">
            Defaults and validation live in one place — a bad <span class="font-mono text-sm">target_size</span> fails
            loudly at load, never as a silent zero-row run. Smoke-test at 20 attempts for thirty cents, then bump the
            target.
          </p>
          <p class="text-slate-500 font-light text-base leading-relaxed">
            Resume reuses every artifact, guarded by a config fingerprint — rows from two different configs can never
            blend silently into one dataset.
          </p>
        </div>
        <div class="lg:col-span-7">
          <div class="code-paper rounded-xl overflow-hidden shadow-sm lg:w-[85%] lg:ml-auto">
            <div class="flex items-center justify-between px-5 py-2 border-b border-[#e8e4d8]">
              <span class="font-mono text-xs text-slate-500">config.yaml</span>
              <span class="font-mono text-xs text-slate-400">abridged</span>
            </div>
            <pre class="p-4 overflow-x-auto text-[12px] leading-relaxed"><code set:html={yamlConfig} /></pre>
            <div class="flex items-center justify-between px-5 py-2 border-t border-[#e8e4d8]">
              <span class="font-mono text-xs text-slate-500">$ simula run config.yaml</span>
              <span class="font-mono text-xs text-slate-400">⏎</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Lineage -->
    <section class="mb-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 order-2 lg:order-1">
          <div class="code-paper rounded-xl overflow-hidden shadow-sm lg:w-[85%]">
            <div class="flex items-center justify-between px-5 py-2 border-b border-[#e8e4d8]">
              <span class="font-mono text-xs text-slate-500">dataset.final.jsonl — one row</span>
