---
/**
 * Simula — the open-source synthetic data library, on the V2 shell.
 *
 * Every number on this page is from the runs written up in the research
 * log (the 1,000-row job-posting run and the 10K e-commerce run); the
 * config, CLI and artifact names are from the README. Nothing is invented.
 */
import V2Layout from '@/layouts/V2Layout.astro';

const GITHUB_URL = 'https://github.com/Mercity-AI/Simula';
const PAPER_URL = 'https://arxiv.org/abs/2603.29791';
const LOG_URL = '/research/building-simula-our-synthetic-data-generation-library';
const DEMO_URL = 'https://blog-cdn.mercity.ai/blog/open-source-simula/simula-demo.mp4';

const facts = ['v0.1.0', 'MIT', 'Python ≥ 3.11', 'arXiv 2603.29791', 'Status: pilot'];

const ideas = [
  {
    title: 'Taxonomies as coverage maps',
    body: 'Decompose the brief into its factors of variation, expand each into a tree of a chosen depth. The leaves are a discrete, enumerable approximation of the concept space — and a denominator.',
  },
  {
    title: 'Generation as sampling over the map',
    body: 'Every row starts as a sampled mix of nodes, one per factor, drawn under weighted strategies that say which combinations belong together. Diversity is fixed before the model sees a prompt.',
  },
  {
    title: 'Quality through generator–critic loops',
    body: 'Models judge better than they produce on the first try. The pipeline leans on that gap twice: refining taxonomy nodes during expansion, and critiquing every record before acceptance.',
  },
];

const stages = [
  { n: '01', title: 'Map the space', body: 'Discover 3–6 factors of variation, or pin your own, then expand each breadth-first to depth.', artifact: 'taxonomy.json' },
  { n: '02', title: 'Design the mix', body: 'Write 2–5 weighted strategies over the tree: which branches combine, and how often.', artifact: 'strategies.json' },
  { n: '03', title: 'Generate with intent', body: 'Sample a mix, draft meta-prompts, complexify some, generate a schema-checked record.', artifact: 'dataset.raw.jsonl' },
  { n: '04', title: 'Critique and refine', body: 'A separate critic accepts or rejects with a reason; rejections feed refinement, up to a cap.', artifact: 'dataset.final.jsonl' },
  { n: '05', title: 'Prove the result', body: 'Dedupe, decontaminate, measure coverage and diversity. Written to its own file, never the dataset.', artifact: 'eval_report.json' },
];

const roles = [
  {
    name: 'strategic',
    label: 'The thinker',
    figure: '~65 calls',
    unit: 'per taxonomy build',
    body: 'Factor discovery, taxonomy expansion, strategy generation. Called rarely, so it can afford to be an expensive reasoning model: its decisions amortize across every row.',
  },
  {
    name: 'bulk',
    label: 'The workhorse',
    figure: 'Thousands',
    unit: 'of calls per run',
    body: 'Meta-prompts, complexification, record generation, JSON repair, refinement. Called constantly, so it should be fast and cheap. This is where volume lives.',
  },
  {
    name: 'critic',
    label: 'The judge',
    figure: '1 verdict',
    unit: 'per record, plus scoring',
    body: 'Semantic critique, optional complexity ranking, optional coverage reassignment. Low temperature for strict, consistent verdicts.',
  },
];

const cli = [
  { cmd: 'validate', body: 'Config, schema subset, roles, prompt module, output path. No model calls.' },
  { cmd: 'taxonomy', body: 'Builds taxonomy.json; auto-accept, write-then-edit, or confirm in the terminal.' },
  { cmd: 'generate', body: 'Taxonomy → strategies → meta-prompts → records. --stop-after halts at any artifact.' },
  { cmd: 'evaluate', body: 'Dedupe, decontaminate, coverage, diversity, complexity. Writes eval_report.json.' },
  { cmd: 'run', body: 'All of the above, end to end.' },
];

const evalSuite = [
  {
    title: 'Dedupe and decontamination',
    body: '13-gram sets, Jaccard overlap at 0.8. Dedupe compares against kept rows; decontamination against your test set. If your domain has a benchmark, this is not optional.',
  },
  {
    title: 'Coverage, two ways',
    body: 'Lineage coverage walks every row’s taxonomy mix and is free. Reassignment asks the critic to place each row on the tree independently — it audits the generator, and works on data you did not generate.',
  },
  {
    title: 'Embedding diversity',
    body: 'Global: mean pairwise distance, did the set span the space. Local: mean distance to the ten nearest neighbours, are nearby rows actually different. The two disagree in instructive ways.',
  },
  {
    title: 'Complexity by calibrated Elo',
    body: 'Rated alone, everything is a 7. So the critic only ever compares — five records at a time — and Elo stitches thousands of local verdicts into one global ranking.',
  },
];

const stats = [
  { figure: '1,206', label: 'attempts', note: 'of 1,400 planned; tail killed in a rate-limit storm' },
  { figure: '96%', label: 'accept rate', note: '1,157 accepted, trimmed to 1,000' },
  { figure: '100%', label: 'leaf coverage', note: '16/16 · 28/28 · 29/29 · 20/20' },
  { figure: '0', label: 'duplicates', note: 'and 0 rows with empty lineage' },
  { figure: '841', label: 'distinct key-sets', note: 'across 1,000 rows, 6.7 fields avg' },
  { figure: '~4,440', label: 'model calls', note: '3.43M tokens in · 5.57M out' },
  { figure: '84 min', label: 'wall time', note: 'concurrency 25, one rate-limit storm' },
  { figure: '≈ $2.60', label: 'total cost', note: 'including the taxonomy build' },
];

const limits = [
  'Single-process concurrency, not distributed workers.',
  'A single-pass binary critic, not the paper’s double critic.',
  'Lineage coverage by default; independent reassignment is opt-in.',
  'Complexity Elo is measured but not yet consumed by any shaping step.',
];

/* Code samples, pre-tokenised. Keys indigo, values teal, comments quiet —
   the same rule the research log's code blocks follow. */
const mixCode = `<span class="tok-k">product_vertical</span>   footwear <span class="tok-c">→</span> athletic <span class="tok-c">→</span> <span class="tok-s">trail_running</span>
<span class="tok-k">shopper_intent</span>     <span class="tok-s">known_item_hunt</span>
<span class="tok-k">attribute_focus</span>    <span class="tok-s">price_and_availability</span>
<span class="tok-k">query_complexity</span>   <span class="tok-s">terse_multi_constraint_with_negation</span>`;

const recordCode = `<span class="tok-k">"query"</span>: <span class="tok-s">"waterproof trail running shoes size 9 under $80, nothing neon"</span>
<span class="tok-k">"extraction"</span>: {
  <span class="tok-k">"category"</span>: <span class="tok-s">"trail running shoes"</span>,
  <span class="tok-k">"waterproof"</span>: <span class="tok-n">true</span>,
  <span class="tok-k">"size"</span>: <span class="tok-s">"9"</span>,
  <span class="tok-k">"price_max"</span>: <span class="tok-n">80</span>,
  <span class="tok-k">"color_excluded"</span>: [<span class="tok-s">"neon"</span>]
}`;

const lineageCode = `<span class="tok-k">"taxonomy_mix"</span>:    [<span class="tok-s">"product_vertical.footwear.athletic.trail_running"</span>, <span class="tok-c">…</span>]
<span class="tok-k">"strategy_id"</span>:     <span class="tok-s">"mainstream_purchase"</span>
<span class="tok-k">"meta_prompt"</span>:     <span class="tok-s">"Race-week replacement search: …"</span>
<span class="tok-k">"complexified"</span>:    <span class="tok-n">true</span>
<span class="tok-k">"critic_verdicts"</span>: [{ <span class="tok-k">"verdict"</span>: <span class="tok-s">"accept"</span> }]
<span class="tok-k">"schema_valid"</span>:    <span class="tok-n">true</span>
<span class="tok-k">"accepted"</span>:        <span class="tok-n">true</span>`;

const yamlCode = `<span class="tok-c"># The minimum viable config. Everything else has a default.</span>
<span class="tok-k">description</span>: <span class="tok-s">"Describe the dataset to generate."</span>

<span class="tok-k">schema</span>:                       <span class="tok-c"># null → free-text mode</span>
  <span class="tok-k">type</span>: <span class="tok-s">object</span>
  <span class="tok-k">required</span>: [<span class="tok-s">"input"</span>, <span class="tok-s">"output"</span>]
  <span class="tok-k">properties</span>:
    <span class="tok-k">input</span>:  { <span class="tok-k">type</span>: <span class="tok-s">string</span> }
    <span class="tok-k">output</span>: { <span class="tok-k">type</span>: <span class="tok-s">string</span> }

<span class="tok-k">provider</span>:
  <span class="tok-k">base_url</span>: <span class="tok-s">"https://openrouter.ai/api/v1"</span>
  <span class="tok-k">api_key_env</span>: <span class="tok-s">"OPENROUTER_API_KEY"</span>   <span class="tok-c"># from .env</span>

<span class="tok-k">models</span>:
  <span class="tok-k">strategic</span>: { <span class="tok-k">model</span>: <span class="tok-s">"google/gemini-3-flash-preview"</span> }
  <span class="tok-k">bulk</span>:      { <span class="tok-k">model</span>: <span class="tok-s">"google/gemini-3-flash-preview"</span> }
  <span class="tok-k">critic</span>:    { <span class="tok-k">model</span>: <span class="tok-s">"google/gemini-3-flash-preview"</span> }`;

const installCode = `<span class="tok-c">$</span> git clone https://github.com/Mercity-AI/Simula
<span class="tok-c">$</span> cd Simula &amp;&amp; python -m pip install -e <span class="tok-s">".[dev]"</span>
<span class="tok-c">$</span> python -m simula.cli run examples/basic_qa.yaml
<span class="tok-c">  # fake model: runs offline, no API key needed</span>`;
---

<V2Layout
  title="Simula — Deliberate synthetic data generation"
  description="Simula is a small, CLI-first Python library for schema-shaped and free-text synthetic data. It maps the concept space as a taxonomy before generating a row, critiques every record, and keeps the lineage. MIT licensed."
  path="/open-source/simula"
  image="/simula-og.jpg"
>
  <!-- ═══ HERO ═══════════════════════════════════════════════════ -->
  <section class="hero">
    <div class="shell hero-in">
      <div class="hero-copy">
        <span class="eyebrow rv" data-rv>Open source <i aria-hidden="true">·</i> Python <i aria-hidden="true">·</i> MIT</span>
        <h1 class="rv" data-rv style="--rv-delay:80ms">Synthetic data with a denominator.</h1>
        <p class="lede rv" data-rv style="--rv-delay:160ms">
          Simula is a small, CLI-first Python library for schema-shaped and free-text datasets. It maps the concept
          space as a taxonomy before it generates a row, samples that map on purpose, critiques every record, and
          keeps the lineage — so coverage is a number you can check, not a feeling.
        </p>
        <div class="hero-actions rv" data-rv style="--rv-delay:240ms">
          <a class="wipe" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
            <span class="wipe-fill"></span>
            <span class="wipe-label">View on GitHub</span>
            <span class="wipe-label" aria-hidden="true">↗</span>
          </a>
          <a class="quiet" href={LOG_URL}>Read the research log<span aria-hidden="true">→</span></a>
        </div>
        <ul class="facts rv" data-rv style="--rv-delay:320ms">
          {facts.map((f) => <li>{f}</li>)}
        </ul>
      </div>
      <figure class="plate rv" data-rv data-from="right" style="--rv-delay:200ms">
        <canvas data-backdrop="plate" data-seed="7731" data-dpr="1.3" aria-hidden="true"></canvas>
        <span class="plate-word" aria-hidden="true">Simula</span>
      </figure>
    </div>
  </section>

  <!-- ═══ PREMISE ════════════════════════════════════════════════ -->
  <section class="band" id="premise">
    <div class="shell premise">
      <div class="premise-copy">
        <span class="eyebrow rv" data-rv>The premise</span>
        <h2 class="h2 rv" data-rv style="--rv-delay:80ms">Map the space before you sample it.</h2>
        <p class="lede rv" data-rv style="--rv-delay:160ms">
          Prompt a model in a loop and you get whatever region of the space it finds most probable: dense at the
          modes, thin at the edges, and no way to say what you missed. Simula makes the space explicit first. Three
          ideas do the work.
        </p>
        <ol class="ideas">
          {
            ideas.map((it, i) => (
              <li class="rv" data-rv style={`--rv-delay:${200 + i * 80}ms`}>
                <h3>{it.title}</h3>
                <p>{it.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <figure class="premise-art rv" data-rv data-from="right" style="--rv-delay:160ms">
        <canvas data-backdrop="leafgrid" data-seed="1187" data-dpr="1.4" aria-hidden="true"></canvas>
        <figcaption>
          Every leaf of the taxonomy is a cell, one band per factor. A sampled leaf fills. Coverage is filled cells
          over all cells — a sentence a prompt-in-a-loop pipeline cannot utter, because it has no denominator.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ═══ PIPELINE ═══════════════════════════════════════════════ -->
  <section class="band band-tint" id="pipeline">
    <div class="shell">
      <span class="eyebrow rv" data-rv>The pipeline</span>
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">Five stages. Each one writes a file you can read.</h2>
      <p class="lede rv" data-rv style="--rv-delay:160ms">
        Every stage produces a human-inspectable JSON or JSONL artifact, and an artifact on disk is reused rather than
        rebuilt. Stop after the taxonomy, edit it by hand, rerun: thirty seconds of expert review is worth more than any
        amount of downstream filtering.
      </p>
      <ol class="stages rv" data-rv style="--rv-delay:200ms">
        {
          stages.map((s) => (
            <li class="stage">
              <span class="stage-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              <span class="stage-artifact">{s.artifact}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ═══ ONE DATA POINT ═════════════════════════════════════════ -->
  <section class="band" id="trace">
    <div class="shell">
      <span class="eyebrow rv" data-rv>One data point</span>
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">From sampled mix to accepted row.</h2>
      <p class="lede rv" data-rv style="--rv-delay:160ms">
        No record goes straight from requirements to output. This is a row from the 10K e-commerce run — shopper
        searches paired with atomic, database-queryable extractions — with every step that produced it.
      </p>

      <ol class="trace">
        <li class="trace-step rv" data-rv>
          <span class="trace-n">1</span>
          <div class="trace-body">
            <h3>Sampled mix <span>one node per factor, drawn under a weighted strategy</span></h3>
            <pre class="code"><code set:html={mixCode} /></pre>
          </div>
        </li>
        <li class="trace-step rv" data-rv style="--rv-delay:60ms">
          <span class="trace-n">2</span>
          <div class="trace-body">
            <h3>Meta-prompt <span>three drafted, one picked at random</span></h3>
            <p class="trace-text">
              A runner replacing worn trail shoes before a race weekend: known size, a hard price ceiling, wants
              waterproofing, explicitly rules out neon colourways. Terse, search-bar phrasing.
            </p>
            <p class="trace-note">
              The indirection is what buys local diversity. Hand the requirements straight to the generator and every
              “footwear + known item + negation” row becomes the same query with a brand swapped. This one also drew
              heads at <code>complexity_ratio: 0.3</code> and was rewritten harder.
            </p>
          </div>
        </li>
        <li class="trace-step rv" data-rv style="--rv-delay:120ms">
          <span class="trace-n">3</span>
          <div class="trace-body">
            <h3>Record <span>generated, then validated against the schema before any further call</span></h3>
            <pre class="code"><code set:html={recordCode} /></pre>
          </div>
        </li>
        <li class="trace-step rv" data-rv style="--rv-delay:180ms">
          <span class="trace-n">4</span>
          <div class="trace-body">
            <h3>Critic <span>accept</span></h3>
            <p class="trace-note">
              A separate call, at low temperature, against a seven-point rejection checklist from the prompt module:
              compound values, wrong types, deep nesting, hallucinated constraints, omitted constraints, unnatural
              queries, and the specific trap of inventing a price when the shopper only said “cheap”. Rejections
              feed a refinement call; a refinement that breaks the schema rejects the row outright.
            </p>
          </div>
        </li>
        <li class="trace-step rv" data-rv style="--rv-delay:240ms">
          <span class="trace-n">5</span>
          <div class="trace-body">
            <h3>Lineage <span>travels with the row, and everything downstream reads from it</span></h3>
            <pre class="code"><code set:html={lineageCode} /></pre>
            <p class="trace-note">
              Coverage math, the coverage-aware trimmer and per-row debugging all read this one field. Every row can
              answer where it came from and who approved it.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ═══ ROLES ══════════════════════════════════════════════════ -->
  <section class="band band-tint" id="roles">
    <div class="shell">
      <span class="eyebrow rv" data-rv>Model roles</span>
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">Three roles, one budget.</h2>
      <p class="lede rv" data-rv style="--rv-delay:160ms">
        Expensive intelligence goes where its decisions amortize across the whole dataset; cheap throughput goes where
        volume lives. Each role picks its own model and decoding, and any of the thirteen task types can override
        them.
      </p>
      <div class="roles">
        {
          roles.map((r, i) => (
            <article class="role rv" data-rv style={`--rv-delay:${120 + i * 80}ms`}>
              <span class="role-name">{r.name}</span>
              <span class="role-figure">{r.figure}</span>
              <span class="role-unit">{r.unit}</span>
              <h3>{r.label}</h3>
              <p>{r.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ RUN ════════════════════════════════════════════════════ -->
  <section class="band" id="run">
    <div class="shell run">
      <div class="run-copy">
        <span class="eyebrow rv" data-rv>Running it</span>
        <h2 class="h2 rv" data-rv style="--rv-delay:80ms">One YAML per run. Five commands.</h2>
        <p class="lede rv" data-rv style="--rv-delay:160ms">
          Only two things are required: a description and a model per role. Everything else has a default and fails
          loudly at load time, not as a silent zero-row run. Smoke-test at twenty rows first; resume reuses everything.
        </p>
        <pre class="code rv" data-rv style="--rv-delay:220ms"><code set:html={installCode} /></pre>
        <ol class="cli rv" data-rv style="--rv-delay:280ms">
          {
            cli.map((c) => (
              <li>
                <code>simula {c.cmd}</code>
                <span>{c.body}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="run-side">
        <figure class="term rv" data-rv data-from="right" style="--rv-delay:160ms">
          <video
            data-demo
            src={DEMO_URL}
            poster="/simula-demo-poster.jpg"
            muted
            loop
            playsinline
            preload="none"
            width="1010"
            height="830"
          ></video>
          <figcaption>
            <code>simula run</code> on the 10K e-commerce config, building the taxonomy. 53 seconds, muted.
          </figcaption>
        </figure>
        <pre class="code rv" data-rv data-from="right" style="--rv-delay:240ms"><code set:html={yamlCode} /></pre>
      </div>
    </div>
  </section>

  <!-- ═══ EVALUATION ═════════════════════════════════════════════ -->
  <section class="band band-tint" id="evaluation">
    <div class="shell">
      <span class="eyebrow rv" data-rv>Evaluation</span>
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">Evaluation reads the dataset. It never writes to it.</h2>
      <p class="lede rv" data-rv style="--rv-delay:160ms">
        <code>evaluate</code> reads <code>dataset.final.jsonl</code> and writes <code>dataset.evaluated.jsonl</code>
        and <code>eval_report.json</code>. The boundary exists because an evaluation bug that rewrites a shipped
        dataset is the failure you discover three weeks later.
      </p>
      <div class="suite">
        {
          evalSuite.map((e, i) => (
            <div class="suite-item rv" data-rv style={`--rv-delay:${120 + i * 70}ms`}>
              <h3>{e.title}</h3>
              <p>{e.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ NUMBERS ════════════════════════════════════════════════ -->
  <section class="band" id="numbers">
    <div class="shell">
      <span class="eyebrow rv" data-rv>From a real run</span>
      <h2 class="h2 rv" data-rv style="--rv-delay:80ms">A thousand rows, logged in full.</h2>
      <p class="lede rv" data-rv style="--rv-delay:160ms">
        The library’s first production test: job-posting extraction with a varying-key schema and atomic fields.
        The tail was killed during a rate-limit storm and the trimmer finished the job — overgeneration is the shock
        absorber for everything.
      </p>
      <dl class="stats rv" data-rv style="--rv-delay:200ms">
        {
          stats.map((s) => (
            <div class="stat">
              <dt>{s.label}</dt>
              <dd>
                <span class="stat-figure">{s.figure}</span>
                <span class="stat-note">{s.note}</span>
              </dd>
            </div>
          ))
        }
      </dl>
      <div class="limits rv" data-rv style="--rv-delay:260ms">
        <h3>Pilot-scale, on purpose.</h3>
        <ul>
          {limits.map((l) => <li>{l}</li>)}
        </ul>
        <p>
          The roadmap follows friction from real runs; batched, multi-turn generation is next. The full log — every
          stage, what worked and what did not — is in <a href={LOG_URL}>the research post</a>, and the paper that
          scales the same ideas past 100M tokens is <a href={PAPER_URL} target="_blank" rel="noopener noreferrer">arXiv:2603.29791</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ CLOSER ═════════════════════════════════════════════════ -->
  <section class="band band-tint closer">
    <div class="shell closer-in">
      <div>
        <h2 class="rv" data-rv>Run it on your problem.</h2>
        <p class="rv" data-rv style="--rv-delay:100ms">
          MIT-licensed, with runnable offline examples and the real configs from the runs described here. If you want
          this pipeline applied to your domain, that is exactly the work we do.
        </p>
      </div>
      <div class="closer-actions rv" data-rv style="--rv-delay:200ms">
        <a class="wipe" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
          <span class="wipe-fill"></span>
          <span class="wipe-label">View on GitHub</span>
          <span class="wipe-label" aria-hidden="true">↗</span>
        </a>
        <a class="quiet" href="/contact">Talk to us<span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</V2Layout>

<script is:inline>
  /* The demo plays only while it is on screen. */
  (() => {
    const v = document.querySelector('[data-demo]');
    if (!v || !('IntersectionObserver' in window)) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        });
      },
      { threshold: 0.35 }
    );
    io.observe(v);
  })();
</script>

<style>
  /* ── Shared bits ───────────────────────────────────────────── */
  .eyebrow i {
    margin-inline: 5.4px;
    font-style: normal;
    color: var(--n-300);
  }
  .quiet {
    display: inline-flex;
    align-items: center;
    gap: 7.2px;
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
    transition: color 300ms var(--ease);
