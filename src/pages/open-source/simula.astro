<script>
  function initSimulaDemos() {
    const card = document.querySelector<HTMLElement>('[data-demo-card]');
    if (card && !card.dataset.bound) {
      card.dataset.bound = 'true';
      const body = card.querySelector<HTMLElement>('[data-demo-body]')!;
      const pre = card.querySelector<HTMLElement>('[data-demo-config]')!;
      const video = card.querySelector<HTMLVideoElement>('[data-demo-video]')!;
      const toggle = card.querySelector<HTMLButtonElement>('[data-demo-toggle]')!;
      const glyph = card.querySelector<HTMLElement>('[data-demo-glyph]')!;
      const label = card.querySelector<HTMLElement>('[data-demo-label]');
      let open = false;
      let settle: ReturnType<typeof setTimeout>;

      toggle.addEventListener('click', () => {
        open = !open;
        clearTimeout(settle);
        body.style.height = `${body.offsetHeight}px`;
        requestAnimationFrame(() => {
          if (open) {
            body.style.height = `${Math.round((body.clientWidth * 830) / 1010)}px`;
            pre.classList.add('opacity-0');
            video.classList.remove('hidden');
            video.muted = true;
            video.currentTime = 0;
            video.play().catch(() => {});
          } else {
            body.style.height = `${pre.offsetHeight}px`;
            pre.classList.remove('opacity-0');
            video.pause();
            settle = setTimeout(() => {
              video.classList.add('hidden');
              body.style.height = '';
            }, 320);
          }
        });
        glyph.textContent = open ? '✕ close' : '⏎ run';
        if (label) label.textContent = open ? 'recorded demo' : 'the whole interface';
        toggle.setAttribute('aria-pressed', String(open));
      });
    }

    const strip = document.querySelector<HTMLVideoElement>('[data-demo-strip]');
    if (strip && !strip.dataset.bound) {
      strip.dataset.bound = 'true';
      strip.muted = true;
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              strip.play().catch(() => {});
            } else {
              strip.pause();
            }
          });
        },
        { threshold: 0.35 }
      );
      io.observe(strip);
    }
  }

  document.addEventListener('astro:page-load', initSimulaDemos);
</script>

