---
/* The SAE guardrail log's switch demo: Gemma's answer, labelled by the
   detector as it is written, against GPT's tagged reference answer.
   layout "a": the two answers side by side, horizontal bars.
   layout "b": one row per answer, text left and vertical bars right. */
interface Props { src: string; layout?: 'a' | 'b' }
const { src, layout = 'b' } = Astro.props;
const id = `decode-${crypto.randomUUID()}`;
---

<decode-demo id={id} class:list={['decode-demo', `layout-${layout}`]} data-src={src} data-layout={layout} aria-label="Topic switches in Gemma's and GPT's answers">
  <div class="frame">
    <div class="picker" data-viewer="picker" role="group" aria-label="Examples">
      <span class="eyebrow">Examples</span>
      <button type="button" class="nav" data-viewer="prev" aria-label="Previous example"><svg viewBox="0 0 10 10" aria-hidden="true"><path d="M6.5 1.5 3 5l3.5 3.5"/></svg></button>
      <div class="list" data-viewer="list"></div>
      <button type="button" class="nav" data-viewer="next" aria-label="Next example"><svg viewBox="0 0 10 10" aria-hidden="true"><path d="M3.5 1.5 7 5 3.5 8.5"/></svg></button>
    </div>
    <div class="main">
      <section class="prompt-card" aria-label="Prompt">
        <span class="eyebrow">Prompt</span>
        <div class="prompt" data-viewer="prompt"></div>
        <div class="asks" data-viewer="asks"></div>
      </section>
      <div class="figs">
        <section class="fig" data-viewer="fig-gemma"></section>
        <section class="fig" data-viewer="fig-gpt"></section>
      </div>
      <div class="key" data-viewer="key"></div>
    </div>
  </div>
  <p class="viewer-status" role="status">Loading examples…</p>
  <noscript>Enable JavaScript to play the examples.</noscript>
</decode-demo>

<script>
  class DecodeDemo extends HTMLElement {
    private observer?: IntersectionObserver;
    private controller?: AbortController;

    connectedCallback() {
      this.observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          this.observer?.disconnect();
          void this.load();
        }
      }, { rootMargin: '400px' });
      this.observer.observe(this);
    }

    private async load() {
      this.controller?.abort();
      this.controller = new AbortController();
      const signal = this.controller.signal;
      const status = this.querySelector<HTMLElement>('.viewer-status')!;
      status.hidden = false;
      status.textContent = 'Loading examples…';
      try {
        const { init_decode_demo } = await import('@/scripts/decode-demo.js');
        await init_decode_demo(this, this.dataset.src!, this.dataset.layout!, signal);
        status.hidden = true;
      } catch {
        if (signal.aborted) return;
        status.textContent = 'The examples could not be loaded. ';
        const retry = document.createElement('button');
        retry.type = 'button';
        retry.textContent = 'Retry';
        retry.addEventListener('click', () => void this.load(), { once: true });
        status.append(retry);
      }
    }

    disconnectedCallback() {
      this.observer?.disconnect();
      this.controller?.abort();
    }
  }
  if (!customElements.get('decode-demo')) customElements.define('decode-demo', DecodeDemo);
</script>

<style is:global>
  /* Frame, palette and type follow the runs viewers. Sized by its own
     width (container queries), since it breaks out of the prose column. */
  .v2-prose .decode-demo {
    color-scheme: light;
    --panel: #fcfcfd;
    --side: #f6f7f9;
    --ink: #0f1217;
    --ink-2: #4a515c;
    --ink-3: #868c96;
    --rule: #e2e5e9;
    --chip: #e9ecef;
    --track: #e6e8ec;
    --on: #171719;
    --on-ink: #fcfcfd;
    --call: #e0a030;
    --t0: #0072B2; --t1: #E69F00; --t2: #009E73; --t3: #CC79A7; --t4: #D55E00; --t5: #56B4E9; --t6: #E2C400;
    --hl: 24%;
    display: block;
    position: relative;
    container-type: inline-size;
    margin-bottom: 24px;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  .v2-prose .decode-demo * { box-sizing: border-box; }
  .v2-prose .decode-demo [hidden] { display: none !important; }
  .v2-prose .decode-demo button { font: inherit; color: inherit; }
  .v2-prose .decode-demo button:focus-visible,
  .v2-prose .decode-demo [tabindex]:focus-visible { outline: 2px solid var(--t0); outline-offset: 2px; }
  .v2-prose .decode-demo .t0 { --c: var(--t0); } .v2-prose .decode-demo .t1 { --c: var(--t1); }
  .v2-prose .decode-demo .t2 { --c: var(--t2); } .v2-prose .decode-demo .t3 { --c: var(--t3); }
  .v2-prose .decode-demo .t4 { --c: var(--t4); } .v2-prose .decode-demo .t5 { --c: var(--t5); }
  .v2-prose .decode-demo .t6 { --c: var(--t6); }
  .v2-prose .decode-demo .dot { display: inline-block; width: 10px; height: 10px; border-radius: 3px; background: var(--c); flex: none; }
  .v2-prose .decode-demo .hl { background: color-mix(in srgb, var(--c) var(--hl), #ffffff); box-decoration-break: clone; -webkit-box-decoration-break: clone; padding-block: 2px; }
  .v2-prose .decode-demo .eyebrow { font-family: var(--mono); font-size: 10.5px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }

  .v2-prose .decode-demo .frame { background: var(--panel); border: 1px solid var(--rule); border-radius: 12px; overflow: hidden; box-shadow: 0 1px 0 rgb(15 18 23 / .03); }

  /* examples: along the top, like the viewers' metric tabs */
  .v2-prose .decode-demo .picker { display: flex; align-items: center; gap: 8px; min-width: 0; padding: 10px 16px; border-bottom: 1px solid var(--rule); background: var(--side); }
  .v2-prose .decode-demo .picker .eyebrow { flex: none; margin-right: 4px; }
  .v2-prose .decode-demo .list { flex: 1 1 auto; min-width: 0; display: flex; gap: 4px; overflow-x: auto; scrollbar-width: none; padding: 2px; scroll-behavior: smooth; }
  .v2-prose .decode-demo .list::-webkit-scrollbar { display: none; }
  .v2-prose .decode-demo .item { flex: none; border: 0; background: transparent; color: var(--ink-2); padding: 6px 12px; border-radius: 999px; font-size: 13px; cursor: pointer; white-space: nowrap; }
  .v2-prose .decode-demo .item:hover { background: var(--chip); color: var(--ink); }
  .v2-prose .decode-demo .item[aria-pressed="true"] { background: var(--on); color: var(--on-ink); }
  .v2-prose .decode-demo .nav { flex: none; width: 28px; height: 28px; padding: 0; display: grid; place-items: center; border: 1px solid var(--rule); background: var(--panel); border-radius: 50%; cursor: pointer; color: var(--ink-2); }
  .v2-prose .decode-demo .nav:hover { border-color: var(--ink-3); color: var(--ink); }
  .v2-prose .decode-demo .nav svg { width: 10px; height: 10px; fill: none; stroke: currentColor; stroke-width: 1.8; }

  .v2-prose .decode-demo .main { min-width: 0; display: grid; gap: 16px; padding: 18px 20px 16px; }

  /* prompt: a pull-quote */
  .v2-prose .decode-demo .prompt-card { border-left: 3px solid var(--ink); padding: 2px 0 2px 16px; display: grid; gap: 8px; }
  .v2-prose .decode-demo .prompt { margin: 0; font-size: 14.5px; line-height: 1.9; }
  .v2-prose .decode-demo .asks { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; font-size: 12.5px; color: var(--ink-2); }
  .v2-prose .decode-demo .asks span { display: inline-flex; align-items: center; gap: 6px; }

  /* answer panels */
  .v2-prose .decode-demo .figs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .v2-prose .decode-demo.layout-b .figs { grid-template-columns: minmax(0, 1fr); }
  .v2-prose .decode-demo .fig { min-width: 0; background: var(--side); border: 1px solid var(--rule); border-radius: 10px; padding: 14px 16px 16px; display: grid; gap: 12px; align-content: start; }
  .v2-prose .decode-demo .fig-hd { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .v2-prose .decode-demo .fig-hd h3 { margin: 0 12px 0 0; font-family: var(--hero-serif); font-weight: 400; font-size: 22px; line-height: 1; letter-spacing: 0; }
  .v2-prose .decode-demo .fig-hd .ctl { display: flex; gap: 6px; }
  .v2-prose .decode-demo .btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; border: 0; background: var(--chip); color: var(--ink-2); height: 30px; padding: 0 13px; border-radius: 999px; font-size: 13px; font-weight: 500; cursor: pointer; }
  .v2-prose .decode-demo .btn:hover { color: var(--ink); background: #e1e5e9; }
  .v2-prose .decode-demo .btn.primary { background: var(--on); color: var(--on-ink); min-width: 92px; }
  .v2-prose .decode-demo .btn.primary:hover { background: #262b33; }
  .v2-prose .decode-demo .btn svg { width: 11px; height: 11px; fill: currentColor; }
  .v2-prose .decode-demo .card { height: 240px; overflow-y: auto; background: var(--panel); border: 1px solid var(--rule); border-radius: 8px; padding: 12px 16px; font-size: 13.5px; line-height: 1.85; white-space: pre-wrap; overflow-wrap: anywhere; }
  .v2-prose .decode-demo .k.f,
  .v2-prose .decode-demo .swm.f,
  .v2-prose .decode-demo .gap.f { visibility: hidden; }
  .v2-prose .decode-demo .gap { display: block; text-align: center; color: var(--ink-3); letter-spacing: .3em; margin: 4px 0; }
  .v2-prose .decode-demo .more { color: var(--ink-3); }
  .v2-prose .decode-demo .swm { display: inline-flex; align-items: center; gap: 5px; margin: 0 4px; padding: 0 8px 0 6px; border: 1.5px solid var(--call); border-radius: 999px; background: var(--panel); font-size: 11.5px; font-weight: 600; line-height: 19px; white-space: nowrap; vertical-align: 1px; }
  .v2-prose .decode-demo .swm .dot { width: 8px; height: 8px; }
  .v2-prose .decode-demo .swm.hot,
  .v2-prose .decode-demo .callout.hot { animation: decode-pulse 1.4s ease-out; }
  @keyframes decode-pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, #e0a030 70%, transparent); } 100% { box-shadow: 0 0 0 10px transparent; } }
  .v2-prose .decode-demo .none { margin: 0; align-self: center; text-align: center; color: var(--ink-2); padding: 30px 0; }

  /* horizontal bars (a) */
  .v2-prose .decode-demo .rows { display: grid; gap: 5px; }
  .v2-prose .decode-demo .row { display: grid; grid-template-columns: 120px minmax(0, 1fr) 40px; align-items: center; gap: 10px; font-size: 12.5px; }
  .v2-prose .decode-demo .row .name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .v2-prose .decode-demo .row.off .name { color: var(--ink-3); }
  .v2-prose .decode-demo .slot { grid-column: 2 / -1; }
  .v2-prose .decode-demo .slot:empty { display: none; }
  .v2-prose .decode-demo .track { position: relative; height: 15px; background: var(--track); border-radius: 3px; }
  .v2-prose .decode-demo .fill,
  .v2-prose .decode-demo .ghost { position: absolute; inset: 0 auto 0 0; width: 0; border-radius: 3px; }
  .v2-prose .decode-demo .fill { background: var(--c); transition: width .25s linear; }
  .v2-prose .decode-demo .ghost { background: color-mix(in srgb, var(--c) 28%, var(--track)); }
  .v2-prose .decode-demo .val { font-family: var(--mono); font-size: 11.5px; text-align: right; font-variant-numeric: tabular-nums; color: var(--ink-2); }
  .v2-prose .decode-demo .callout { position: relative; display: block; border: 1.5px solid var(--call); background: var(--panel); border-radius: 6px; padding: 4px 8px; font-size: 11.5px; line-height: 1.35; }

  /* vertical bars (b): a compact chart beside the text */
  .v2-prose .decode-demo .fig-body { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 20px; align-items: stretch; }
  .v2-prose .decode-demo .textcol { display: grid; gap: 8px; min-width: 0; }
  .v2-prose .decode-demo .vchart { position: relative; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 3px; align-items: stretch; padding-top: 48px; }
  .v2-prose .decode-demo .vcol { display: flex; flex-direction: column; align-items: center; gap: 4px; min-height: 0; }
  .v2-prose .decode-demo .vcol .val { text-align: center; font-size: 11px; }
  .v2-prose .decode-demo .vbar { position: relative; flex: 1 1 auto; width: 78%; min-height: 120px; border-bottom: 1px solid var(--ink-2); }
  .v2-prose .decode-demo .vbar .fill,
  .v2-prose .decode-demo .vbar .ghost { inset: auto 0 0 0; width: auto; height: 0; border-radius: 3px 3px 0 0; }
  .v2-prose .decode-demo .vbar .fill { transition: height .25s linear; }
  .v2-prose .decode-demo .vcol .name { font-size: 10px; line-height: 1.25; text-align: center; color: var(--ink); min-height: 2.5em; }
  .v2-prose .decode-demo .vcol.off .name { color: var(--ink-3); }
  .v2-prose .decode-demo .vchart .callout { position: absolute; top: 0; transform: translateX(-50%); width: max-content; max-width: 200px; text-align: center; }
  .v2-prose .decode-demo .vchart .callout::after { content: ""; position: absolute; left: 50%; top: 100%; height: var(--lead, 20px); border-left: 1.5px solid var(--call); }
  .v2-prose .decode-demo .status { text-align: left; font-weight: 600; font-size: 13.5px; color: #b57a12; min-height: 21px; }

  /* colour key */
  .v2-prose .decode-demo .key { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 16px; font-size: 12px; color: var(--ink-2); padding-top: 12px; border-top: 1px solid var(--rule); }
  .v2-prose .decode-demo .key span { display: inline-flex; align-items: center; gap: 6px; }
  .v2-prose .decode-demo .key .sw-now,
  .v2-prose .decode-demo .key .sw-before { display: inline-block; width: 22px; height: 10px; border-radius: 3px; }
  .v2-prose .decode-demo .key .sw-now { background: var(--ink-2); }
  .v2-prose .decode-demo .key .sw-before { background: color-mix(in srgb, var(--ink-3) 30%, var(--track)); }
  .v2-prose .decode-demo .key .bar-sep { width: 1px; height: 14px; background: var(--rule); }
  .v2-prose .decode-demo .viewer-status { position: absolute; inset: 50% 0 auto; margin: 0; text-align: center; padding: 12px; background: var(--panel); }

  @container (max-width: 860px) {
    .v2-prose .decode-demo.layout-a .figs { grid-template-columns: minmax(0, 1fr); }
  }
  @container (max-width: 720px) {
    .v2-prose .decode-demo .fig-body { grid-template-columns: minmax(0, 1fr); }
    .v2-prose .decode-demo .vchart { max-width: 420px; height: 280px; }
    .v2-prose .decode-demo .main { padding: 14px 12px; }
    .v2-prose .decode-demo .picker > .eyebrow { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .v2-prose .decode-demo .swm.hot,
    .v2-prose .decode-demo .callout.hot { animation: none; }
    .v2-prose .decode-demo .fill { transition: none; }
  }
</style>
