---
/**
 * One entry in a listing: meta column, title and summary, thumbnail.
 * Shared by /research, /blog and the "more" strip under each post.
 * Rows draw their own top rule; the last one closes with a bottom rule.
 */
import { formatShortDate } from '@/utils/blog';
import type { EntryRowData } from '@/utils/blog';

interface Props extends EntryRowData {
  delay?: number;
}

const { href, title, summary, category, date, author, readTime, image, delay = 0 }: Props = Astro.props;
---

<a class="row rv" data-rv style={`--rv-delay:${delay}ms`} href={href}>
  <div class="row-meta">
    <span class="row-cat">{category}</span>
    <time datetime={date.toISOString()}>{formatShortDate(date)}</time>
  </div>
  <div class="row-body">
    <h3>{title}</h3>
    <p>{summary}</p>
    <div class="row-foot">
      {author && <span>{author}</span>}
      {author && <span aria-hidden="true">·</span>}
      <span>{readTime}</span>
      <span class="row-go">Read<span aria-hidden="true">→</span></span>
    </div>
  </div>
  {
    image && (
      <figure class="row-thumb">
        <img src={image} alt="" loading="lazy" decoding="async" />
      </figure>
    )
  }
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 138px minmax(0, 1fr) 176px;
    gap: 28.8px;
    padding-block: 28.8px;
    border-top: 1px solid var(--line);
  }
  .row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .row-meta {
    display: flex;
    flex-direction: column;
    gap: 6.3px;
    padding-top: 5.4px;
    font-family: var(--mono);
    font-size: 9.9px;
    line-height: 1.5;
  }
  .row-cat {
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .row-meta time {
    color: var(--n-400);
  }

  .row-body {
    min-width: 0;
  }
  .row h3 {
    max-width: 30ch;
    font-family: var(--hero-serif);
    font-size: 22.5px;
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: -0.016em;
    text-wrap: pretty;
    /* The underline is the hover state: the same 1px rule the nav uses,
       drawn as decoration so it follows a wrapped title. */
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    text-decoration-color: transparent;
    transition: text-decoration-color 300ms var(--ease);
  }
  .row:hover h3 {
    text-decoration-color: currentColor;
  }
  .row p {
    margin-top: 10.8px;
    max-width: 66ch;
    font-size: 13.05px;
    line-height: 1.74;
    color: var(--ink-3);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .row-foot {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 16.2px;
    font-family: var(--mono);
    font-size: 9.9px;
    color: var(--n-400);
  }
  .row-go {
    display: inline-flex;
    align-items: center;
    gap: 5.4px;
    margin-left: auto;
    color: var(--ink);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 400ms var(--ease),
      transform 400ms var(--ease);
  }
  .row:hover .row-go {
    opacity: 1;
    transform: none;
  }

  .row-thumb {
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--n-100);
    border: 1px solid var(--line);
  }
  .row-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }
  .row:hover .row-thumb img {
    transform: scale(1.03);
  }

  @media (max-width: 900px) {
    .row {
      grid-template-columns: minmax(0, 1fr) 150px;
      gap: 12.6px 21.6px;
    }
    .row-meta {
      grid-column: 1 / -1;
      flex-direction: row;
      gap: 14.4px;
      padding-top: 0;
    }
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 23.4px;
    }
    .row-thumb {
      display: none;
    }
    .row h3 {
      font-size: 19.8px;
    }
    .row-go {
      opacity: 1;
      transform: none;
    }
  }
</style>
