---
/**
 * Header for a listing page. Quiet on purpose: the home hero spends the
 * site's boldness, so the inner pages open on type alone.
 */
interface Props {
  /** Optional: newer pages (Contact) open on the heading alone. */
  eyebrow?: string;
  title: string;
  /** An array puts each sentence on its own line, as on the home page. */
  lede: string | string[];
  count?: string;
}

const { eyebrow, title, lede, count }: Props = Astro.props;
---

<section class="list-head">
  <div class="shell">
    {eyebrow && <span class="eyebrow rv" data-rv>{eyebrow}</span>}
    <h1 class="rv" data-rv style="--rv-delay:80ms">{title}</h1>
    {
      Array.isArray(lede) ? (
        <p class="lede lede-lines rv" data-rv style="--rv-delay:160ms">
          {lede.map((line) => <span>{line}</span>)}
        </p>
      ) : (
        <p class="lede rv" data-rv style="--rv-delay:160ms">{lede}</p>
      )
    }
    {
      count && (
        <span class="list-count rv" data-rv style="--rv-delay:240ms">
          {count}
        </span>
      )
    }
  </div>
</section>

<style>
  .list-head {
    padding-block: clamp(50.4px, 6.3vw, 86.4px) clamp(43.2px, 5.4vw, 68.4px);
  }
  .list-head h1 {
    margin-top: 14.4px;
    max-width: 22ch;
    font-family: var(--hero-serif);
    font-size: clamp(33px, 4.4vw, 52.8px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.024em;
    text-wrap: balance;
  }
  /* Room for a longer sentence on one line; narrower screens wrap each
     sentence evenly instead of stranding a word. */
  .lede.lede-lines {
    max-width: 760px;
  }
  .lede-lines span {
    display: block;
    text-wrap: balance;
  }
  .list-count {
    display: block;
    margin-top: 25.2px;
    font-family: var(--mono);
    font-size: 9.9px;
    letter-spacing: 0.04em;
    color: var(--n-400);
  }
</style>
