---
/**
 * One paper on /research: serif title, summary, authors and links
 * (arXiv, GitHub, research log). No eyebrow over the title (Pranav,
 * 2026-11-12). `wide` spans the grid and puts
 * the paper's graphic beside the copy.
 *
 * The copy column sits on `facetsAmber` from public/v2-backdrops.js, pale
 * cream facets light enough for ink. The graphic column carries its own
 * ground (ChatMonitor draws a grid that turns amber on drift).
 */
import type { Paper } from '@/data/papers';
import ChatMonitor from '@/components/v2/ChatMonitor.astro';

interface Props {
  paper: Paper;
  wide?: boolean;
  delay?: number;
  seed?: number;
}

const { paper, wide = false, delay = 0, seed = 1 }: Props = Astro.props;

// A title with a colon breaks after it: the claim on the first line, the
// method from the second (Pranav, 2026-11-12).
const colon = paper.title.indexOf(': ');
const titleLead = colon > 0 ? paper.title.slice(0, colon + 1) : '';
const titleRest = colon > 0 ? paper.title.slice(colon + 2) : paper.title;
---

<article
  class:list={['paper rv', { 'paper-wide': wide }]}
  data-rv
  style={`--rv-delay:${delay}ms`}
>
  <div class="paper-body">
  <canvas class="paper-bg" data-backdrop="facetsAmber" data-seed={seed} data-dpr="1" aria-hidden="true"></canvas>
  <div class="paper-copy">
  <h3>
    <a href={paper.href} target="_blank" rel="noopener noreferrer">
      {titleLead && <span class="t-lead">{titleLead} </span>}
      <span class="t-rest">{titleRest}</span>
    </a>
  </h3>
  <p>{paper.summary}</p>
  <span class="paper-authors">{paper.authors}</span>
  <span class="paper-links">
    <a href={paper.href} target="_blank" rel="noopener noreferrer">
      <svg class="lk-icon" viewBox="0 0 16 16" fill="none" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path stroke="#7c7469" d="M12.6 2.6 7.2 8.4l5.4 5.6" />
        <path stroke="#b31b1b" d="M3.6 1.8l6.9 6.6-6.3 6" />
      </svg>
      arXiv<span aria-hidden="true">↗</span>
    </a>
    {paper.code && (
      <a href={paper.code} target="_blank" rel="noopener noreferrer">
        <svg class="lk-icon" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" /></svg>
        GitHub<span aria-hidden="true">↗</span>
      </a>
    )}
    {paper.log && (
      <a href={paper.log}>
        Research log<span aria-hidden="true">→</span>
      </a>
    )}
  </span>
  </div>
  </div>
  {wide && (
    <figure class="paper-art">
      {paper.graphic === 'chat-monitor' ? (
        <ChatMonitor />
      ) : (
        paper.image && <img src={paper.image} alt={paper.imageAlt ?? ''} loading="lazy" decoding="async" />
      )}
    </figure>
  )}
</article>

<style>
  .paper {
    position: relative;
    display: flex;
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    /* Keeps the site's reveal (opacity and the 24px rise, 600ms, staggered
       by --rv-delay): a scoped `transition` here would otherwise replace
       the layout's .rv one and the card would snap in. */
    transition:
      opacity 600ms var(--ease) var(--rv-delay, 0ms),
      transform 600ms var(--ease) var(--rv-delay, 0ms),
      border-color 500ms var(--ease),
      box-shadow 500ms var(--ease);
  }
  .paper-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* The ground lives in the copy column only. */
  .paper-body {
    position: relative;
    flex: 1;
    display: flex;
    overflow: hidden;
  }
  .paper-copy {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 32.4px 36px 30.6px;
  }
  .paper:hover {
    border-color: var(--ink-3);
    box-shadow: 0 4px 9px -7px hsl(240 14% 10% / 0.07);
  }
  .paper h3 {
    font-family: var(--hero-serif);
    font-size: clamp(21.6px, 2.16vw, 26.1px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.015em;
    /* Balance, not pretty: pretty still left "monitoring" alone. */
    text-wrap: balance;
  }
  .paper h3 a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    text-decoration-color: transparent;
    transition: text-decoration-color 300ms var(--ease);
  }
  .paper h3 a:hover {
    text-decoration-color: currentColor;
  }
  /* The part up to the colon holds one line wherever the column has room
     for it; narrower, the title just balances. */
  @media (min-width: 1000px) {
    .t-lead {
      display: block;
      white-space: nowrap;
    }
    /* Its own block, or balance does not reach it and a word is left alone. */
    .t-rest {
      display: block;
      text-wrap: balance;
    }
  }
  .paper p {
    margin-top: 12.6px;
    font-size: 13.95px;
    line-height: 1.7;
    color: var(--ink-3);
  }
  .paper-authors {
    display: block;
    margin-top: auto;
    padding-top: 23.4px;
    font-family: var(--mono);
    font-size: 9.9px;
    color: var(--ink-3);
  }
  .paper-links {
    display: flex;
    flex-wrap: wrap;
    gap: 9px 23.4px;
    margin-top: 14.4px;
    padding-top: 14.4px;
    border-top: 1px solid var(--line);
  }
  .paper-links a {
    display: inline-flex;
    align-items: center;
    gap: 6.3px;
    font-family: var(--mono);
    font-size: 9.9px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .lk-icon {
    width: 14px;
    height: 14px;
    flex: none;
    margin-right: 1.8px;
  }
  .paper-links a span {
    color: var(--indigo-600);
    transition: transform 400ms var(--ease);
  }
  .paper-links a:hover span {
    transform: translate(2px, -2px);
  }
  .paper-links a:hover:not([target]) span {
    transform: translateX(4px);
  }
  /* Alone on its row: copy left, the paper's figure right. */
  .paper-wide {
    grid-column: 1 / -1;
    display: grid;
    /* 5.5 : 6.5, not 5 : 7, so "…monitor at decode:" fits one line. */
    grid-template-columns: minmax(0, 5.5fr) minmax(0, 6.5fr);
  }
  /* The graphic's column: white under the graphic's own ground, a rule
     between it and the copy. */
  .paper-art {
    position: relative;
    margin: 0;
    display: flex;
    align-items: center;
    padding: 32.4px 36px;
    border-left: 1px solid var(--line);
    background: var(--surface);
  }
  .paper-art img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 820px) {
    .paper-wide {
      grid-template-columns: 1fr;
    }
    .paper-art {
      order: -1;
      padding: 25.2px;
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }
    .paper-copy {
      padding: 27px 25.2px 25.2px;
    }
  }
</style>
