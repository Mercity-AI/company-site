---
/* A browsable sample of a topic-tagged dataset: records on the left,
   the conversation (or how it was generated) on the right. Used by the
   SAE guardrail log; data comes from export_site_data.py. */
interface Props { src: string }
const { src } = Astro.props;
const id = `dsv-${crypto.randomUUID()}`;
---

<dataset-viewer id={id} class="dataset-viewer" data-src={src} aria-label="Dataset sample">
  <div class="viz">
    <aside class="side" aria-label="Records">
      <div class="side-hd"><h2>Dataset</h2></div>
      <div class="filters">
        <div class="ctl"><span class="ctl-lbl">Topics in the record</span><div class="seg" data-viewer="count">
          <button type="button" data-v="all">All</button><button type="button" data-v="1">1</button><button type="button" data-v="2">2</button><button type="button" data-v="3">3</button><button type="button" data-v="4">4</button>
        </div></div>
      </div>
      <div class="list" data-viewer="list" role="group" aria-label="Pick a record"></div>
    </aside>

    <div class="main">
      <div class="bar">
        <div class="tabs" data-viewer="tabs" role="tablist" aria-label="View">
          <button type="button" class="tab" role="tab" data-v="conv">Conversation</button>
          <button type="button" class="tab" role="tab" data-v="gen">How it was generated</button>
        </div>
        <div class="nav">
          <button type="button" data-viewer="prev" aria-label="Previous record"><svg viewBox="0 0 10 10" aria-hidden="true"><path d="M6.5 1.5 3 5l3.5 3.5"/></svg></button>
          <button type="button" data-viewer="next" aria-label="Next record"><svg viewBox="0 0 10 10" aria-hidden="true"><path d="M3.5 1.5 7 5 3.5 8.5"/></svg></button>
        </div>
      </div>
      <div class="pane"><div class="read" data-viewer="read"></div></div>
    </div>
  </div>
  <p class="viewer-status" role="status">Loading records…</p>
  <noscript>Enable JavaScript to browse the dataset.</noscript>
</dataset-viewer>

<script>
  class DatasetViewer extends HTMLElement {
    private observer?: IntersectionObserver;
    private controller?: AbortController;

    connectedCallback() {
      this.observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          this.observer?.disconnect();
          void this.load();
        }
      }, { rootMargin: '400px' });
      this.observer.observe(this);
    }

    private async load() {
      this.controller?.abort();
      this.controller = new AbortController();
      const signal = this.controller.signal;
      const status = this.querySelector<HTMLElement>('.viewer-status')!;
      status.hidden = false;
      status.textContent = 'Loading records…';
      try {
        const { init_dataset_viewer } = await import('@/scripts/dataset-viewer.js');
        await init_dataset_viewer(this, this.dataset.src!, signal);
        status.hidden = true;
      } catch {
        if (signal.aborted) return;
        status.textContent = 'The records could not be loaded. ';
        const retry = document.createElement('button');
        retry.type = 'button';
        retry.textContent = 'Retry';
        retry.addEventListener('click', () => void this.load(), { once: true });
        status.append(retry);
      }
    }

    disconnectedCallback() {
      this.observer?.disconnect();
      this.controller?.abort();
    }
  }
  if (!customElements.get('dataset-viewer')) customElements.define('dataset-viewer', DatasetViewer);
</script>

<style is:global>
  /* Frame, palette and type follow the runs viewers; topic colours match the decode demo. */
  .v2-prose .dataset-viewer {
    color-scheme: light;
    --panel: #fcfcfd;
    --side: #f6f7f9;
    --ink: #0f1217;
    --ink-2: #4a515c;
    --ink-3: #868c96;
    --rule: #e2e5e9;
    --chip: #e9ecef;
    --on: #171719;
    --on-ink: #fcfcfd;
    --t0: #0072B2; --t1: #E69F00; --t2: #009E73; --t3: #CC79A7; --t4: #D55E00; --t5: #56B4E9; --t6: #E2C400;
    --hl: 24%;
    display: block;
    position: relative;
    height: clamp(560px, 82vh, 700px);
    margin-bottom: 24px;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
  }
  .v2-prose .dataset-viewer * { box-sizing: border-box; }
  .v2-prose .dataset-viewer [hidden] { display: none !important; }
  .v2-prose .dataset-viewer button { font: inherit; color: inherit; }
  .v2-prose .dataset-viewer button:focus-visible,
  .v2-prose .dataset-viewer [tabindex]:focus-visible { outline: 2px solid var(--t0); outline-offset: 2px; }
  .v2-prose .dataset-viewer .t0 { --c: var(--t0); } .v2-prose .dataset-viewer .t1 { --c: var(--t1); }
  .v2-prose .dataset-viewer .t2 { --c: var(--t2); } .v2-prose .dataset-viewer .t3 { --c: var(--t3); }
  .v2-prose .dataset-viewer .t4 { --c: var(--t4); } .v2-prose .dataset-viewer .t5 { --c: var(--t5); }
  .v2-prose .dataset-viewer .t6 { --c: var(--t6); }
  .v2-prose .dataset-viewer .dot { display: inline-block; width: 9px; height: 9px; border-radius: 3px; background: var(--c); flex: none; }
  .v2-prose .dataset-viewer .hl { background: color-mix(in srgb, var(--c) var(--hl), #ffffff); box-decoration-break: clone; -webkit-box-decoration-break: clone; padding-block: 2px; }
  .v2-prose .dataset-viewer .eyebrow { font-family: var(--mono); font-size: 10.5px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); }

  /* the frame: sidebar | main, only the reading pane scrolls */
  .v2-prose .dataset-viewer .viz { height: 100%; display: grid; grid-template-columns: 260px minmax(0, 1fr); background: var(--panel); border: 1px solid var(--rule); border-radius: 12px; overflow: hidden; box-shadow: 0 1px 0 rgb(15 18 23 / .03); }
  .v2-prose .dataset-viewer .side { background: var(--side); border-right: 1px solid var(--rule); display: flex; flex-direction: column; min-height: 0; }
  .v2-prose .dataset-viewer .side-hd { padding: 18px 16px 4px; }
  .v2-prose .dataset-viewer .side-hd h2 { font-family: var(--hero-serif); font-weight: 400; font-size: 22px; line-height: 1; margin: 0; letter-spacing: 0; }
  .v2-prose .dataset-viewer .filters { display: grid; gap: 10px; padding: 12px 16px 14px; border-bottom: 1px solid var(--rule); }
  .v2-prose .dataset-viewer .ctl { display: grid; gap: 5px; min-width: 0; }
  .v2-prose .dataset-viewer .ctl-lbl { font-family: var(--mono); font-size: 10.5px; color: var(--ink-3); text-transform: uppercase; letter-spacing: .08em; }
  .v2-prose .dataset-viewer .seg { display: inline-flex; width: fit-content; max-width: 100%; background: var(--chip); border-radius: 6px; padding: 2px; }
  .v2-prose .dataset-viewer .seg button { border: 0; background: transparent; color: var(--ink-2); font-size: 12px; padding: 5px 10px; border-radius: 4px; cursor: pointer; white-space: nowrap; }
  .v2-prose .dataset-viewer .seg button[aria-pressed="true"] { background: var(--panel); color: var(--ink); box-shadow: 0 1px 2px rgb(15 18 23 / .12); }
  .v2-prose .dataset-viewer .list { flex: 1 1 auto; min-height: 0; overflow-y: auto; display: grid; align-content: start; gap: 2px; padding: 8px 8px 12px; }
  .v2-prose .dataset-viewer .rec { display: grid; gap: 3px; text-align: left; border: 0; background: transparent; padding: 8px 10px; border-radius: 6px; cursor: pointer; }
  .v2-prose .dataset-viewer .rec:hover { background: rgb(15 18 23 / .045); }
  .v2-prose .dataset-viewer .rec[aria-pressed="true"] { background: var(--panel); box-shadow: inset 0 0 0 1px var(--rule), 0 1px 2px rgb(15 18 23 / .06); }
  .v2-prose .dataset-viewer .rec .name { font-size: 12.5px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .v2-prose .dataset-viewer .rec .seq { font-family: var(--mono); font-size: 10.5px; color: var(--ink-3); }
  .v2-prose .dataset-viewer .empty { margin: 0; padding: 14px 10px; color: var(--ink-3); font-size: 12.5px; }

  .v2-prose .dataset-viewer .main { display: grid; grid-template-rows: auto minmax(0, 1fr); min-width: 0; min-height: 0; }
  .v2-prose .dataset-viewer .bar { display: flex; align-items: center; gap: 10px; padding: 12px 16px 12px 20px; border-bottom: 1px solid var(--rule); }
  .v2-prose .dataset-viewer .tabs { display: flex; gap: 4px; flex: 1 1 auto; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  .v2-prose .dataset-viewer .tab { flex: none; border: 0; background: transparent; padding: 6px 12px; border-radius: 999px; font-size: 13.5px; color: var(--ink-2); cursor: pointer; white-space: nowrap; }
  .v2-prose .dataset-viewer .tab:hover { background: var(--chip); }
  .v2-prose .dataset-viewer .tab[aria-selected="true"] { background: var(--on); color: var(--on-ink); }
  .v2-prose .dataset-viewer .nav { flex: none; display: flex; gap: 6px; }
  .v2-prose .dataset-viewer .nav button { width: 28px; height: 28px; padding: 0; display: grid; place-items: center; border: 1px solid var(--rule); background: var(--panel); border-radius: 50%; cursor: pointer; color: var(--ink-2); }
  .v2-prose .dataset-viewer .nav button:hover { border-color: var(--ink-3); color: var(--ink); }
  .v2-prose .dataset-viewer .nav svg { width: 10px; height: 10px; fill: none; stroke: currentColor; stroke-width: 1.8; }
  .v2-prose .dataset-viewer .pane { min-height: 0; overflow: hidden; display: flex; padding: 18px 24px; }
  .v2-prose .dataset-viewer .read { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; gap: 16px; }
  .v2-prose .dataset-viewer .read > * { flex: none; }
  .v2-prose .dataset-viewer .read > .grow { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
  .v2-prose .dataset-viewer .grow > .response,
  .v2-prose .dataset-viewer .grow > .scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; }
  .v2-prose .dataset-viewer .rec-hd { display: grid; gap: 14px; }
  .v2-prose .dataset-viewer .rec-hd h3 { font-family: var(--hero-serif); font-weight: 400; font-size: 26px; line-height: 1; margin: 0; letter-spacing: 0; }

  /* how the response divides between topics */
  .v2-prose .dataset-viewer .strip { display: flex; height: 10px; border-radius: 999px; overflow: hidden; gap: 2px; }
  .v2-prose .dataset-viewer .strip i { display: block; background: var(--c); min-width: 3px; }
  .v2-prose .dataset-viewer .strip-lbl { display: flex; gap: 2px; margin-top: 7px; color: var(--ink-3); }
  .v2-prose .dataset-viewer .strip-lbl span { min-width: 0; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-family: var(--mono); font-size: 11px; }
  .v2-prose .dataset-viewer .strip-lbl b { font-family: var(--sans); font-weight: 500; font-size: 12px; color: var(--ink-2); margin-right: 3px; }

  .v2-prose .dataset-viewer .block { display: grid; gap: 8px; }
  .v2-prose .dataset-viewer .prompt { margin: 0; border-left: 3px solid var(--ink); padding: 2px 0 2px 14px; font-size: 14.5px; line-height: 1.9; }
  .v2-prose .dataset-viewer .response { margin: 0; background: var(--panel); border: 1px solid var(--rule); border-radius: 8px; padding: 12px 16px; font-size: 13.5px; line-height: 1.85; white-space: pre-wrap; overflow-wrap: anywhere; }
  .v2-prose .dataset-viewer .tagmark { display: inline-flex; align-items: center; gap: 5px; margin-right: 4px; padding: 0 8px 0 6px; border: 1px solid var(--c); border-radius: 999px; background: var(--panel); font-size: 11px; font-weight: 600; line-height: 18px; white-space: nowrap; vertical-align: 1px; color: var(--ink); }
  .v2-prose .dataset-viewer .tagmark .dot { width: 7px; height: 7px; }

  /* how it was generated */
  .v2-prose .dataset-viewer .facts { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 14px 20px; margin: 0; }
  .v2-prose .dataset-viewer .facts dt { font-family: var(--mono); font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); padding-top: 3px; }
  .v2-prose .dataset-viewer .facts dd { margin: 0; font-size: 13.5px; line-height: 1.7; color: var(--ink); }
  .v2-prose .dataset-viewer .tax { display: grid; gap: 4px; }
  .v2-prose .dataset-viewer .tax div { display: flex; gap: 8px; }
  .v2-prose .dataset-viewer .tax .f { color: var(--ink-3); min-width: 9.5em; }
  .v2-prose .dataset-viewer .tax .none { color: var(--ink-3); }
  .v2-prose .dataset-viewer .verdict { display: inline-flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .06em; padding: 2px 8px; border-radius: 999px; background: #e3f1e7; color: #1d7a3e; margin-right: 8px; }
  .v2-prose .dataset-viewer .note { margin-top: 6px; font-size: 12.5px; color: var(--ink-3); }

  .v2-prose .dataset-viewer .key { display: flex; flex-wrap: wrap; gap: 6px 14px; padding-top: 12px; border-top: 1px solid var(--rule); font-size: 12px; color: var(--ink-2); }
  .v2-prose .dataset-viewer .key span { display: inline-flex; align-items: center; gap: 6px; }
  .v2-prose .dataset-viewer .viewer-status { position: absolute; inset: 50% 0 auto; margin: 0; text-align: center; padding: 12px; background: var(--panel); }

  @media (max-width: 760px) {
    .v2-prose .dataset-viewer { height: auto; }
    .v2-prose .dataset-viewer .viz { height: auto; grid-template-columns: minmax(0, 1fr); }
    .v2-prose .dataset-viewer .side { border-right: 0; border-bottom: 1px solid var(--rule); }
    .v2-prose .dataset-viewer .list { display: flex; overflow-x: auto; overflow-y: hidden; padding: 8px; }
    .v2-prose .dataset-viewer .rec { flex: none; width: 200px; background: var(--panel); border: 1px solid var(--rule); }
    .v2-prose .dataset-viewer .pane { display: block; padding: 16px 14px; }
    .v2-prose .dataset-viewer .read > .grow { display: block; }
    .v2-prose .dataset-viewer .grow > .response,
    .v2-prose .dataset-viewer .grow > .scroll { max-height: 60vh; }
    .v2-prose .dataset-viewer .facts { grid-template-columns: minmax(0, 1fr); gap: 4px 0; }
    .v2-prose .dataset-viewer .facts dd { margin-bottom: 10px; }
  }
</style>
